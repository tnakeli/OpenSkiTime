<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OpenSkiTime.Desktop" x:Class="OpenSkiTime.Desktop.AuditTrailView" x:CompileBindings="False">
 <Grid RowDefinitions="Auto,Auto,*,Auto,*,Auto" RowSpacing="{DynamicResource FormGap}">
  <TabControl Name="AuditTrailTabs" Classes="pageTabs" SelectedIndex="{Binding SelectedAuditTab}">
   <TabItem Header="Events"/><TabItem Header="Raw timing"/><TabItem Header="Diagnostics"/><TabItem Header="Series &amp; environment"/>
  </TabControl>
  <Border Grid.Row="1" Classes="card">
   <StackPanel Spacing="{DynamicResource FormGap}">
    <local:FormRow>
     <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Classes="field"><TextBlock Text="SOURCE" Classes="fieldLabel"/><ComboBox Name="AuditSourceBox" ItemsSource="{Binding AuditSources}" SelectedItem="{Binding AuditSource}"/></StackPanel>
     <StackPanel Grid.Column="3" Grid.ColumnSpan="3" Classes="field"><TextBlock Text="COMPETITION" Classes="fieldLabel"/><ComboBox Name="AuditCompetitionBox" ItemsSource="{Binding AuditCompetitions}" SelectedItem="{Binding AuditCompetition}"/></StackPanel>
     <StackPanel Grid.Column="6" Grid.ColumnSpan="1" Classes="field"><TextBlock Text="RUN" Classes="fieldLabel"/><TextBox Text="{Binding AuditRun}"/></StackPanel>
     <StackPanel Grid.Column="7" Grid.ColumnSpan="1" Classes="field"><TextBlock Text="BIB" Classes="fieldLabel"/><TextBox Text="{Binding AuditBib}"/></StackPanel>
     <StackPanel Grid.Column="8" Grid.ColumnSpan="2" Classes="field"><TextBlock Text="OPERATOR" Classes="fieldLabel"/><TextBox Text="{Binding AuditOperator}"/></StackPanel>
     <StackPanel Grid.Column="10" Grid.ColumnSpan="2" Classes="field"><TextBlock Text="SEARCH" Classes="fieldLabel"/><TextBox Name="AuditSearchBox" Text="{Binding AuditSearch}" KeyDown="Search_KeyDown"/></StackPanel>
    </local:FormRow>
    <local:FormRow>
     <StackPanel Grid.Column="0" Grid.ColumnSpan="4" Classes="field"><TextBlock Text="FROM" Classes="fieldLabel"/><TextBox Text="{Binding AuditFrom}" PlaceholderText="Timestamp with UTC offset"/></StackPanel>
     <StackPanel Grid.Column="4" Grid.ColumnSpan="4" Classes="field"><TextBlock Text="UNTIL" Classes="fieldLabel"/><TextBox Text="{Binding AuditUntil}" PlaceholderText="Timestamp with UTC offset"/></StackPanel>
     <Button Grid.Column="8" Grid.ColumnSpan="2" Name="AuditRefreshButton" Content="Refresh" Command="{Binding RefreshAuditCommand}" IsEnabled="{Binding !IsAuditBusy}" Classes="secondaryAction" VerticalAlignment="Bottom"/>
     <Button Grid.Column="10" Grid.ColumnSpan="2" Content="Clear filters" Command="{Binding ClearAuditFiltersCommand}" Classes="secondaryAction" VerticalAlignment="Bottom"/>
    </local:FormRow>
   </StackPanel>
  </Border>
  <DataGrid Grid.Row="2" Name="AuditRecordsGrid" ItemsSource="{Binding AuditRecords}" SelectedItem="{Binding SelectedAuditRecord}"
            Classes="raceGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" IsVisible="{Binding IsAuditRecords}">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Recorded at" Binding="{Binding At}" Width="Auto"/>
    <local:ChipTextColumn Header="Source" Binding="{Binding Reference.Source}" Width="Auto"/>
    <DataGridTextColumn Header="Competition" Binding="{Binding Competition}" Width="Auto"/>
    <DataGridTextColumn Header="Run" Binding="{Binding Run}" Width="Auto"/>
    <DataGridTextColumn Header="Bib" Binding="{Binding Bib}" Width="Auto"/>
    <local:CompetitorNameColumn Header="Name" Binding="{Binding Name}" Width="Auto"/>
    <DataGridTextColumn Header="Operator" Binding="{Binding Operator}" Width="Auto"/>
    <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="Auto"/>
    <local:ChipTextColumn Header="Provenance" Binding="{Binding Provenance}" Width="Auto"/>
   </DataGrid.Columns>
  </DataGrid>
  <DataGrid Grid.Row="2" Name="AuditLogGrid" ItemsSource="{Binding AuditLogEvents}" Classes="raceGrid" AutoGenerateColumns="False" IsReadOnly="True" IsVisible="{Binding IsAuditDiagnostics}">
   <DataGrid.Columns>
    <DataGridTextColumn Header="Recorded at" Binding="{Binding At}" Width="Auto"/>
    <local:ChipTextColumn Header="Component" Binding="{Binding Component}" Width="Auto"/>
    <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="Auto"/>
   </DataGrid.Columns>
  </DataGrid>
  <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="{DynamicResource FormGap}">
   <TextBlock Text="{Binding AuditStatus}" TextWrapping="Wrap" Classes="supportingText"/>
   <Button Grid.Column="1" Content="Previous" Command="{Binding PreviousAuditPageCommand}" IsEnabled="{Binding CanAuditPrevious}" Classes="secondaryAction"/>
   <Button Grid.Column="2" Content="Next" Command="{Binding NextAuditPageCommand}" IsEnabled="{Binding CanAuditNext}" Classes="secondaryAction"/>
  </Grid>
  <Border Grid.Row="4" Classes="card">
   <Grid RowDefinitions="Auto,*" RowSpacing="{DynamicResource FormGap}">
    <Grid Classes="cardHeader" ColumnDefinitions="*,Auto">
     <TextBlock Text="Record details" Classes="cardTitle"/>
     <Button Grid.Column="1" Content="Copy details" Click="CopyDetails_Click" Classes="secondaryAction"/>
    </Grid>
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto,*" RowSpacing="{DynamicResource FormGap}">
     <Grid Grid.Row="0" IsVisible="{Binding IsAuditDiagnostics}" ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource FormGap}">
      <ComboBox ItemsSource="{Binding LocalAuditLogs}" SelectedItem="{Binding SelectedLocalAuditLog}"/>
      <Button Grid.Column="1" Content="View original local log" Command="{Binding ShowLocalAuditLogCommand}" Classes="secondaryAction"/>
     </Grid>
     <ItemsControl Grid.Row="1" ItemsSource="{Binding AuditLinks}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate><DataTemplate><Button Content="{Binding Label}" Tag="{Binding Reference}" Click="SourceLink_Click" Classes="secondaryAction"/></DataTemplate></ItemsControl.ItemTemplate>
     </ItemsControl>
     <TextBox Grid.Row="2" Name="AuditDetailsText" Text="{Binding AuditDetails, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsAuditRecords}"/>
     <TextBox Grid.Row="2" Text="{Binding AuditEnvironment, Mode=OneWay}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap"
              ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsAuditDiagnostics}"/>
    </Grid>
   </Grid>
  </Border>
  <Grid Grid.Row="5" ColumnDefinitions="*,Auto">
   <Button Grid.Column="1" Name="CreateDebugBundleButton" Content="Create debug bundle…" Command="{Binding ReviewDebugBundleCommand}" Classes="primaryAction"/>
  </Grid>
 </Grid>
</UserControl>
