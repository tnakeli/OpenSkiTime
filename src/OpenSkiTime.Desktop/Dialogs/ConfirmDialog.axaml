<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenSkiTime.Desktop.Dialogs.ConfirmDialog"
        Width="480" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Title="Confirm">

  <Grid RowDefinitions="*,Auto" Margin="24">
    <StackPanel Grid.Row="0" Spacing="12">
      <TextBlock x:Name="TitleBlock" FontSize="18" FontWeight="SemiBold" />
      <TextBlock x:Name="MessageBlock" TextWrapping="Wrap" />
    </StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal"
                HorizontalAlignment="Right" Spacing="8" Margin="0,16,0,0">
      <Button x:Name="CancelButton" Content="Cancel" MinWidth="96" />
      <Button x:Name="ConfirmButton" Content="Confirm" MinWidth="96"
              Classes="accent" />
    </StackPanel>
  </Grid>

</Window>
