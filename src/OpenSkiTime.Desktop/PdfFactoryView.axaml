<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OpenSkiTime.Desktop" x:Class="OpenSkiTime.Desktop.PdfFactoryView" x:CompileBindings="False">
  <!-- A view led by its list: full width. The state card with Generate All stays on top, the folded PDF settings sit
       under it and the report list fills the rest. -->
  <DockPanel>
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,0,0,8">
      <Grid ColumnDefinitions="*,16,Auto,12,Auto">
        <StackPanel Spacing="4" VerticalAlignment="Center">
          <TextBlock Text="PDF Factory" Classes="cardTitle" />
          <TextBlock Name="PdfSummaryText" Text="{Binding PdfSummary}" Classes="supportingText" TextWrapping="Wrap"
                     IsVisible="{Binding PdfSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <TextBlock Grid.Column="2" Text="Generating PDFs…" Classes="supportingText attention" IsVisible="{Binding IsPdfBusy}" VerticalAlignment="Center" />
        <Button Grid.Column="4" Content="Generate All" Command="{Binding GenerateAllPdfsCommand}" IsEnabled="{Binding !IsPdfBusy}" Classes="primaryAction" VerticalAlignment="Center" />
      </Grid>
    </Border>

    <Expander DockPanel.Dock="Top" Header="PDF settings" Margin="0,0,0,8" HorizontalAlignment="Stretch">
      <StackPanel Spacing="{DynamicResource FormGap}" IsEnabled="{Binding !IsPdfBusy}">
        <local:FormRow>
          <StackPanel Grid.Column="0" Grid.ColumnSpan="6" Classes="field">
            <TextBlock Text="BACKGROUND" Classes="fieldLabel" />
            <TextBox Text="{Binding PdfTemplateLabel, Mode=OneWay}" IsReadOnly="True" />
          </StackPanel>
          <Button Grid.Column="6" Grid.ColumnSpan="3" Content="Choose PDF background" Click="ChooseBackground_Click" Classes="secondaryAction"
                  VerticalAlignment="Bottom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Grid.Column="9" Grid.ColumnSpan="3" Content="Remove background" Command="{Binding RemovePdfTemplateCommand}" Classes="secondaryAction"
                  VerticalAlignment="Bottom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </local:FormRow>
        <!-- A4 content margins; the unit sits inside each field. -->
        <local:FormRow>
          <Border Grid.Column="0" Grid.ColumnSpan="2" Classes="statField"><StackPanel>
            <TextBlock Text="TOP MARGIN" Classes="fieldLabel" />
            <Grid ColumnDefinitions="*,Auto"><NumericUpDown Name="PdfTopMarginInput" Value="{Binding PdfTopMargin}" Minimum="5" Maximum="80" FormatString="0.##" />
              <TextBlock Grid.Column="1" Text="mm" Classes="unit" Margin="4,0,0,0" /></Grid></StackPanel></Border>
          <Border Grid.Column="2" Grid.ColumnSpan="2" Classes="statField"><StackPanel>
            <TextBlock Text="BOTTOM MARGIN" Classes="fieldLabel" />
            <Grid ColumnDefinitions="*,Auto"><NumericUpDown Value="{Binding PdfBottomMargin}" Minimum="5" Maximum="80" FormatString="0.##" />
              <TextBlock Grid.Column="1" Text="mm" Classes="unit" Margin="4,0,0,0" /></Grid></StackPanel></Border>
          <Border Grid.Column="4" Grid.ColumnSpan="2" Classes="statField"><StackPanel>
            <TextBlock Text="LEFT MARGIN" Classes="fieldLabel" />
            <Grid ColumnDefinitions="*,Auto"><NumericUpDown Value="{Binding PdfLeftMargin}" Minimum="5" Maximum="80" FormatString="0.##" />
              <TextBlock Grid.Column="1" Text="mm" Classes="unit" Margin="4,0,0,0" /></Grid></StackPanel></Border>
          <Border Grid.Column="6" Grid.ColumnSpan="2" Classes="statField"><StackPanel>
            <TextBlock Text="RIGHT MARGIN" Classes="fieldLabel" />
            <Grid ColumnDefinitions="*,Auto"><NumericUpDown Value="{Binding PdfRightMargin}" Minimum="5" Maximum="80" FormatString="0.##" />
              <TextBlock Grid.Column="1" Text="mm" Classes="unit" Margin="4,0,0,0" /></Grid></StackPanel></Border>
          <Button Grid.Column="8" Grid.ColumnSpan="2" Content="Preview" Command="{Binding PreviewPdfProfileCommand}" Classes="secondaryAction"
                  ToolTip.Tip="Preview the current margins and background in your PDF reader without saving."
                  VerticalAlignment="Bottom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
          <Button Grid.Column="10" Grid.ColumnSpan="2" Content="Save profile" Command="{Binding SavePdfProfileCommand}" Classes="secondaryAction"
                  VerticalAlignment="Bottom" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" />
        </local:FormRow>
        <TextBlock Text="Use a one-page A4 PDF and leave space for race data. The background is embedded in the .ost file. Referee Report uses its own fixed margins and FIS form layout."
                   Classes="supportingText" TextWrapping="Wrap" />
      </StackPanel>
    </Expander>

    <!-- Columns size to their content so no value is cut; a narrow window scrolls the grid instead. -->
    <DataGrid Name="PdfReportGrid" Classes="raceGrid" ItemsSource="{Binding PdfReports}" AutoGenerateColumns="False" IsReadOnly="True"
              RowHeight="36" ColumnHeaderHeight="32" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
              HorizontalGridLinesBrush="{DynamicResource LineBrush}" IsEnabled="{Binding !IsPdfBusy}">
      <DataGrid.Columns>
        <DataGridTextColumn Header="REPORT" Binding="{Binding Name}" Width="Auto" FontWeight="SemiBold" />
        <DataGridTemplateColumn Header="OUTPUT FILE" Width="*" MinWidth="260">
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
            <TextBlock Text="{Binding FileName}" ToolTip.Tip="{Binding OutputPath}" VerticalAlignment="Center" Margin="12,0" TextTrimming="CharacterEllipsis" />
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="STATUS" Width="Auto">
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
            <Panel Margin="12,0" VerticalAlignment="Center" ToolTip.Tip="{Binding Reason}">
              <Border Classes="chip green" IsVisible="{Binding IsGenerated}"><TextBlock Text="{Binding Status}" /></Border>
              <Border Classes="chip warning" IsVisible="{Binding IsOutdated}"><TextBlock Text="{Binding Status}" /></Border>
              <TextBlock Text="{Binding Status}" Classes="supportingText" IsVisible="{Binding IsNotGenerated}" />
            </Panel>
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="ACTIONS" Width="Auto">
          <DataGridTemplateColumn.CellTemplate><DataTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6" Margin="12,0" VerticalAlignment="Center">
              <Button Content="{Binding GenerateLabel}" Command="{Binding GenerateCommand}" IsEnabled="{Binding CanGenerate}" ToolTip.Tip="{Binding Reason}" Classes="secondaryAction" />
              <Button Content="{Binding OpenLabel}" Command="{Binding OpenCommand}" IsVisible="{Binding CanOpen}" ToolTip.Tip="{Binding OutputPath}" Classes="secondaryAction" />
            </StackPanel>
          </DataTemplate></DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>
  </DockPanel>
</UserControl>
