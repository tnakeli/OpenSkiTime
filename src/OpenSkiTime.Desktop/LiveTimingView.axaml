<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:OpenSkiTime.Desktop" x:Class="OpenSkiTime.Desktop.LiveTimingView" x:CompileBindings="False">
 <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
  <ItemsControl ItemsSource="{Binding LiveChannels}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border ToolTip.Tip="{Binding StatusToolTip}" Background="Transparent" Padding="2,3" AutomationProperties.Name="{Binding Summary}">
     <StackPanel Orientation="Horizontal" Spacing="5">
      <Border Name="LiveChannelDot" Width="10" Height="10" CornerRadius="5" Background="{Binding IndicatorColor}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Label}" Foreground="{DynamicResource TextBrush}" FontSize="13" VerticalAlignment="Center" />
     </StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Button Name="LiveTimingButton" Classes="secondaryAction" Content="Live timing…" Command="{Binding OpenLiveTimingCommand}" Padding="8,1" MinHeight="24" FontSize="12" ToolTip.Tip="Open the Live timing control panel" />
 </StackPanel>
</UserControl>
