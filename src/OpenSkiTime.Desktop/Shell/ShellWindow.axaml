<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:OpenSkiTime.Desktop.ViewModels"
        x:Class="OpenSkiTime.Desktop.Shell.ShellWindow"
        x:DataType="vm:ShellViewModel"
        Title="Open Ski Time"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600">

  <Grid ColumnDefinitions="240,*">

    <!-- Left navigation -->
    <Border Grid.Column="0" Background="#1f2937" Padding="16">
      <StackPanel Spacing="12">
        <TextBlock Text="Open Ski Time"
                   Foreground="White"
                   FontSize="20" FontWeight="SemiBold" />
        <TextBlock Text="Race office"
                   Foreground="#9ca3af"
                   FontSize="12" />

        <Separator Margin="0,8,0,8" Background="#374151" />

        <TextBlock Text="EVENT SERIES"
                   Foreground="#9ca3af"
                   FontSize="11" FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <TextBlock Text="Manage race weekends, competitions and competitors."
                   Foreground="#d1d5db"
                   FontSize="12"
                   TextWrapping="Wrap" />

        <Separator Margin="0,16,0,8" Background="#374151" />

        <TextBlock Text="IMPORT"
                   Foreground="#9ca3af"
                   FontSize="11" FontWeight="SemiBold"
                   Margin="0,0,0,4" />
        <Button Content="Import competitors…"
                Command="{Binding NavigateToImportCommand}"
                HorizontalAlignment="Stretch"
                Background="#374151" Foreground="White"
                Padding="10,6" />
      </StackPanel>
    </Border>

    <!-- Main content -->
    <ContentControl Grid.Column="1" Content="{Binding CurrentContent}" />

  </Grid>
</Window>
