<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OpenSkiTime.Desktop.TimingReceiptDialog" x:CompileBindings="False" Title="Read timing observations" Width="1100" Height="720" MinWidth="800" MinHeight="500" CanResize="True" WindowStartupLocation="CenterOwner">
 <Window.Resources>
  <x:Double x:Key="DataGridSortIconMinWidth">10</x:Double>
 </Window.Resources>
 <Window.Styles>
  <Style Selector="DataGridColumnHeader"><Setter Property="Padding" Value="5,0"/></Style>
 </Window.Styles>
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">
     <WrapPanel IsEnabled="{Binding !IsReportBusy}">
      <StackPanel IsEnabled="False" Width="90" Margin="0,0,8,4"><TextBlock Text="RUN" Classes="eyebrow"/><ComboBox Name="ReportImportRunPicker" ItemsSource="{Binding ReportImportRuns}" SelectedItem="{Binding ReportImportRun}"/></StackPanel>
      <StackPanel IsEnabled="False" Width="135" Margin="0,0,8,4"><TextBlock Text="SOURCE" Classes="eyebrow"/><ComboBox ItemsSource="{Binding ReportImageRoles}" SelectedItem="{Binding ReportImageRole}"/></StackPanel>
      <StackPanel IsEnabled="False" Width="100" Margin="0,0,8,4"><TextBlock Text="MATCH ± SECONDS" Classes="eyebrow"/><TextBox Text="{Binding ReportMatchTolerance}"/></StackPanel>
      <StackPanel Width="140" Margin="0,0,8,4" IsEnabled="{Binding CanEditReportDevice}"><TextBlock Text="INPUT" Classes="eyebrow"/><ComboBox Name="ReportInputModePicker" ItemsSource="{Binding ReportInputModes}" SelectedItem="{Binding ReportInputMode}" HorizontalAlignment="Stretch"/></StackPanel>
      <Button Name="OpenReceiptImagesButton" Content="Open images…" Click="OpenImages_Click" VerticalAlignment="Bottom" Margin="0,0,8,4" IsVisible="{Binding IsReportImageInput}"/><Button Content="Paste image" Click="PasteImage_Click" VerticalAlignment="Bottom" Margin="0,0,8,4" IsVisible="{Binding IsReportImageInput}"/>
     </WrapPanel>
     <StackPanel Grid.Row="1" Margin="0,4,0,8" Spacing="2">
      <TextBlock Text="{Binding ReportImportStatus}" TextWrapping="Wrap" Classes="supportingText"/>
      <TextBlock Name="ReportImportWarningText" Text="{Binding ReportImportWarnings}" TextWrapping="Wrap" Foreground="{DynamicResource ErrorBrush}" IsVisible="{Binding ReportImportWarnings, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
     </StackPanel>
     <Grid Name="ReceiptPanels" Grid.Row="2" DragDrop.AllowDrop="True">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="1.8*" MinWidth="480"/>
       <ColumnDefinition Width="8"/>
       <ColumnDefinition Width="*" MinWidth="240"/>
      </Grid.ColumnDefinitions>
      <DataGrid Name="ReportImportGrid" MinWidth="480" ItemsSource="{Binding ReportImportPreview}" SelectedItem="{Binding SelectedReportImportRow}" AutoGenerateColumns="False" CanUserResizeColumns="True" CanUserSortColumns="False" HorizontalScrollBarVisibility="Auto" Classes="raceGrid">
       <DataGrid.Columns><DataGridCheckBoxColumn Header="USE" Binding="{Binding Accept}" Width="60" MinWidth="60"/><DataGridTextColumn Header="SAMPLE" Binding="{Binding Sample}" IsReadOnly="True" Width="95" MinWidth="95"/>
        <DataGridTextColumn Header="POSITION" Binding="{Binding Position}" IsReadOnly="True" Width="90" MinWidth="90"/><DataGridTextColumn Header="CURRENT" Binding="{Binding Current}" IsReadOnly="True" Width="150" MinWidth="130"/><DataGridTextColumn Header="PROPOSED" Binding="{Binding Proposed}" IsReadOnly="True" Width="160" MinWidth="130"/>
        <DataGridTextColumn Header="Δ A (s)" Binding="{Binding Difference}" IsReadOnly="True" Width="110" MinWidth="100"/><DataGridTextColumn Header="STATE" Binding="{Binding State}" IsReadOnly="True" Width="200" MinWidth="180"/></DataGrid.Columns>
      </DataGrid>
      <GridSplitter Name="ReceiptPanelSplitter" Grid.Column="1" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" HorizontalAlignment="Stretch" Background="{DynamicResource LineBrush}"/>
      <Grid Name="ReportImagePanel" Grid.Column="2" MinWidth="240" RowDefinitions="Auto,*,Auto,Auto" IsVisible="{Binding IsReportImageInput}">
       <Grid ColumnDefinitions="*,Auto">
        <ComboBox Name="ReportImagePicker" ItemsSource="{Binding ReportImages}" SelectedItem="{Binding SelectedReportImage}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FileName}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
        <ToggleButton Grid.Column="1" Content="Original size" IsChecked="{Binding ReportImageOriginalSize}" Margin="6,0,0,0"/>
       </Grid>
       <ScrollViewer Name="ReportImageScroll" Grid.Row="1" HorizontalScrollBarVisibility="{Binding ReportImageHorizontalScrolling}"><Image Source="{Binding ReportImagePreview}" Width="{Binding ReportImageWidth}" Stretch="Uniform"/></ScrollViewer>
       <TextBlock Grid.Row="2" Text="{Binding SelectedReportImportRow.SourceText}" TextWrapping="Wrap" Classes="supportingText"/>
       <Expander Name="ReportRecognizedTextExpander" Grid.Row="3" Header="Detected timestamps / review flags" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <TextBox Name="ReportRecognizedText" Text="{Binding SelectedReportImage.RecognizedText, Mode=OneWay}" HorizontalAlignment="Stretch" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="180" AcceptsReturn="True"/>
       </Expander>
      </Grid>
      <!-- Timing device input: read in this dialog's memory only. Nothing is saved until OK; settings are not changed. -->
      <Grid Name="ReportDevicePanel" Grid.Column="2" MinWidth="240" RowDefinitions="Auto,Auto,Auto,*,Auto" IsVisible="{Binding IsReportDeviceInput}">
       <ScrollViewer MaxHeight="330" HorizontalScrollBarVisibility="Disabled">
        <WrapPanel IsEnabled="{Binding CanEditReportDevice}">
         <StackPanel Width="200" Margin="0,0,8,4"><TextBlock Text="DEVICE" Classes="eyebrow"/><ComboBox Name="ReportDeviceSourcePicker" ItemsSource="{Binding ReportDeviceSources}" SelectedItem="{Binding ReportDeviceSource}" HorizontalAlignment="Stretch"/></StackPanel>
         <StackPanel Name="ReportDeviceUsbFields" Width="160" Margin="0,0,8,4" IsVisible="{Binding IsReportDeviceUsb}"><TextBlock Text="USB ID" Classes="eyebrow"/><TextBox Text="{Binding ReportDeviceUsbId}" Watermark="Blank = first Timy"/></StackPanel>
         <StackPanel Name="ReportDeviceSerialFields" Width="200" Margin="0,0,8,4" IsVisible="{Binding IsReportDeviceSerial}"><TextBlock Text="COM PORT" Classes="eyebrow"/>
          <Grid ColumnDefinitions="*,Auto"><ComboBox Name="ReportDevicePortPicker" ItemsSource="{Binding ReportDevicePorts}" SelectedItem="{Binding ReportDevicePort}" HorizontalAlignment="Stretch"/><Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshReportDevicePortsCommand}" Margin="4,0,0,0"/></Grid></StackPanel>
         <StackPanel Width="110" Margin="0,0,8,4" IsVisible="{Binding IsReportDeviceSerial}"><TextBlock Text="BAUD" Classes="eyebrow"/><ComboBox ItemsSource="{Binding ReportDeviceBauds}" SelectedItem="{Binding ReportDeviceBaud}" HorizontalAlignment="Stretch"/></StackPanel>
         <StackPanel Width="160" Margin="0,0,8,4" IsVisible="{Binding IsReportDeviceAlge}"><TextBlock Text="USERNAME" Classes="eyebrow"/><TextBox Text="{Binding ReportDeviceAlgeUsername}"/></StackPanel>
         <StackPanel Width="160" Margin="0,0,8,4" IsVisible="{Binding IsReportDeviceAlge}"><TextBlock Text="PASSWORD" Classes="eyebrow"/><TextBox Text="{Binding ReportDeviceAlgePassword}" PasswordChar="•" Watermark="Empty = saved"/></StackPanel>
         <CheckBox Content="Remember password" IsChecked="{Binding ReportDeviceRememberPassword}" IsVisible="{Binding IsReportDeviceAlge}" VerticalAlignment="Bottom" Margin="0,0,8,4"/>
         <Button Content="Fetch devices" Command="{Binding FetchReportDeviceAlgeDevicesCommand}" IsEnabled="{Binding !IsReportDeviceAlgeFetching}" IsVisible="{Binding IsReportDeviceAlge}" VerticalAlignment="Bottom" Margin="0,0,8,4"/>
         <StackPanel Name="ReportDeviceAlgeFields" Width="200" Margin="0,0,8,4" IsVisible="{Binding IsReportDeviceAlge}"><TextBlock Text="DEVICE" Classes="eyebrow"/>
          <TextBox Text="{Binding ReportDeviceAlgeStartDevice}" IsVisible="{Binding !HasReportDeviceAlgeDevices}" Watermark="MT1 device ID"/>
          <ComboBox ItemsSource="{Binding ReportDeviceAlgeDevices}" SelectedItem="{Binding SelectedReportDeviceAlgeStart}" IsVisible="{Binding HasReportDeviceAlgeDevices}" PlaceholderText="Choose MT1 device" HorizontalAlignment="Stretch"/></StackPanel>
         <StackPanel Width="200" Margin="0,0,8,4"><StackPanel.IsVisible><MultiBinding Converter="{x:Static BoolConverters.And}"><Binding Path="IsReportDeviceAlge"/><Binding Path="IsReportDeviceB"/></MultiBinding></StackPanel.IsVisible><TextBlock Text="FINISH DEVICE" Classes="eyebrow"/>
          <TextBox Text="{Binding ReportDeviceAlgeFinishDevice}" IsVisible="{Binding !HasReportDeviceAlgeDevices}" Watermark="Blank = same device"/>
          <ComboBox ItemsSource="{Binding ReportDeviceAlgeDevices}" SelectedItem="{Binding SelectedReportDeviceAlgeFinish}" IsVisible="{Binding HasReportDeviceAlgeDevices}" PlaceholderText="Same device" HorizontalAlignment="Stretch"/></StackPanel>
         <TextBlock Text="{Binding ReportDeviceAlgeStatus}" IsVisible="{Binding IsReportDeviceAlge}" VerticalAlignment="Bottom" Margin="0,0,8,8" Classes="supportingText"/>
         <StackPanel Name="ReportDeviceReplayFields" Width="330" Margin="0,0,8,4" IsVisible="{Binding IsReportDeviceReplay}"><TextBlock Text="RAW ALGE ASCII FILE" Classes="eyebrow"/>
          <Grid ColumnDefinitions="*,Auto"><TextBox Name="ReportDeviceReplayPathBox" Text="{Binding ReportDeviceReplayPath}"/><Button Grid.Column="1" Content="Browse…" Click="BrowseReplay_Click" Margin="4,0,0,0"/></Grid></StackPanel>
         <StackPanel Width="90" Margin="0,0,8,4" IsVisible="{Binding IsReportDeviceB}"><TextBlock Text="START CH" Classes="eyebrow"/><ComboBox Name="ReportDeviceStartChannelPicker" ItemsSource="{Binding ReportDeviceChannels}" SelectedItem="{Binding ReportDeviceStartChannel}" HorizontalAlignment="Stretch"/></StackPanel>
         <StackPanel Width="90" Margin="0,0,8,4" IsVisible="{Binding IsReportDeviceB}"><TextBlock Text="FINISH CH" Classes="eyebrow"/><ComboBox Name="ReportDeviceFinishChannelPicker" ItemsSource="{Binding ReportDeviceChannels}" SelectedItem="{Binding ReportDeviceFinishChannel}" HorizontalAlignment="Stretch"/></StackPanel>
         <StackPanel Width="90" Margin="0,0,8,4" IsVisible="{Binding IsReportDeviceHand}"><TextBlock Text="CHANNEL" Classes="eyebrow"/><ComboBox Name="ReportDeviceHandChannelPicker" ItemsSource="{Binding ReportDeviceChannels}" SelectedItem="{Binding ReportDeviceHandChannel}" HorizontalAlignment="Stretch"/></StackPanel>
         <StackPanel Width="120" Margin="0,0,8,4"><TextBlock Text="DEVICE DATE" Classes="eyebrow"/><TextBox Name="ReportDeviceDateBox" Text="{Binding ReportDeviceDate}" Watermark="YYYY-MM-DD"/></StackPanel>
        </WrapPanel>
       </ScrollViewer>
       <WrapPanel Grid.Row="1" Margin="0,4,0,4">
        <Button Name="ReadReportDeviceButton" Content="Connect / Read" Command="{Binding ReadReportDeviceCommand}" IsEnabled="{Binding CanEditReportDevice}" Margin="0,0,8,0"/>
        <Button Name="StopReportDeviceButton" Content="Stop" Command="{Binding StopReportDeviceCommand}" IsEnabled="{Binding IsReportDeviceReading}"/>
       </WrapPanel>
       <TextBlock Grid.Row="2" Text="{Binding ReportDeviceStatus}" TextWrapping="Wrap" Classes="supportingText" Margin="0,0,0,4"/>
       <DataGrid Name="ReportDeviceGrid" Grid.Row="3" ItemsSource="{Binding ReportDeviceObservations}" AutoGenerateColumns="False" IsReadOnly="True" CanUserResizeColumns="True" CanUserSortColumns="False" HorizontalScrollBarVisibility="Auto" Classes="raceGrid">
        <DataGrid.Columns><DataGridTextColumn Header="TIME" Binding="{Binding Time}" Width="130" MinWidth="110"/><DataGridTextColumn Header="POSITION" Binding="{Binding Position}" Width="90" MinWidth="90"/><DataGridTextColumn Header="KIND" Binding="{Binding Kind}" Width="90" MinWidth="70"/>
         <DataGridTextColumn Header="RAW" Binding="{Binding RawText}" Width="220" MinWidth="120"/><DataGridTextColumn Header="PROVENANCE" Binding="{Binding Provenance}" Width="260" MinWidth="120"/></DataGrid.Columns>
       </DataGrid>
       <TextBlock Grid.Row="4" Text="{Binding SelectedReportImportRow.SourceText}" TextWrapping="Wrap" Classes="supportingText"/>
      </Grid>
     </Grid>
     <StackPanel Grid.Row="3" Spacing="4" Margin="0,8,0,0">

      <WrapPanel><CheckBox Name="SelectAllReceiptMatches" Content="Select all" IsChecked="{Binding AllReportMatchesSelected, Mode=OneWay}" Click="SelectAll_Click" Margin="0,0,14,0"/>
       <Button Name="AcceptReportImagesButton" Content="OK" Click="Accept_Click" IsEnabled="{Binding !IsReportBusy}" Classes="primaryAction"/>
       <Button Content="Cancel" Click="Cancel_Click" Margin="8,0,0,0"/><Button Content="Cancel reading" Command="{Binding CancelReportImagesCommand}" Margin="8,0,0,0" IsVisible="{Binding IsReportBusy}"/>
     </WrapPanel>
     </StackPanel>
    </Grid>
</Window>
