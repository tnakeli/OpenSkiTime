<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OpenSkiTime.Desktop"
        x:Class="OpenSkiTime.Desktop.MainWindow" x:CompileBindings="False"
        Title="{Binding WindowTitle}" Width="1280" Height="820" MinWidth="980" MinHeight="680" WindowState="Maximized"
        Background="{DynamicResource CanvasBrush}"
        RequestedThemeVariant="Dark" ExtendClientAreaToDecorationsHint="True" ExtendClientAreaTitleBarHeightHint="36">
  <Window.Resources>
    <local:HomologationDisplayConverter x:Key="HomologationDisplayConverter" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="WrapPanel.sectionNavigation > Button">
      <Setter Property="Margin" Value="0" />
      <Setter Property="Padding" Value="14,6" />
    </Style>
    <Style Selector="DataGrid.columnControls DataGridColumnHeader">
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- Our header supplies both icons; reclaim the native sort icon column. -->
    <Style Selector="DataGrid.columnControls DataGridColumnHeader /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="Button.calendarHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
  </Window.Styles>
  <!-- The window frame uses the dark variant so Windows draws light caption buttons on the navy title bar;
       everything inside the window stays in the light theme. -->
  <!-- A maximized window with an extended title bar reaches past the screen edges; the off-screen margin keeps the
       title bar and status bar inside the work area. -->
  <ThemeVariantScope RequestedThemeVariant="Light" Margin="{Binding OffScreenMargin, RelativeSource={RelativeSource AncestorType=Window}}">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- Title bar: the window caption is part of the navy bar (Windows keeps its own minimize, maximize and close buttons
         at the right). The empty bar area moves the window; a double-click maximizes or restores it. -->
    <Border Grid.Row="0" Name="TitleBar" Background="{DynamicResource NavyBrush}" Height="36" Padding="12,0,0,0" PointerPressed="TitleBar_PointerPressed">
      <Grid ColumnDefinitions="Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding ProductLabel}">
          <!-- The OpenSkiTime mountain mark (assets/icons/openskitime.svg) without its tile. -->
          <Viewbox Width="27" Height="19" VerticalAlignment="Center">
            <Canvas Width="48" Height="34">
              <Polygon Points="1,32 19,2 28,17 34,7 47,32" Fill="#F4F3EB" />
              <Polygon Points="19,2 26,14 19,11 14,15" Fill="#8BB6AD" />
              <Line StartPoint="31,20" EndPoint="25,32" Stroke="#E86949" StrokeThickness="4" />
            </Canvas>
          </Viewbox>
          <TextBlock Text="OpenSkiTime" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource OnNavyTextBrush}" VerticalAlignment="Center" />
        </StackPanel>
        <Grid Grid.Column="1" ColumnDefinitions="Auto,Auto,Auto,*" Margin="10,0,12,0" VerticalAlignment="Center"
              IsVisible="{Binding ActiveRaceName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="|" Classes="titleSeparator" />
          <TextBlock Grid.Column="1" Name="ActiveRaceTitleText" Text="{Binding ActiveRaceLabel}" Classes="titleText" Margin="10,0" />
          <TextBlock Grid.Column="2" Text="|" Classes="titleSeparator" />
          <TextBlock Grid.Column="3" Name="ActiveRaceNameText" Text="{Binding ActiveRaceName}" ToolTip.Tip="{Binding ActiveRaceName}"
                     Classes="titleText" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Stretch" IsEnabled="{Binding !IsDrawBusy}">
          <Border Classes="titleDivider" />
          <DropDownButton Name="FileMenuButton" Content="File" Classes="titleMenu" ToolTip.Tip="New, open, backup and close the event series file" />
          <Border Classes="titleDivider" />
          <DropDownButton Name="SettingsMenuButton" Content="Settings" Classes="titleMenu" Click="SettingsMenu_Click" />
          <Border Classes="titleDivider" />
          <!-- Room for the Windows caption buttons when the bar extends into the title bar. -->
          <Border Name="CaptionButtonSpace" Width="0" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,0,12,0">
      <WrapPanel Classes="sectionNavigation" Orientation="Horizontal">
        <Button Content="Event series" Command="{Binding ShowSeriesCommand}" Click="Navigation_Click" Classes="sectionNav" Classes.active="{Binding IsSeriesSection}" />
        <Button Content="Competitions" Command="{Binding ShowCompetitionsCommand}" Click="Navigation_Click" IsEnabled="{Binding CanEditCompetitions}" Classes="sectionNav" Classes.active="{Binding IsCompetitionsSection}" />
        <Button Content="Competitors" Command="{Binding ShowCompetitorsCommand}" Click="Navigation_Click" IsEnabled="{Binding CanEditCompetitions}" Classes="sectionNav" Classes.active="{Binding IsCompetitorsSection}" />
        <Button Name="DrawMenuButton" Content="Start lists" Click="DrawMenu_Click" IsEnabled="{Binding CanEditCompetitions}" Classes="sectionNav" Classes.active="{Binding IsDrawSection}" />
        <Button Name="TimingMenuButton" Content="Timing" Click="TimingMenu_Click" IsEnabled="{Binding CanEditCompetitions}" Classes="sectionNav" Classes.active="{Binding IsTimingSection}" />
        <Button Name="ResultsMenuButton" Content="Results" Click="ResultsMenu_Click" IsEnabled="{Binding CanEditCompetitions}" Classes="sectionNav" Classes.active="{Binding IsResultsSection}" />
        <Button Name="TimingReportMenuButton" Content="Timing report" Click="TimingReportMenu_Click" IsEnabled="{Binding CanEditCompetitions}" Classes="sectionNav" Classes.active="{Binding IsTimingReportSection}" />
        <Button Name="PdfFactoryButton" Content="PDF Factory" Click="PdfFactoryMenu_Click" IsEnabled="{Binding CanEditCompetitions}" Classes="sectionNav" Classes.active="{Binding IsPdfFactorySection}" />
      </WrapPanel>
    </Border>
    <ScrollViewer Name="WorkspaceScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsFormSection}">
      <StackPanel Margin="{DynamicResource PageInset}" Spacing="8" HorizontalAlignment="Stretch">
        <!-- One page column: the header, FIS calendar, form and actions share both edges. -->
        <local:PageColumn IsVisible="{Binding IsSeriesSection}">
        <StackPanel Spacing="12">
          <Grid ColumnDefinitions="Auto,*,Auto">
            <Button Name="BrowseSeriesCalendarButton" Content="Browse FIS calendar" Command="{Binding BrowseSeriesCalendarCommand}" Classes="secondaryAction" />
            <Border Grid.Column="2" Classes="subtleSurface" Padding="10,5" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding IsOpen}" />
                <TextBlock Text="EVENT FILE" Classes="eyebrow" VerticalAlignment="Center" />
                <TextBlock Text="{Binding FileLabel}" ToolTip.Tip="{Binding FileLabel}" MaxWidth="560"
                           TextTrimming="CharacterEllipsis" FontSize="{DynamicResource MetaSize}" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
              </StackPanel>
            </Border>
          </Grid>

          <!-- FIS calendar: pick an event to fill the series and its races. -->
          <Border Classes="card" IsVisible="{Binding IsSeriesCalendarOpen}">
            <StackPanel Spacing="{DynamicResource FormGap}">
              <Grid Classes="cardHeader" ColumnDefinitions="Auto,16,Auto,8,Auto,8,Auto,*,Auto" IsEnabled="{Binding !IsSeriesCalendarBusy}">
                <TextBlock Text="FIS calendar" Classes="cardTitle" />
                <TextBlock Grid.Column="2" Text="FIS SEASON" Classes="fieldLabel" VerticalAlignment="Center" />
                <ComboBox Name="SeriesCalendarSeasonInput" Grid.Column="4" Width="110" ItemsSource="{Binding SeriesCalendarSeasonChoices}" SelectedItem="{Binding SeriesCalendarSeason, Mode=TwoWay}" ToolTip.Tip="FIS season by its ending year: 2027 is the 2026/27 season." />
                <Button Grid.Column="6" Content="Load calendar" Classes="secondaryAction" Command="{Binding BrowseSeriesCalendarCommand}" />
                <Button Grid.Column="8" Content="Clear filters" Classes="secondaryAction" Command="{Binding ClearCalendarFiltersCommand}" />
              </Grid>
              <TextBlock Text="{Binding SeriesCalendarStatus}" Classes="supportingText" TextWrapping="Wrap"
                         IsVisible="{Binding SeriesCalendarStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <DataGrid Name="SeriesCalendarEventsGrid" Classes="raceGrid columnControls" ItemsSource="{Binding SeriesCalendarEvents}" SelectedItem="{Binding SelectedSeriesCalendarEvent}"
                        AutoGenerateColumns="False" IsReadOnly="True" Height="240" SelectionMode="Single" CanUserSortColumns="True" CanUserResizeColumns="True">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="START" SortMemberPath="StartDate" Binding="{Binding StartDate, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}" Width="Auto" />
                  <DataGridTextColumn Header="END" SortMemberPath="EndDate" Binding="{Binding EndDate, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}" Width="Auto" />
                  <DataGridTextColumn Header="LOCATION" SortMemberPath="Location" Binding="{Binding Location}" Width="Auto" />
                  <DataGridTextColumn Header="NATION" SortMemberPath="Nation" Binding="{Binding Nation}" Width="Auto" />
                  <DataGridTextColumn Header="EVENT" SortMemberPath="Name" Binding="{Binding Name}" Width="Auto" />
                  <DataGridTextColumn Header="RACES" SortMemberPath="CompetitionCount" Binding="{Binding CompetitionCount}" Width="Auto" />
                </DataGrid.Columns>
              </DataGrid>
              <DataGrid Name="SeriesCalendarCompetitionsGrid" Classes="raceGrid" ItemsSource="{Binding SeriesCalendarCompetitions}" AutoGenerateColumns="False" IsReadOnly="True" Height="130">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="DATE" Binding="{Binding Date, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}" Width="Auto" />
                  <DataGridTextColumn Header="CODEX" Binding="{Binding FisCode}" Width="Auto" />
                  <local:ChipTextColumn Header="DISCIPLINE" Binding="{Binding Discipline}" Width="Auto" />
                  <local:ChipTextColumn Header="CATEGORY" Binding="{Binding Calendar.Category}" ChipClass="green" Width="Auto" />
                  <DataGridTextColumn Header="GENDER" Binding="{Binding Calendar.Gender, Converter={StaticResource GenderLabelConverter}}" Width="Auto" />
                  <local:SurnameColumn Header="TD SURNAME" Binding="{Binding Calendar.TechnicalDelegate.LastName}" Width="Auto" />
                  <DataGridTextColumn Header="TD FIRST NAME" Binding="{Binding Calendar.TechnicalDelegate.FirstName}" Width="Auto" />
                  <DataGridTextColumn Header="TD NATION" Binding="{Binding Calendar.TechnicalDelegate.Nation}" Width="Auto" />
                  <DataGridTextColumn Header="TD NUMBER" Binding="{Binding Calendar.TechnicalDelegate.Number}" Width="Auto" />
                </DataGrid.Columns>
              </DataGrid>
              <Grid ColumnDefinitions="Auto,*,Auto,8,Auto" IsEnabled="{Binding !IsSeriesCalendarBusy}">
                <Button Grid.Column="2" Content="Close calendar" Command="{Binding CloseSeriesCalendarCommand}" Classes="secondaryAction" />
                <Button Name="UseSeriesCalendarEventButton" Grid.Column="4" Content="Use selected event" Command="{Binding UseSeriesCalendarEventCommand}" Classes="primaryAction"
                        ToolTip.Tip="Import the event and its supported races. Existing course settings and missing values are preserved." />
              </Grid>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="{DynamicResource FormGap}">
              <Grid Classes="cardHeader"><TextBlock Text="Event series" Classes="cardTitle" /></Grid>
              <local:FormRow>
                <StackPanel Grid.Column="0" Grid.ColumnSpan="6" Classes="field">
                  <TextBlock Text="SERIES NAME *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Name}" PlaceholderText="Weekend name" />
                </StackPanel>
                <StackPanel Grid.Column="6" Grid.ColumnSpan="6" Classes="field">
                  <TextBlock Text="ORGANIZER *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Organizer}" PlaceholderText="Organizing club" />
                </StackPanel>
              </local:FormRow>
              <local:FormRow>
                <StackPanel Grid.Column="0" Grid.ColumnSpan="6" Classes="field">
                  <TextBlock Text="LOCATION *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Location}" PlaceholderText="Venue" />
                </StackPanel>
                <StackPanel Grid.Column="6" Grid.ColumnSpan="3" Classes="field">
                  <TextBlock Text="NATION *" Classes="fieldLabel" />
                  <AutoCompleteBox Text="{Binding Nation, Mode=TwoWay}" ItemsSource="{Binding NationChoices}"
                                   ValueMemberBinding="{Binding Code}" FilterMode="Custom" ItemFilter="{x:Static local:NationSearch.Filter}" MinimumPrefixLength="1" MaxLength="3" />
                </StackPanel>
                <StackPanel Grid.Column="9" Grid.ColumnSpan="3" Classes="field">
                  <TextBlock Text="SEASON *" Classes="fieldLabel" />
                  <ComboBox Name="SeriesSeasonInput" IsEditable="True" ItemsSource="{Binding SeriesSeasonChoices}" Text="{Binding Season, Mode=TwoWay}" PlaceholderText="2026/27" />
                </StackPanel>
              </local:FormRow>
              <local:FormRow>
                <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Classes="field">
                  <TextBlock Text="START DATE *" Classes="fieldLabel" />
                  <Grid ColumnDefinitions="*,6,Auto">
                    <TextBox Name="SeriesStartDateInput" Text="{Binding StartDateText}" PlaceholderText="dd.mm.yyyy" MaxLength="10" />
                    <Button Name="SeriesStartDatePickerButton" Grid.Column="2" Width="34" ToolTip.Tip="Choose start date" Click="DatePickerButton_Click" Classes="dateAction">
                      <Path Width="15" Height="15" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                            Data="M2,4 L13,4 13,13 2,13 Z M2,7 L13,7 M5,2 L5,5 M10,2 L10,5" />
                    </Button>
                  </Grid>
                </StackPanel>
                <StackPanel Grid.Column="3" Grid.ColumnSpan="3" Classes="field">
                  <TextBlock Text="END DATE *" Classes="fieldLabel" />
                  <Grid ColumnDefinitions="*,6,Auto">
                    <TextBox Name="SeriesEndDateInput" Text="{Binding EndDateText}" PlaceholderText="dd.mm.yyyy" MaxLength="10" />
                    <Button Name="SeriesEndDatePickerButton" Grid.Column="2" Width="34" ToolTip.Tip="Choose end date" Click="DatePickerButton_Click" Classes="dateAction">
                      <Path Width="15" Height="15" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                            Data="M2,4 L13,4 13,13 2,13 Z M2,7 L13,7 M5,2 L5,5 M10,2 L10,5" />
                    </Button>
                  </Grid>
                </StackPanel>
              </local:FormRow>
            </StackPanel>
          </Border>
          <Border Classes="card" Padding="12,10" IsVisible="{Binding IsCreatingNew}">
            <Grid ColumnDefinitions="*,Auto,8,Auto">
              <Button Grid.Column="1" Content="Cancel" Command="{Binding CancelNewSeriesCommand}" Classes="secondaryAction" />
              <Button Grid.Column="3" Content="Create series file" Command="{Binding CreateSeriesCommand}" Classes="primaryAction" />
            </Grid>
          </Border>
          <Border Classes="card" Padding="12,10" IsVisible="{Binding IsEditingSeries}">
            <Grid ColumnDefinitions="*,Auto">
              <Button Grid.Column="1" Content="Save series" Command="{Binding SaveSeriesCommand}" Classes="primaryAction" />
            </Grid>
          </Border>
        </StackPanel>
        </local:PageColumn>
        <!-- A view led by its list: full width, so the list, editor cards and actions share both window edges. -->
        <StackPanel Spacing="12" IsVisible="{Binding IsCompetitionsSection}">
          <Grid ColumnDefinitions="*,Auto">
            <Button Grid.Column="1" Content="Add competition" Command="{Binding NewCompetitionCommand}" Classes="primaryAction" />
          </Grid>
          <!-- Columns size to their content so no value is cut; a narrow window scrolls the grid instead. -->
          <DataGrid Name="CompetitionsGrid" Classes="raceGrid columnControls" ItemsSource="{Binding CompetitionView}" SelectedItem="{Binding SelectedCompetition}" AutoGenerateColumns="False"
                    SelectionMode="Single"
                    IsReadOnly="True" MinHeight="86" MaxHeight="210" RowHeight="32" ColumnHeaderHeight="32"
                    GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="{DynamicResource LineBrush}">
            <DataGrid.Resources>
              <StaticResource x:Key="DataGridRowSelectedBackgroundBrush" ResourceKey="RowSelectionBrush" />
              <StaticResource x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" ResourceKey="RowSelectionBrush" />
              <StaticResource x:Key="DataGridRowSelectedHoveredBackgroundBrush" ResourceKey="RowSelectionBrush" />
              <StaticResource x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" ResourceKey="RowSelectionBrush" />
              <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
              <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
              <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
              <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
            </DataGrid.Resources>
            <DataGrid.Columns>
              <DataGridTextColumn Header="DATE" Binding="{Binding Values.Date, Mode=OneWay, StringFormat='{}{0:dd.MM.yyyy}'}" Width="Auto" />
              <DataGridTextColumn Header="COMPETITION" Binding="{Binding Values.ShortLabel}" Width="Auto" FontWeight="SemiBold" />
              <DataGridTextColumn Header="EVENT NAME" Binding="{Binding Values.Name}" Width="Auto" />
              <local:ChipTextColumn Header="DISCIPLINE" Binding="{Binding Values.Discipline}" Width="Auto" />
              <DataGridTextColumn Header="CODEX" Binding="{Binding Values.FisCode}" Width="Auto" />
              <local:ChipTextColumn Header="CATEGORY" Binding="{Binding Values.Calendar.Category}" ChipClass="green" Width="Auto" />
              <DataGridTextColumn Header="GENDER" Binding="{Binding Values.Calendar.Gender, Converter={StaticResource GenderLabelConverter}}" Width="Auto" />
              <DataGridTextColumn Header="LOCATION" Binding="{Binding Values.Calendar.Location}" Width="Auto" />
              <DataGridTextColumn Header="COURSE" Binding="{Binding Values.CourseName}" Width="Auto" />
              <DataGridTextColumn Header="HOMOLOGATION" Binding="{Binding Values, Converter={StaticResource HomologationDisplayConverter}}" Width="Auto" />
              <local:SurnameColumn Header="TD SURNAME" Binding="{Binding Values.Calendar.TechnicalDelegate.LastName}" Width="Auto" />
              <DataGridTextColumn Header="TD NUMBER" Binding="{Binding Values.Calendar.TechnicalDelegate.Number}" Width="Auto" />
              <DataGridTextColumn Header="RUNS" Binding="{Binding Values.RunCount}" Width="Auto" />
            </DataGrid.Columns>
          </DataGrid>

          <!-- Editor: cards on the 12-column grid. -->
          <StackPanel Spacing="12" IsVisible="{Binding IsCompetitionEditing}">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding CompetitionEditorTitle}" Classes="sectionTitle" VerticalAlignment="Center" />
            <Border Classes="chip" IsVisible="{Binding CompetitionShortLabel, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding CompetitionShortLabel}" />
            </Border>
          </StackPanel>

          <Grid ColumnDefinitions="*,*,*,*,*,*,*,*,*,*,*,*" ColumnSpacing="12" RowDefinitions="Auto,12,Auto">
            <!-- Race -->
            <Border Grid.Column="0" Grid.ColumnSpan="8" Classes="card">
              <StackPanel Spacing="{DynamicResource FormGap}">
                <Grid Classes="cardHeader"><TextBlock Text="Race" Classes="cardTitle" /></Grid>
                <local:FormRow>
                  <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Classes="field">
                    <TextBlock Text="SHORT NAME *" Classes="fieldLabel" />
                    <TextBox Text="{Binding CompetitionShortLabel}" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Grid.ColumnSpan="6" Classes="field">
                    <TextBlock Text="EVENT NAME *" Classes="fieldLabel" />
                    <TextBox Text="{Binding CompetitionName}" ToolTip.Tip="Event name used in reports and result XML." />
                  </StackPanel>
                  <StackPanel Grid.Column="9" Grid.ColumnSpan="3" Classes="field">
                    <TextBlock Text="DATE *" Classes="fieldLabel" />
                    <Grid ColumnDefinitions="*,6,Auto">
                      <TextBox Name="CompetitionDateInput" Text="{Binding CompetitionDateText}" PlaceholderText="dd.mm.yyyy" MaxLength="10" />
                      <Button Name="CompetitionDatePickerButton" Grid.Column="2" Width="34" ToolTip.Tip="Choose competition date" Click="DatePickerButton_Click" Classes="dateAction">
                        <Path Width="15" Height="15" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                              Data="M2,4 L13,4 13,13 2,13 Z M2,7 L13,7 M5,2 L5,5 M10,2 L10,5" />
                      </Button>
                    </Grid>
                  </StackPanel>
                </local:FormRow>
                <local:FormRow>
                  <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Classes="field">
                    <TextBlock Text="DISCIPLINE" Classes="fieldLabel" />
                    <ComboBox ItemsSource="{Binding Disciplines}" SelectedItem="{Binding CompetitionDiscipline}" />
                  </StackPanel>
                  <StackPanel Grid.Column="3" Grid.ColumnSpan="3" Classes="field">
                    <TextBlock Text="GENDER" Classes="fieldLabel" />
                    <ComboBox ItemsSource="{Binding CompetitionGenders}" SelectedItem="{Binding CompetitionGender}" />
                  </StackPanel>
                  <StackPanel Grid.Column="6" Grid.ColumnSpan="3" Classes="field">
                    <TextBlock Text="RUNS" Classes="fieldLabel" />
                    <NumericUpDown Value="{Binding CompetitionRunCount}" Minimum="1" Maximum="9" FormatString="0" />
                  </StackPanel>
                  <StackPanel Grid.Column="9" Grid.ColumnSpan="3" Classes="field">
                    <TextBlock Text="INTERMEDIATES" Classes="fieldLabel" />
                    <NumericUpDown Value="{Binding CompetitionIntermediateCount}" Minimum="0" Maximum="20" FormatString="0" />
                  </StackPanel>
                </local:FormRow>
                <local:FormRow>
                  <StackPanel Grid.Column="0" Grid.ColumnSpan="9" Classes="field">
                    <TextBlock Text="LOCATION" Classes="fieldLabel" />
                    <TextBox Text="{Binding CompetitionLocation}" />
                  </StackPanel>
                  <StackPanel Grid.Column="9" Grid.ColumnSpan="3" Classes="field">
                    <TextBlock Text="NATION" Classes="fieldLabel" />
                    <AutoCompleteBox Text="{Binding CompetitionNation, Mode=TwoWay}" ItemsSource="{Binding NationChoices}" Classes="nation"
                                     ValueMemberBinding="{Binding Code}" FilterMode="Custom" ItemFilter="{x:Static local:NationSearch.Filter}" MinimumPrefixLength="1" MaxLength="3" />
                  </StackPanel>
                </local:FormRow>
              </StackPanel>
            </Border>

            <!-- FIS data -->
            <Border Grid.Column="8" Grid.ColumnSpan="4" Classes="card">
              <StackPanel Spacing="{DynamicResource FormGap}">
                <Grid Classes="cardHeader"><TextBlock Text="FIS data" Classes="cardTitle" /></Grid>
                <CheckBox Name="CompetitionFisCheckBox" Content="Use FIS rules" IsChecked="{Binding IsCompetitionFis}" />
                <local:FormRow IsVisible="{Binding IsCompetitionFis}">
                  <StackPanel Grid.Column="0" Grid.ColumnSpan="6" Classes="field">
                    <TextBlock Text="FIS CATEGORY" Classes="fieldLabel" />
                    <ComboBox Name="CompetitionCategoryInput" IsEditable="True" ItemsSource="{Binding CompetitionCategoryChoices}"
                              Text="{Binding CompetitionCalendarCategory, Mode=TwoWay}" PlaceholderText="e.g. NJR, FIS, NC"
                              ToolTip.Tip="FIS calendar category code. Pick one or type another code. This is separate from the FIS rules setting." />
                  </StackPanel>
                </local:FormRow>
                <local:FormRow IsVisible="{Binding IsCompetitionFis}">
                  <StackPanel Name="CompetitionFisCodeField" Grid.Column="0" Grid.ColumnSpan="6" Classes="field" IsVisible="{Binding IsCompetitionFis}">
                    <TextBlock Text="FIS CODEX" Classes="fieldLabel" /><TextBox Text="{Binding CompetitionFisCode}" />
                  </StackPanel>
                  <StackPanel Grid.Column="6" Grid.ColumnSpan="6" Classes="field">
                    <TextBlock Text="FIS SEASON" Classes="fieldLabel" />
                    <ComboBox Name="CompetitionSeasonInput" ItemsSource="{Binding CompetitionSeasonChoices}" SelectedItem="{Binding CompetitionSeason, Mode=TwoWay}"
                              ToolTip.Tip="FIS season by its ending year: 2027 is the 2026/27 season." />
                  </StackPanel>
                </local:FormRow>
                <Button Name="GetCompetitionDataButton" Content="Get competition data" Command="{Binding GetCompetitionDataCommand}" IsEnabled="{Binding !IsCompetitionDataBusy}"
                        IsVisible="{Binding IsCompetitionFis}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="secondaryAction" />
                <Panel IsVisible="{Binding IsCompetitionFis}">
                  <TextBlock Text="{Binding CompetitionCalendarStatus}" Classes="supportingText" TextWrapping="Wrap" IsVisible="{Binding HasCompetitionCalendarStatus}" />
                </Panel>
              </StackPanel>
            </Border>

            <!-- Technical delegate -->
            <!-- Both cards of this row are equally tall; their share-to-all checkboxes dock to the bottom edge so they
                 always sit on one line. -->
            <Border Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="5" Classes="card">
              <DockPanel>
                <CheckBox Name="SaveTdToAllRacesCheckBox" DockPanel.Dock="Bottom" Classes="cardFooter" Content="Save TD to all races" IsChecked="{Binding SaveTdToAllRaces}"
                          ToolTip.Tip="Also replace TD surname, first name, nation and number in every race in this series, including blank values." />
              <StackPanel Spacing="{DynamicResource FormGap}">
                <Grid Classes="cardHeader"><TextBlock Text="Technical delegate" Classes="cardTitle" /></Grid>
                <StackPanel Spacing="{DynamicResource FormGap}">
                  <local:FormRow>
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="6" Classes="field"><TextBlock Text="SURNAME" Classes="fieldLabel" /><TextBox Text="{Binding CompetitionTdLastName}" /></StackPanel>
                    <StackPanel Grid.Column="6" Grid.ColumnSpan="6" Classes="field"><TextBlock Text="FIRST NAME" Classes="fieldLabel" /><TextBox Text="{Binding CompetitionTdFirstName}" /></StackPanel>
                  </local:FormRow>
                  <local:FormRow>
                    <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Classes="field"><TextBlock Text="NATION" Classes="fieldLabel" />
                      <AutoCompleteBox Text="{Binding CompetitionTdNation, Mode=TwoWay}" ItemsSource="{Binding NationChoices}" Classes="nation"
                                     ValueMemberBinding="{Binding Code}" FilterMode="Custom" ItemFilter="{x:Static local:NationSearch.Filter}" MinimumPrefixLength="1" MaxLength="3" /></StackPanel>
                    <StackPanel Grid.Column="3" Grid.ColumnSpan="3" Classes="field"><TextBlock Text="TD NUMBER" Classes="fieldLabel" /><TextBox Text="{Binding CompetitionTdNumber}" /></StackPanel>
                  </local:FormRow>
                  <TextBlock Text="{Binding CompetitionTdOriginalName}" Classes="supportingText" TextWrapping="Wrap" IsVisible="{Binding CompetitionTdOriginalName}" />
                </StackPanel>
              </StackPanel>
              </DockPanel>
            </Border>

            <!-- Course and homologation -->
            <Border Grid.Row="2" Grid.Column="5" Grid.ColumnSpan="7" Classes="card">
              <DockPanel Name="CompetitionCourseDetails">
                <CheckBox Name="SaveCourseToAllRacesCheckBox" DockPanel.Dock="Bottom" Classes="cardFooter" Content="{Binding SaveCourseToAllRacesLabel}"
                          IsChecked="{Binding SaveCourseToAllRaces}"
                          ToolTip.Tip="Also replace course name, homologation, start/finish altitudes, vertical drop and course length in every race of the same discipline in this series, including blank values." />
              <StackPanel Spacing="{DynamicResource FormGap}">
                <Grid Classes="cardHeader" ColumnDefinitions="*,Auto">
                  <TextBlock Text="Course and homologation" Classes="cardTitle" />
                  <Button Name="BrowseCompetitionHomologationsButton" Grid.Column="1" Content="Browse FIS homologations" Command="{Binding BrowseCompetitionHomologationsCommand}"
                          IsEnabled="{Binding !IsHomologationBusy}" Classes="secondaryAction" />
                </Grid>
                <TextBlock Text="{Binding CompetitionHomologationStatus}" Classes="supportingText" TextWrapping="Wrap" IsVisible="{Binding HasCompetitionHomologationStatus}" />
                <Grid ColumnDefinitions="*,10,Auto" IsVisible="{Binding HasCompetitionHomologations}">
                  <ComboBox Name="CompetitionHomologationPicker" ItemsSource="{Binding CompetitionHomologations}" SelectedItem="{Binding SelectedCompetitionHomologation}">
                    <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox>
                  <Button Grid.Column="2" Content="Apply homologation" Command="{Binding ApplyCompetitionHomologationCommand}" Classes="secondaryAction" />
                </Grid>
                <local:FormRow>
                  <StackPanel Grid.Column="0" Grid.ColumnSpan="6" Classes="field">
                    <TextBlock Text="COURSE" Classes="fieldLabel" />
                    <TextBox Text="{Binding CompetitionCourseName}" />
                  </StackPanel>
                  <StackPanel Name="CompetitionHomologationField" Grid.Column="6" Grid.ColumnSpan="6" Classes="field">
                    <TextBlock Text="HOMOLOGATION" Classes="fieldLabel" />
                    <TextBox Text="{Binding CompetitionHomologation}" />
                  </StackPanel>
                </local:FormRow>
                <local:FormRow>
                  <Border Grid.Column="0" Grid.ColumnSpan="3" Classes="statField">
                    <StackPanel>
                      <TextBlock Text="START ALTITUDE" Classes="fieldLabel" />
                      <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding CompetitionStartAltitude}" /><TextBlock Grid.Column="1" Text="m" Classes="unit" /></Grid>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="3" Grid.ColumnSpan="3" Classes="statField">
                    <StackPanel>
                      <TextBlock Text="FINISH ALTITUDE" Classes="fieldLabel" />
                      <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding CompetitionFinishAltitude}" /><TextBlock Grid.Column="1" Text="m" Classes="unit" /></Grid>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="6" Grid.ColumnSpan="3" Classes="statField">
                    <StackPanel>
                      <TextBlock Text="VERTICAL DROP" Classes="fieldLabel" />
                      <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding CompetitionVerticalDrop}" /><TextBlock Grid.Column="1" Text="m" Classes="unit" /></Grid>
                    </StackPanel>
                  </Border>
                  <Border Grid.Column="9" Grid.ColumnSpan="3" Classes="statField">
                    <StackPanel>
                      <TextBlock Text="COURSE LENGTH" Classes="fieldLabel" />
                      <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding CompetitionCourseLength}" /><TextBlock Grid.Column="1" Text="m" Classes="unit" /></Grid>
                    </StackPanel>
                  </Border>
                </local:FormRow>
              </StackPanel>
              </DockPanel>
            </Border>
          </Grid>

          <!-- Actions: the destructive one on the left, away from Save. -->
          <Border Classes="card" Padding="12,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <Button Content="Remove competition" Command="{Binding RemoveCompetitionCommand}" Classes="dangerAction" IsVisible="{Binding SelectedCompetition}" />
              <Button Grid.Column="2" Content="Save competition" Command="{Binding SaveCompetitionCommand}" Classes="primaryAction" />
            </Grid>
          </Border>
          </StackPanel>
        </StackPanel>
        <StackPanel Spacing="12" IsVisible="{Binding IsCompetitorsSection}">
          <ItemsControl ItemsSource="{Binding ImportWarnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <!-- Desk status and save: edits in the grid stay pending until Save. -->
          <Border Classes="card" Padding="12,8">
            <Grid ColumnDefinitions="Auto,8,*,Auto,8,Auto" VerticalAlignment="Center">
              <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" IsVisible="{Binding HasDeskChangeLog}" />
              <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasDeskChangeLog}" />
              <TextBlock Grid.Column="2" Text="{Binding UnsavedChangesText}" FontWeight="SemiBold" VerticalAlignment="Center" />
              <Button Grid.Column="3" Content="{Binding ChangeReviewButtonText}" Command="{Binding ToggleChangeReviewCommand}"
                      IsEnabled="{Binding HasDeskChangeLog}" Classes="secondaryAction" />
              <Button Grid.Column="5" Content="Save" Command="{Binding CommitDeskChangesCommand}"
                      IsEnabled="{Binding HasDeskChangeLog}" Classes="primaryAction" />
            </Grid>
          </Border>
          <Border Name="ChangeReviewPanel" Classes="card" IsVisible="{Binding IsChangeReviewOpen}">
            <StackPanel Spacing="6">
              <Grid Classes="cardHeader" ColumnDefinitions="Auto,*">
                <TextBlock Text="UNSAVED CHANGES" Classes="fieldLabel" VerticalAlignment="Center" />
              </Grid>
              <ScrollViewer MaxHeight="135"><ItemsControl ItemsSource="{Binding DeskChangeLog}"><ItemsControl.ItemTemplate><DataTemplate>
                <Grid ColumnDefinitions="*,Auto" Margin="0,2"><TextBlock Text="{Binding DisplayLabel}" ToolTip.Tip="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Undo" Click="RestoreDeskChange_Click" Classes="secondaryAction" /></Grid>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
              <Grid ColumnDefinitions="Auto,*">
                <Button Content="Discard all changes" Command="{Binding DiscardDeskChangesCommand}" Classes="dangerAction" />
              </Grid>
            </StackPanel>
          </Border>
          <!-- A large, virtualized and editable grid keeps declared column widths (with a floor), so columns do not
               jump while the operator scrolls; the grid scrolls horizontally when narrow. -->
          <DataGrid Name="CompetitorGrid" Classes="raceGrid columnControls" ItemsSource="{Binding VisibleCompetitors}" SelectedItem="{Binding SelectedCompetitorRow}"
                    SelectionMode="Extended" SelectionChanged="CompetitorGrid_SelectionChanged" Sorting="CompetitorGrid_Sorting" CanUserSortColumns="True" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="False"
                    FrozenColumnCount="3" HorizontalScrollBarVisibility="Auto"
                    MinHeight="300" RowHeight="30" ColumnHeaderHeight="34" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
              <DataGrid.ContextMenu><ContextMenu>
                <MenuItem Header="Select all" InputGesture="Ctrl+A" Click="SelectAllContext_Click" />
                <MenuItem Header="Paste from Excel" InputGesture="Ctrl+V" Click="PasteContext_Click" />
                <MenuItem Header="Copy selected" InputGesture="Ctrl+C" Click="CopyContext_Click" />
                <Separator />
                <MenuItem Header="Delete selected rows" InputGesture="Delete" Click="DeleteContext_Click" />
              </ContextMenu></DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTemplateColumn Header="" IsReadOnly="True" CanUserSort="False" Width="40" MinWidth="40"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding ChangeMarker}" Classes="markerCell" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="CODE" SortMemberPath="FederationCode" Width="100" MinWidth="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FederationCode}" Classes="gridCell" Classes.changed="{Binding IsCodeChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding FederationCode}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="SURNAME" SortMemberPath="Surname" Width="145" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Surname}" Classes="gridCell surname" Classes.changed="{Binding IsSurnameChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding Surname}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="FIRST NAME" SortMemberPath="FirstName" Width="125" MinWidth="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FirstName}" Classes="gridCell" Classes.changed="{Binding IsFirstNameChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding FirstName}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="YEAR" SortMemberPath="BirthYearText" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BirthYearText}" Classes="gridCell" Classes.changed="{Binding IsYearChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding BirthYearText}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="GENDER" SortMemberPath="GenderText" Width="95" MinWidth="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding GenderText}" Classes="gridCell" Classes.changed="{Binding IsGenderChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding AvailableGenders}" SelectedItem="{Binding GenderText}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="NAT" SortMemberPath="Nation" Width="70" MinWidth="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Nation}" Classes="gridCell" Classes.changed="{Binding IsNationChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding Nation}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="CLUB" SortMemberPath="Club" Width="145" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Club}" Classes="gridCell" Classes.changed="{Binding IsClubChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding Club}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="DH PTS" SortMemberPath="FisDh" IsReadOnly="True" Width="75" MinWidth="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FisDhText}" Classes="gridCell" Classes.changed="{Binding IsDhChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="SG PTS" SortMemberPath="FisSg" IsReadOnly="True" Width="75" MinWidth="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FisSgText}" Classes="gridCell" Classes.changed="{Binding IsSgChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="SL PTS" SortMemberPath="FisSl" IsReadOnly="True" Width="75" MinWidth="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FisSlText}" Classes="gridCell" Classes.changed="{Binding IsSlChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="GS PTS" SortMemberPath="FisGs" IsReadOnly="True" Width="75" MinWidth="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FisGsText}" Classes="gridCell" Classes.changed="{Binding IsGsChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="AC PTS" SortMemberPath="FisAc" IsReadOnly="True" Width="75" MinWidth="55"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FisAcText}" Classes="gridCell" Classes.changed="{Binding IsAcChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" SortMemberPath="Category" IsReadOnly="True" Width="125" MinWidth="80" />
              </DataGrid.Columns>
            </DataGrid>
          <Border Classes="infoNote" IsVisible="{Binding SelectedCompetitorRow.NeedsApproval}"><StackPanel Orientation="Horizontal" Spacing="12">
            <TextBlock Text="{Binding SelectedCompetitorRow.WarningText}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
            <CheckBox Content="Match checked" IsChecked="{Binding SelectedCompetitorRow.WarningApproved}" VerticalAlignment="Center" />
          </StackPanel></Border>
          <Expander Header="Update from FIS" IsExpanded="{Binding IsFisPanelOpen}" HorizontalAlignment="Stretch">
            <StackPanel Spacing="{DynamicResource FormGap}">
            <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2">
              <TextBlock Text="{Binding FisListDisplay}" FontWeight="SemiBold" />
              <TextBlock Text="{Binding FisListValidityText}" Classes="supportingText" />
            </StackPanel><Button Grid.Column="1" Content="Update from FIS list" Command="{Binding StageFisUpdatesCommand}" VerticalAlignment="Center" ToolTip.Tip="Update name, birth year, gender, nation and club of existing competitors from the loaded FIS list. Changes are highlighted; Save keeps them." Classes="secondaryAction" /></Grid>
            <local:FormRow>
              <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Classes="field">
                <TextBlock Text="LIST EFFECTIVE ON" Classes="fieldLabel" />
                <Grid ColumnDefinitions="*,6,Auto">
                  <TextBox Name="FisEffectiveDateInput" Text="{Binding FisEffectiveDateText}" PlaceholderText="YYYY-MM-DD" ToolTip.Tip="Date the FIS point list must be effective on." />
                  <Button Name="FisDatePickerButton" Grid.Column="2" Width="34" ToolTip.Tip="Choose effective date" Click="DatePickerButton_Click" Classes="dateAction">
                    <Path Width="15" Height="15" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                          Data="M2,4 L13,4 13,13 2,13 Z M2,7 L13,7 M5,2 L5,5 M10,2 L10,5" />
                  </Button>
                </Grid>
              </StackPanel>
              <Button Grid.Column="2" Grid.ColumnSpan="2" Content="Download FIS point list" Command="{Binding DownloadFisListCommand}" IsEnabled="{Binding !IsFisBusy}"
                      VerticalAlignment="Bottom" HorizontalAlignment="Left" Classes="secondaryAction" />
            </local:FormRow>
            <local:FormRow>
              <Grid Grid.Column="0" Grid.ColumnSpan="10" ColumnDefinitions="*,6,34">
                <TextBox Name="FisSearchInput" Text="{Binding FisSearchText}" PlaceholderText="Search FIS by code, name, nation or club (2+ characters)" />
                <Button Grid.Column="2" Width="34" Content="×" ToolTip.Tip="Clear search" Command="{Binding ClearFisSearchCommand}" Click="FocusFisSearch_Click" HorizontalContentAlignment="Center" Classes="secondaryAction" Padding="0" />
              </Grid>
              <Button Grid.Column="10" Grid.ColumnSpan="2" Content="Add selected competitors" Command="{Binding StageSelectedFisAthleteCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Classes="secondaryAction" />
            </local:FormRow>
            <ListBox Name="FisSearchResultsList" ItemsSource="{Binding FisSearchResults}" SelectionMode="Multiple" SelectionChanged="FisSearchResults_SelectionChanged" MaxHeight="150">
              <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" FontSize="12" /></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            </StackPanel>
          </Expander>
          <Expander Header="Category rules · birth-year range and gender" HorizontalAlignment="Stretch">
            <StackPanel Spacing="{DynamicResource FormGap}">
            <DataGrid Classes="raceGrid" ItemsSource="{Binding CategoryRules}" SelectedItem="{Binding SelectedCategoryRule}"
                      AutoGenerateColumns="False" IsReadOnly="True" MinHeight="70" MaxHeight="150"
                      RowHeight="28" ColumnHeaderHeight="28" HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Values.Label}" Width="Auto" MinWidth="160" />
                <DataGridTextColumn Header="FROM YEAR" Binding="{Binding Values.BirthYearMin}" Width="Auto" />
                <DataGridTextColumn Header="TO YEAR" Binding="{Binding Values.BirthYearMax}" Width="Auto" />
                <DataGridTextColumn Header="GENDER" Binding="{Binding Values.Gender, Converter={StaticResource GenderLabelConverter}}" Width="Auto" />
                <DataGridTextColumn Header="ORDER" Binding="{Binding Values.DisplayOrder}" Width="Auto" />
              </DataGrid.Columns>
            </DataGrid>
            <local:FormRow>
              <StackPanel Grid.Column="0" Grid.ColumnSpan="4" Classes="field"><TextBlock Text="LABEL" Classes="fieldLabel" /><TextBox Text="{Binding CategoryLabel}" /></StackPanel>
              <StackPanel Grid.Column="4" Grid.ColumnSpan="2" Classes="field"><TextBlock Text="FROM YEAR" Classes="fieldLabel" /><TextBox Text="{Binding CategoryMinYearText}" /></StackPanel>
              <StackPanel Grid.Column="6" Grid.ColumnSpan="2" Classes="field"><TextBlock Text="TO YEAR" Classes="fieldLabel" /><TextBox Text="{Binding CategoryMaxYearText}" /></StackPanel>
              <StackPanel Grid.Column="8" Grid.ColumnSpan="2" Classes="field"><TextBlock Text="GENDER" Classes="fieldLabel" /><ComboBox ItemsSource="{Binding CategoryGenderOptions}" SelectedItem="{Binding CategoryGenderText}" /></StackPanel>
              <StackPanel Grid.Column="10" Grid.ColumnSpan="2" Classes="field"><TextBlock Text="ORDER" Classes="fieldLabel" /><TextBox Text="{Binding CategoryOrderText}" /></StackPanel>
            </local:FormRow>
            <Grid ColumnDefinitions="Auto,*,Auto,8,Auto">
              <Button Content="Remove rule" Command="{Binding RemoveCategoryRuleCommand}" IsEnabled="{Binding SelectedCategoryRule}" Classes="dangerAction" />
              <Button Grid.Column="2" Content="New rule" Command="{Binding NewCategoryRuleCommand}" Classes="secondaryAction" />
              <Button Grid.Column="4" Content="Save rule" Command="{Binding SaveCategoryRuleCommand}" Classes="primaryAction" />
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Save rules for reuse" Command="{Binding SaveCategoryRulesPresetCommand}" Classes="secondaryAction" />
              <Button Content="Load saved rules (replace)" Command="{Binding LoadCategoryRulesPresetCommand}" Classes="secondaryAction" />
              <Button Content="Update categories" Command="{Binding UpdateCategoriesCommand}" Classes="secondaryAction" />
            </StackPanel>
            </StackPanel>
          </Expander>
        </StackPanel>
        <local:SettingsView IsVisible="{Binding IsSettingsSection}" />
      </StackPanel>
    </ScrollViewer>
    <local:DrawView Grid.Row="2" Margin="{DynamicResource PageInset}" IsVisible="{Binding IsDrawSection}" />
    <local:PdfFactoryView Grid.Row="2" Margin="{DynamicResource PageInset}" IsVisible="{Binding IsPdfFactorySection}" />
    <!-- No top inset: the device strip starts right under the navigation instead of being pulled under it. -->
    <local:TimingView Name="TimingWorkspace" Grid.Row="2" Margin="12,0,12,8" IsVisible="{Binding IsTimingSection}" />
    <local:ResultsView Grid.Row="2" Margin="{DynamicResource PageInset}" IsVisible="{Binding IsResultsSection}" />
    <local:TimingReportView Grid.Row="2" Margin="{DynamicResource PageInset}" IsVisible="{Binding IsTimingReportSection}" />
    <Border Grid.Row="3" Classes="statusBar" Classes.error="{Binding IsError}"
            BorderThickness="0,1,0,0" Padding="12,4">
      <Grid ColumnDefinitions="*,Auto">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Width="8" Height="8" CornerRadius="4" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsError}" />
        <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" IsVisible="{Binding IsError}" />
        <TextBlock Text="{Binding StatusMessage}" Classes="statusText" Classes.error="{Binding IsError}"
                   FontSize="12" TextWrapping="Wrap" />
        <TextBlock Text="{Binding TimingCaptureLabel}" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="560" IsVisible="{Binding IsTimingConnected}" />
      </StackPanel>
      <!-- Timing: starters, on course and finished of the open run. -->
      <TextBlock Grid.Column="1" Name="TimingSummaryText" Text="{Binding TimingSummary}" FontSize="12" Foreground="{DynamicResource TextBrush}"
                 VerticalAlignment="Center" Margin="12,0,0,0" IsVisible="{Binding IsTimingSection}" />
      </Grid>
    </Border>
  </Grid>
  </ThemeVariantScope>
</Window>
