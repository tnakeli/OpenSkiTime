<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:OpenSkiTime.Desktop" x:Class="OpenSkiTime.Desktop.TimingView" x:CompileBindings="False">
 <UserControl.Resources>
  <x:Double x:Key="DataGridSortIconMinWidth">14</x:Double>
  <ControlTheme x:Key="DataGridCellTextBlockTheme" TargetType="TextBlock"><Setter Property="Margin" Value="6,0" /><Setter Property="VerticalAlignment" Value="Center" /></ControlTheme>
 </UserControl.Resources>
 <UserControl.Styles>
  <Style Selector="Button.backupWarning"><Setter Property="Background" Value="{DynamicResource BannerWarningBrush}" /><Setter Property="Foreground" Value="{DynamicResource BannerWarningTextBrush}" /></Style>
  <Style Selector="Border.backupClockProblem"><Setter Property="Background" Value="{DynamicResource BannerWarningBrush}" /></Style>
  <Style Selector="Border.backupClockProblem TextBlock"><Setter Property="Foreground" Value="{DynamicResource BannerWarningTextBrush}" /></Style>
 </UserControl.Styles>
 <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">
  <!-- Device and publishing strip, full width under the navigation: A timing and its inputs, B clock, live channels and
       the device clock. -->
  <Border Classes="raceConnection" Margin="-12,0,-12,8">
   <!-- Clocks on the left (A with its input switches, B), publishing and the device time on the right. The clock groups
        wrap to a second row instead of being cut off in a narrow window (many intermediates, a clock warning); the A
        connection text is shortened (full text in its tooltip). -->
   <DockPanel>
    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
     <Border Classes="stripDivider" Height="20" VerticalAlignment="Center" />
     <local:LiveTimingView VerticalAlignment="Center" />
     <Border Classes="stripDivider" Height="20" VerticalAlignment="Center" />
     <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
      <TextBlock Classes="raceConnectionText" Text="Device time:" Foreground="{DynamicResource MutedTextBrush}" />
      <TextBlock Classes="raceConnectionText" Text="{Binding TimingDeviceClock}" FontFamily="{DynamicResource TimeFontFamily}" FontWeight="SemiBold" />
     </StackPanel>
    </StackPanel>
   <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
     <Ellipse Classes="connectionDot" Classes.on="{Binding IsTimingConnected}" VerticalAlignment="Center" ToolTip.Tip="{Binding TimingConnection}" />
     <TextBlock Classes="raceConnectionText" Text="A:" FontWeight="SemiBold" Margin="3,0,2,0" VerticalAlignment="Center" />
     <ToggleButton Content="START" IsChecked="{Binding StartInputOn, Mode=OneWay}" Command="{Binding ToggleTimingChannelCommand}" CommandParameter="start" IsEnabled="{Binding IsTimingConnected}" />
     <StackPanel Name="TimingIntermediateSwitches" Orientation="Horizontal" Spacing="4" />
     <ToggleButton Content="FINISH" IsChecked="{Binding FinishInputOn, Mode=OneWay}" Command="{Binding ToggleTimingChannelCommand}" CommandParameter="finish" IsEnabled="{Binding IsTimingConnected}" />
     <TextBlock Classes="raceConnectionText" Text="{Binding TimingHoldSummary}" VerticalAlignment="Center" Margin="4,0,0,0" FontWeight="SemiBold" />
     <Border Name="TimingClockWarningBadge" IsVisible="{Binding HasTimingClockWarning}" Background="{DynamicResource BannerWarningBrush}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" ToolTip.Tip="{Binding TimingClockWarning}">
      <TextBlock Text="{Binding TimingClockWarning}" Foreground="{DynamicResource BannerWarningTextBrush}" FontSize="12" FontWeight="SemiBold" MaxWidth="420" TextTrimming="CharacterEllipsis" />
     </Border>
    </StackPanel>
    <TextBlock Classes="raceConnectionText" Text="{Binding TimingConnection}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
               Margin="10,0,0,0" MaxWidth="280" ToolTip.Tip="{Binding TimingConnection}" />
    <Border Classes="stripDivider" Height="20" VerticalAlignment="Center" />
    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
     <TextBlock Classes="raceConnectionText" Text="B:" FontWeight="SemiBold" VerticalAlignment="Center" />
     <Border Name="BackupClockStatusBadge" Classes.backupClockProblem="{Binding HasBackupClockProblem}" CornerRadius="3" Padding="6,1" VerticalAlignment="Center" ToolTip.Tip="{Binding BackupClockStatusText, StringFormat='{}{0} · B never changes A timing.'}">
      <TextBlock Name="BackupClockStatusText" Classes="raceConnectionText" Text="{Binding BackupClockStatusText}" MaxWidth="300" TextTrimming="CharacterEllipsis" />
     </Border>
     <Button Name="ShowBackupButton" Content="{Binding BackupButtonText}" Command="{Binding ShowBackupCommand}" IsEnabled="{Binding CanShowBackup}" Classes.backupWarning="{Binding HasBackupWarning}" MinHeight="24" Padding="8,1" FontSize="12" Focusable="False" ToolTip.Tip="Show independent B timestamps for 30 seconds. A timing remains unchanged." />
    </StackPanel>
   </WrapPanel>
   </DockPanel>
  </Border>
  <StackPanel Grid.Row="1" Spacing="4">
   <TextBlock Text="{Binding LiveTimingError}" IsVisible="{Binding HasLiveTimingError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" Margin="0,0,0,4" />
   <TextBlock Name="BackupWarningText" Text="{Binding BackupWarning}" IsVisible="{Binding HasBackupWarning}" Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,4" />
   <Border IsVisible="{Binding HasTimingAlarm}" BorderBrush="{DynamicResource ErrorBrush}" Background="{DynamicResource ErrorTintBrush}" BorderThickness="1" Padding="8" Margin="0,0,0,4">
    <Grid ColumnDefinitions="*,8,Auto"><TextBlock Text="{Binding TimingAlarm}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" /><Button Grid.Column="2" Content="Retry storage" Command="{Binding RetryTimingStorageCommand}" Classes="dangerAction" /></Grid>
   </Border>
  </StackPanel>
  <!-- The start and running queues keep priority during a run (they stay readable at 980×680); the ranking gets the
       remaining share before the timestamps. Visible grips let the operator rebalance, for example after the run. -->
  <Grid Grid.Row="2" Name="TimingPanes" ColumnDefinitions="0.9*,8,2*">
   <Grid.RowDefinitions>
    <RowDefinition Height="1.85*" MinHeight="96" /><RowDefinition Height="6" />
    <RowDefinition Height="0.75*" MinHeight="48" /><RowDefinition Height="6" />
    <RowDefinition Height="1.4*" MinHeight="80" />
   </Grid.RowDefinitions>
   <Border Name="StartDropTarget" Classes="racePane"><Grid RowDefinitions="Auto,Auto,*">
    <Grid Background="{DynamicResource HeaderSurfaceBrush}" ColumnDefinitions="*,Auto">
     <TextBlock Text="{Binding AtStartRows.Count, StringFormat='AT START ({0})'}" Classes="raceHeading" />
     <!-- Quick forerunner entry: they start before the competitors and are shown in Results. -->
     <ToggleButton Grid.Column="1" Name="ForerunnersToggle" Content="Forerunners" Classes="secondaryAction" IsChecked="{Binding ShowForerunnerEditor}"
                   MinHeight="24" Padding="10,1" FontSize="12" Margin="0,0,6,0" VerticalAlignment="Center" ToolTip.Tip="{Binding ForerunnerSummary}" />
    </Grid>
    <Grid Grid.Row="1">
     <TextBlock Text="{Binding NextStartLabel, StringFormat='Next · {0}'}" Classes="raceQueueHint" />
     <TextBlock Text="{Binding TimingDropHint}" IsVisible="{Binding IsTimingDragging}" Classes="raceQueueHint raceDropHint" />
    </Grid>
    <DataGrid Grid.Row="2" Name="AtStartGrid" Classes="raceGrid timingGrid" ItemsSource="{Binding AtStartRows}" SelectionChanged="SelectCompetitor" PointerPressed="SelectContextCompetitor" LoadingRow="EnableStartRowDrop"
     AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="False" RowHeight="28" GridLinesVisibility="Horizontal"
     ToolTip.Tip="Drag a waiting racer above or below another row to change start order. Drop on empty At start space to start next. Ctrl+Up/Down moves one place.">
     <DataGrid.Columns>
      <DataGridTextColumn Header="" Binding="{Binding Clock.Marker}" Width="26" />
      <DataGridTextColumn Header="BIB" Binding="{Binding BibText}" Width="56" />
      <DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" MinWidth="100" />
      <DataGridTextColumn Header="RUN 1" Binding="{Binding PreviousRunTime}" Width="78" IsVisible="{Binding ShowTimingTotal}" />
     </DataGrid.Columns>
    </DataGrid>
   </Grid></Border>
   <Border Grid.Column="2" Classes="racePane"><Grid RowDefinitions="Auto,Auto,*,Auto">
    <TextBlock Text="{Binding RunningRows.Count, StringFormat='ON COURSE ({0})'}" Classes="raceHeading" />
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Background="{DynamicResource AccentTintBrush}">
     <TextBlock Text="{Binding ExpectedFinishLabel, StringFormat='Finish next · {0}'}" Classes="raceQueueHint" />
     <TextBlock Grid.Column="1" Text="{Binding ExpectedFinishTime}" Classes="raceClock" Margin="8,3" FontSize="18" />
    </Grid>
    <DataGrid Grid.Row="2" Name="RunningGrid" Classes="raceGrid timingGrid" ItemsSource="{Binding RunningRows}" SelectionChanged="SelectCompetitor" PointerPressed="SelectContextCompetitor" LoadingRow="MarkForerunnerRow"
     AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="False" RowHeight="28" GridLinesVisibility="Horizontal"
     ToolTip.Tip="▶ Expected finish. Right-click or Shift+F10 for actions.">
     <DataGrid.Columns>
      <DataGridTextColumn Header="" Binding="{Binding Clock.Marker}" Width="26" />
      <DataGridTextColumn Header="BIB" Binding="{Binding BibText}" Width="56" />
      <DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" MinWidth="110" />
      <DataGridTextColumn Header="CURRENT" Binding="{Binding Clock.Time}" Width="96" FontWeight="Bold" FontSize="18" Foreground="{StaticResource AccentBrush}" />
     </DataGrid.Columns>
    </DataGrid>
    <!-- Status actions for the selected competitor; also drop targets when dragging a competitor. -->
    <Border Grid.Row="3" Classes="paneActions">
     <Grid ColumnDefinitions="Auto,*,Auto">
      <Button Content="Prepare Run 2" Command="{Binding PrepareNextTimedRunCommand}" IsVisible="{Binding CanPrepareNextTimedRun}" Classes="secondaryAction" />
      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
       <Button Name="StatusDropDNS" Tag="DNS" Content="DNS" Command="{Binding ClassifyTimingCommand}" CommandParameter="DNS" Classes="statusDrop" ToolTip.Tip="Did not start · Ctrl+D. Drag a competitor here." />
       <Button Name="StatusDropDNF" Tag="DNF" Content="DNF" Command="{Binding ClassifyTimingCommand}" CommandParameter="DNF" Classes="statusDrop" ToolTip.Tip="Did not finish · Ctrl+F. Drag a competitor here." />
       <Button Name="StatusDropDSQ" Tag="DSQ" Content="DSQ" Command="{Binding ClassifyTimingCommand}" CommandParameter="DSQ" Classes="statusDrop" ToolTip.Tip="Disqualified · Ctrl+Q. Drag a competitor here." />
       <Button Name="StatusDropNPS" Tag="NPS" Content="NPS" Command="{Binding ClassifyTimingCommand}" CommandParameter="NPS" Classes="statusDrop" ToolTip.Tip="Not permitted to start · Ctrl+N. Drag a competitor here." />
       <Button Name="StatusDropClear" Tag="Clear" Content="Clear status" Command="{Binding ClassifyTimingCommand}" CommandParameter="Clear" Classes="statusDrop" ToolTip.Tip="Use recorded times · Ctrl+R. Drag a competitor here." />
      </StackPanel>
     </Grid>
    </Border>
   </Grid></Border>
   <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" ResizeDirection="Rows" HorizontalAlignment="Stretch" Classes="paneSplitter" ToolTip.Tip="Drag to resize the panes" />
   <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="racePane"><Grid RowDefinitions="Auto,*">
    <Grid Background="{DynamicResource HeaderSurfaceBrush}">
     <TextBlock Text="TIMESTAMPS · TIME OF DAY" Classes="raceHeading" />
    </Grid>
    <DataGrid Grid.Row="1" Name="TimestampsGrid" Classes="raceGrid timingGrid" ItemsSource="{Binding TimestampRows}" SelectionChanged="SelectCompetitor" PointerPressed="SelectContextCompetitor" LoadingRow="MarkForerunnerRow"
     AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="False" RowHeight="26" GridLinesVisibility="All"
     ToolTip.Tip="Drop a competitor on a timestamp to assign it. Double-click a START, INTERM or FINISH cell (or F2) to enter a missing time manually; m marks a manual time.">
     <DataGrid.Columns>
      <DataGridTextColumn Header="BIB" Binding="{Binding BibText}" Width="56" />
      <DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" MinWidth="160" />
     </DataGrid.Columns>
    </DataGrid>
   </Grid></Border>
   <GridSplitter Grid.Row="3" Grid.ColumnSpan="3" ResizeDirection="Rows" HorizontalAlignment="Stretch" Classes="paneSplitter" ToolTip.Tip="Drag to resize the panes" />
   <Border Grid.Row="4" Grid.ColumnSpan="3" Classes="racePane"><Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Background="{DynamicResource HeaderSurfaceBrush}">
     <TextBlock Text="RANKING" Classes="raceHeading" />
     <TextBlock Grid.Column="1" Text="◆ Latest finisher" Classes="supportingText" FontSize="11" Margin="8,0" VerticalAlignment="Center" />
    </Grid>
    <DataGrid Grid.Row="1" Name="RankingGrid" Classes="raceGrid timingGrid columnControls" ItemsSource="{Binding RankingView}" SelectionChanged="SelectCompetitor" PointerPressed="SelectContextCompetitor" LoadingRowGroup="DescribeCategory" LoadingRow="MarkForerunnerRow"
     AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Extended" CanUserSortColumns="False" RowHeight="28" GridLinesVisibility="Horizontal"
     ToolTip.Tip="Results in rank order within each category. Drag a competitor onto a timestamp to assign it. Right-click or Shift+F10 for status.">
     <DataGrid.Columns>
      <DataGridTextColumn Header="" Binding="{Binding FinishMarker}" Width="28" Foreground="{StaticResource AccentBrush}" FontSize="15" />
      <DataGridTextColumn Header="RK" Binding="{Binding DisplayRank}" Width="42" FontWeight="SemiBold" />
      <DataGridTextColumn Header="BIB" Binding="{Binding BibText}" Width="56" />
      <DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" MinWidth="130" />
      <DataGridTextColumn Header="NAT" Binding="{Binding Result.Entry.Entrant.Athlete.Nation}" Width="55" />
      <DataGridTextColumn Header="CLUB" Binding="{Binding Result.Entry.Entrant.Athlete.Club}" Width="*" MinWidth="100" />
      <DataGridTextColumn Header="RUN 1" Binding="{Binding PreviousRunRanked}" Width="96" IsVisible="{Binding ShowTimingTotal}" Tag="previousRun" />
      <DataGridTextColumn Header="RUN 1" Binding="{Binding DisplayTime}" Width="90" Tag="runTime" FontWeight="SemiBold" />
      <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalTime}" Width="90" IsVisible="{Binding ShowTimingTotal}" FontWeight="SemiBold" />
     </DataGrid.Columns>
    </DataGrid>
   </Grid></Border>
  </Grid>
  <Border Grid.Row="2" Name="BackupTimesPanel" IsVisible="{Binding ShowBackupTimes}" Classes="racePane" Padding="6" VerticalAlignment="Bottom" MaxHeight="180">
   <Grid RowDefinitions="Auto,Auto">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding BackupDisplayLabel}" Classes="eyebrow" VerticalAlignment="Center" /><Button Name="HideBackupButton" Grid.Column="1" Content="Hide B" Command="{Binding HideBackupCommand}" MinHeight="19" Padding="7,1" FontSize="10" Focusable="False" /></Grid>
    <DataGrid Grid.Row="1" Name="BackupTimesGrid" ItemsSource="{Binding BackupMonitorRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" RowHeight="24" MaxHeight="145" Focusable="False">
     <DataGrid.Columns>
      <DataGridTextColumn Header="BIB" Binding="{Binding Bib}" Width="48" /><DataGridTextColumn Header="POINT" Binding="{Binding Position}" Width="70" />
      <DataGridTextColumn Header="A" Binding="{Binding A}" Width="160" /><DataGridTextColumn Header="B" Binding="{Binding B}" Width="160" />
      <DataGridTextColumn Header="B − A (s)" Binding="{Binding Difference}" Width="116" /><DataGridTextColumn Header="CHECK" Binding="{Binding Status}" Width="*" MinWidth="90" />
     </DataGrid.Columns>
    </DataGrid>
   </Grid>
  </Border>
  <StackPanel Grid.Row="3" Spacing="3" Margin="0,5,0,0">
   <!-- Forerunners of this run: the same list as in Results. Enter, edit, copy from Run 1, then Save. -->
   <Border Name="ForerunnerEditor" Classes="racePane" Padding="8" IsVisible="{Binding ShowForerunnerEditor}">
    <Grid ColumnDefinitions="*,8,Auto" RowDefinitions="Auto,Auto">
     <TextBlock Text="{Binding TimingRun, StringFormat='FORERUNNERS · RUN {0}'}" Classes="raceHeadingText" Margin="0,0,0,4" />
     <TextBlock Grid.Column="2" Text="Start before the competitors · times shown only in Timing · listed in Results" Classes="supportingText" FontSize="12" VerticalAlignment="Center" />
     <DataGrid Grid.Row="1" Name="ForerunnersGrid" Classes="raceGrid" ItemsSource="{Binding TimingForerunners}" SelectedItem="{Binding SelectedTimingForerunner}"
               AutoGenerateColumns="False" CanUserSortColumns="False" RowHeight="28" ColumnHeaderHeight="26" MaxHeight="150" GridLinesVisibility="Horizontal">
      <DataGrid.Columns>
       <DataGridTextColumn Header="ID" Binding="{Binding Letter}" Width="70" />
       <DataGridTextColumn Header="FIRST NAME" Binding="{Binding FirstName}" Width="*" />
       <DataGridTextColumn Header="SURNAME" Binding="{Binding LastName}" Width="*" />
       <DataGridTextColumn Header="NAT" Binding="{Binding Nation}" Width="70" />
      </DataGrid.Columns>
     </DataGrid>
     <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4" VerticalAlignment="Top">
      <Button Name="AddForerunnerButton" Content="Add" Command="{Binding AddTimingForerunnerCommand}" Classes="secondaryAction" HorizontalAlignment="Stretch" />
      <Button Content="Remove" Command="{Binding RemoveTimingForerunnerCommand}" Classes="dangerAction" HorizontalAlignment="Stretch" />
      <Button Name="CopyForerunnersButton" Content="Copy Run 1" Command="{Binding CopyForerunnersFromRunOneCommand}" IsVisible="{Binding CanCopyForerunnersFromRunOne}" Classes="secondaryAction" HorizontalAlignment="Stretch" />
      <Button Name="SaveForerunnersButton" Content="Save" Command="{Binding SaveTimingForerunnersCommand}" Classes="primaryAction" HorizontalAlignment="Stretch" />
      <Button Content="Cancel" Command="{Binding CancelTimingForerunnersCommand}" Classes="secondaryAction" HorizontalAlignment="Stretch" />
     </StackPanel>
    </Grid>
   </Border>
   <Border Classes="correctionBar">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
     <TextBlock Text="CORRECTION / RECLASSIFICATION" Classes="raceHeadingText" />
     <Border Grid.Column="1" Classes="stripDivider" />
     <TextBlock Grid.Column="2" Text="{Binding SelectedTimingIdentity}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
     <ToggleButton Grid.Column="3" Name="EditClassificationToggle" Content="Edit classification" Classes="secondaryAction" IsChecked="{Binding ShowTimingClassificationEditor}" />
    </Grid>
   </Border>
   <Border IsVisible="{Binding ShowTimingClassificationEditor}" Classes="racePane" Padding="8">
    <StackPanel Spacing="6">
     <Grid ColumnDefinitions="110,8,100,8,*,8,240">
      <StackPanel><TextBlock Text="STATUS" Classes="eyebrow" /><ComboBox Name="TimingClassificationChoice" ItemsSource="{Binding TimingClassifications}" SelectedItem="{Binding TimingClassification}" /></StackPanel>
      <StackPanel Grid.Column="2" IsEnabled="{Binding IsTimingDsq}"><TextBlock Text="GATE (OPTIONAL)" Classes="eyebrow" /><TextBox Text="{Binding TimingDsqGate}" /></StackPanel>
      <StackPanel Grid.Column="4" IsEnabled="{Binding IsTimingDsq}"><TextBlock Text="DSQ REASON / ICR RULE (OPTIONAL)" Classes="eyebrow" /><TextBox Text="{Binding TimingDsqReason}" /></StackPanel>
      <StackPanel Grid.Column="6" IsEnabled="{Binding IsTimingDsq}"><TextBlock Text="JUDGE (OPTIONAL)" Classes="eyebrow" /><TextBox Text="{Binding TimingDsqJudge}" /></StackPanel>
     </Grid>
     <Grid ColumnDefinitions="180,8,*,8,Auto">
      <StackPanel><TextBlock Text="OPERATOR" Classes="eyebrow" /><TextBox Text="{Binding TimingOperator}" /></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="CORRECTION NOTE (OPTIONAL)" Classes="eyebrow" /><TextBox Text="{Binding TimingReason}" Watermark="Default classification note is recorded when empty" /></StackPanel>
      <Button Grid.Column="4" Name="SaveTimingClassification" Content="Save classification" Classes="primaryAction" Command="{Binding SaveTimingClassificationCommand}" VerticalAlignment="Bottom" />
     </Grid>
    </StackPanel>
   </Border>
   <Border Name="ManualTimestampEditor" IsVisible="{Binding ShowManualTimestampEditor}" Classes="racePane" Padding="8">
    <Border.KeyBindings><KeyBinding Gesture="Enter" Command="{Binding SaveManualTimestampCommand}" /><KeyBinding Gesture="Escape" Command="{Binding CancelManualTimestampCommand}" /></Border.KeyBindings>
    <StackPanel Spacing="4">
     <Grid ColumnDefinitions="90,8,170,8,*,8,Auto,6,Auto">
      <StackPanel><TextBlock Text="MANUAL TIME" Classes="eyebrow" /><TextBlock Name="ManualTimestampPositionText" Text="{Binding ManualTimestampPosition}" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="TIME OF DAY HH:MM:SS.FF" Classes="eyebrow" /><TextBox Name="ManualTimestampTime" Text="{Binding ManualTimestampText}" FontFamily="{DynamicResource TimeFontFamily}" /></StackPanel>
      <StackPanel Grid.Column="4"><TextBlock Text="REASON" Classes="eyebrow" /><TextBox Name="ManualTimestampReasonText" Text="{Binding ManualTimestampReason}" /></StackPanel>
      <Button Grid.Column="6" Name="SaveManualTimestamp" Content="Add timestamp" Classes="primaryAction" Command="{Binding SaveManualTimestampCommand}" VerticalAlignment="Bottom" ToolTip.Tip="Enter · saved with operator, reason and time in the correction history" />
      <Button Grid.Column="8" Content="Cancel" Command="{Binding CancelManualTimestampCommand}" Classes="secondaryAction" VerticalAlignment="Bottom" ToolTip.Tip="Esc" />
     </Grid>
     <TextBlock Text="{Binding ManualTimestampError}" IsVisible="{Binding HasManualTimestampError}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
    </StackPanel>
   </Border>
   <TextBlock Text="{Binding SelectedTimingProblem}" IsVisible="{Binding HasSelectedTimingProblem}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
   <TextBlock Text="Unassigned finish · drag a competitor onto its finish timestamp." IsVisible="{Binding HasUnassignedFinish}" Foreground="{DynamicResource WarningBrush}" />
  </StackPanel>
  <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="6" Margin="0,4,0,0" IsVisible="{Binding ShowTimingSimulatorControls}">
   <TextBlock Text="TRAINING" Classes="eyebrow" VerticalAlignment="Center" /><TextBox Name="SimulationTimeBox" Text="{Binding SimulationTime}" Width="155" ToolTip.Tip="Simulator device time. While live, impulses use the PC clock at the press; type a time to pause and use it." />
   <Button Name="SimulationClockToggle" Content="{Binding SimulationClockToggleText}" Command="{Binding ToggleSimulationClockCommand}" Classes="secondaryAction" ToolTip.Tip="Pause the PC clock to type a simulator time, or follow the PC clock live again." />
   <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsTimingSimulator}">
    <Button Content="Test start" Command="{Binding SimulatePulseCommand}" CommandParameter="start" IsEnabled="{Binding IsTimingConnected}" Classes="secondaryAction" />
    <StackPanel Name="SimulatorIntermediateButtons" Orientation="Horizontal" Spacing="6" />
    <Button Content="Test finish" Command="{Binding SimulatePulseCommand}" CommandParameter="finish" IsEnabled="{Binding IsTimingConnected}" Classes="secondaryAction" />
   </StackPanel>
   <StackPanel Name="SimulatorBackupButtons" Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsBackupTimingSimulator}">
    <Button Content="Test B start" Command="{Binding SimulateBackupPulseCommand}" CommandParameter="start" IsEnabled="{Binding IsBackupClockActive}" Classes="secondaryAction" ToolTip.Tip="B Clock training impulse. B never changes A timing." />
    <Button Content="Test B finish" Command="{Binding SimulateBackupPulseCommand}" CommandParameter="finish" IsEnabled="{Binding IsBackupClockActive}" Classes="secondaryAction" ToolTip.Tip="B Clock training impulse. B never changes A timing." />
   </StackPanel>
  </StackPanel>
  <!-- Drag preview overlay: never hit-testable, so it cannot steal or block a drop target. -->
  <Canvas Name="TimingDropPreviewLayer" Grid.RowSpan="5" IsHitTestVisible="False">
   <Border Name="TimingDropPreview" Classes="timingDropPreview" IsVisible="False">
    <StackPanel Spacing="1">
     <TextBlock Name="TimingDropPreviewBib" FontWeight="SemiBold" />
     <TextBlock Name="TimingDropPreviewResult" Classes="timingDropPreviewResult" />
    </StackPanel>
   </Border>
  </Canvas>
 </Grid>
</UserControl>
