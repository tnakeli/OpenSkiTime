<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:OpenSkiTime.Desktop"
 x:Class="OpenSkiTime.Desktop.TimingSettingsView" x:CompileBindings="False">
 <UserControl.Resources>
  <!-- One timing role: Role -> Source -> Channel -> source-specific connection details. -->
  <DataTemplate x:Key="TimingRoleRowTemplate">
   <Grid ColumnDefinitions="120,8,180,8,110,8,*,8,Auto" Margin="0,0,0,6">
    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
    <ComboBox Grid.Column="2" VerticalAlignment="Center" ItemsSource="{Binding Sources}" SelectedItem="{Binding Source}" IsVisible="{Binding ShowOwnConnection}" HorizontalAlignment="Stretch" ToolTip.Tip="Timing source for this role" />
    <TextBlock Grid.Column="2" Text="{Binding LeaderSourceLabel}" IsVisible="{Binding ShowsLeaderConnection}" Classes="supportingText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    <NumericUpDown Grid.Column="4" VerticalAlignment="Center" Value="{Binding Channel}" Minimum="0" Maximum="8" FormatString="0" ToolTip.Tip="Device channel C0–C8 for this role" />
    <WrapPanel Grid.Column="6" VerticalAlignment="Center">
     <CheckBox Content="{Binding SameConnectionLabel}" IsChecked="{Binding UsesLeaderConnection}" IsVisible="{Binding HasLeader}" Margin="0,0,10,0" ToolTip.Tip="Use the same device connection. Only the channel (and ALGE Results device ID) differs." />
     <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsTimyUsb}">
      <TextBox Text="{Binding UsbId}" Width="140" PlaceholderText="USB ID (optional)" ToolTip.Tip="Leave blank to use the first connected Timy. Other devices are not merged." />
      <TextBox Text="{Binding Firmware}" Width="110" PlaceholderText="Firmware" />
      <Button Content="Set up USB library" Command="{Binding $parent[UserControl].DataContext.SetupTimyUsbCommand}" Classes="secondaryAction" />
     </StackPanel>
     <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsSerial}">
      <AutoCompleteBox ItemsSource="{Binding $parent[UserControl].DataContext.TimingPorts}" Text="{Binding Port}" PlaceholderText="COM port" MinimumPrefixLength="0" FilterMode="StartsWith" Width="110" ToolTip.Tip="MT1 / Timy virtual COM port. Refresh ports lists connected devices." />
      <Button Content="Refresh ports" Command="{Binding $parent[UserControl].DataContext.RefreshTimingPortsCommand}" Classes="secondaryAction" />
      <NumericUpDown Value="{Binding BaudRate}" Minimum="1200" Maximum="115200" FormatString="0" Width="135" ToolTip.Tip="Serial baud rate. Timy PC Timer defaults to 38400; check the connected device." />
     </StackPanel>
     <TextBox Text="{Binding AlgeUsername}" IsVisible="{Binding IsOwnAlgeResults}" Width="220" PlaceholderText="ALGE Results username" ToolTip.Tip="Account that owns this device in ALGE Results (for example the club of an intermediate)" />
     <TextBox Text="{Binding AlgeDeviceId}" IsVisible="{Binding ShowAlgeDeviceText}" Width="150" PlaceholderText="MT1 device ID" ToolTip.Tip="ALGE Results device ID for this role. Fetch the account's devices below to choose from a list." />
     <ComboBox ItemsSource="{Binding AlgeDevices}" SelectedItem="{Binding SelectedAlgeDevice}" IsVisible="{Binding ShowAlgeDeviceList}" Width="220" PlaceholderText="Choose MT1 device" ToolTip.Tip="ALGE Results device for this role" />
     <TextBox Text="{Binding ReplayPath}" IsVisible="{Binding IsReplay}" Width="280" PlaceholderText="Path to raw ALGE ASCII file" />
     <TextBlock Text="Training data only" IsVisible="{Binding IsSimulator}" Classes="supportingText" VerticalAlignment="Center" />
    </WrapPanel>
    <TextBlock Grid.Column="8" Name="RoleSignalText" Text="{Binding SignalText}" VerticalAlignment="Center" FontFamily="{DynamicResource TimeFontFamily}" FontSize="{DynamicResource LabelSize}" Foreground="{DynamicResource AccentBrush}" ToolTip.Tip="Latest signal per channel of this device while timing is connected. ● marks this role's channel." />
   </Grid>
  </DataTemplate>
 </UserControl.Resources>
 <StackPanel Classes="tabPage">
  <!-- Connection: state, connect and disconnect, and the clock context all timing roles share. -->
  <Border Classes="card">
   <StackPanel Spacing="{DynamicResource FormGap}">
    <Grid Classes="cardHeader" ColumnDefinitions="*,Auto">
     <TextBlock Text="Connection" Classes="cardTitle" />
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
      <Button Content="Back to timing" Command="{Binding ReturnToTimingCommand}" IsVisible="{Binding HasTimingRun}" Classes="secondaryAction" />
      <Button Content="Connect" Command="{Binding ConnectTimingCommand}" IsEnabled="{Binding CanConnectTiming}" IsVisible="{Binding !IsTimingConnected}" Classes="primaryAction" />
      <Button Content="Disconnect" Command="{Binding DisconnectTimingCommand}" IsVisible="{Binding IsTimingConnected}" IsEnabled="{Binding !IsTimingBusy}" Classes="secondaryAction" />
     </StackPanel>
    </Grid>
    <TextBlock Text="{Binding TimingConnection}" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="*,8,Auto,8,Auto" IsVisible="{Binding CanRetryBackupClock}">
     <TextBlock Name="SettingsBackupClockStatusText" Text="{Binding BackupClockStatusText}" VerticalAlignment="Center" TextWrapping="Wrap" />
     <Button Grid.Column="2" Content="Retry B Clock" Command="{Binding RetryBackupClockCommand}" Classes="secondaryAction" ToolTip.Tip="Reconnect B Clock (or retry its storage). A timing is not interrupted." />
     <Button Grid.Column="4" Content="Disconnect B Clock" Command="{Binding DisconnectBackupClockCommand}" IsVisible="{Binding IsBackupClockActive}" Classes="secondaryAction" />
    </Grid>
    <TextBlock IsVisible="{Binding IsTimingConnected}" Text="Connected. Capture continues when you leave Settings or change views. Disconnect to change timing settings." Classes="supportingText attention" TextWrapping="Wrap" />
    <Border IsVisible="{Binding HasTimingMigrationNotes}" Classes="warningNote">
     <StackPanel Spacing="4">
      <TextBlock Text="FORMER TIMING SETTINGS MIGRATED · REVIEW AND SAVE" Classes="fieldLabel" />
      <TextBlock Name="TimingMigrationNotesText" Text="{Binding TimingMigrationNotes}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
     </StackPanel>
    </Border>
    <local:FormRow IsEnabled="{Binding CanChangeTimingDevice}">
     <StackPanel Grid.Column="0" Grid.ColumnSpan="2" Classes="field"><TextBlock Text="DEVICE DATE" Classes="fieldLabel" /><TextBox Text="{Binding TimingDeviceDate}" PlaceholderText="YYYY-MM-DD" /></StackPanel>
     <StackPanel Grid.Column="2" Grid.ColumnSpan="4" Classes="field"><TextBlock Text="OPERATOR" Classes="fieldLabel" /><TextBox Text="{Binding TimingOperator}" /></StackPanel>
    </local:FormRow>
   </StackPanel>
  </Border>

  <StackPanel Classes="tabPage" IsEnabled="{Binding CanChangeTimingDevice}">
   <Border Classes="card">
    <StackPanel Spacing="{DynamicResource FormGap}">
     <Grid Classes="cardHeader" ColumnDefinitions="*,Auto">
      <TextBlock Text="Primary timing" Classes="cardTitle" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
       <Button Content="Add intermediate" Command="{Binding AddTimingIntermediateCommand}" Classes="secondaryAction" />
       <Button Content="Remove last intermediate" Command="{Binding RemoveTimingIntermediateCommand}" IsEnabled="{Binding HasTimingIntermediateRoles}" Classes="secondaryAction" />
      </StackPanel>
     </Grid>
     <TextBlock Text="{Binding TimingDeviceHelp}" Classes="supportingText" TextWrapping="Wrap" />
     <StackPanel Spacing="4">
      <Grid ColumnDefinitions="120,8,180,8,110,8,*">
       <TextBlock Text="ROLE" Classes="fieldLabel" /><TextBlock Grid.Column="2" Text="SOURCE" Classes="fieldLabel" />
       <TextBlock Grid.Column="4" Text="CHANNEL" Classes="fieldLabel" /><TextBlock Grid.Column="6" Text="CONNECTION" Classes="fieldLabel" />
      </Grid>
      <ItemsControl Name="PrimaryTimingRolesList" ItemsSource="{Binding PrimaryTimingRoles}" ItemTemplate="{StaticResource TimingRoleRowTemplate}" />
     </StackPanel>
     <TextBlock Text="Any device can serve any role. Roles on one device use different channels; different devices, source types and ALGE Results accounts may be combined. All device clocks are set to the same time. A race uses as many intermediates as its competition defines." Classes="supportingText" TextWrapping="Wrap" />
    </StackPanel>
   </Border>

   <Border Classes="card" IsVisible="{Binding UsesAlgeResultsAccount}">
    <StackPanel Spacing="{DynamicResource FormGap}">
     <Grid Classes="cardHeader"><TextBlock Text="ALGE Results accounts" Classes="cardTitle" /></Grid>
     <ItemsControl Name="AlgeAccountsList" ItemsSource="{Binding AlgeAccounts}">
      <ItemsControl.ItemTemplate>
       <DataTemplate>
        <Grid ColumnDefinitions="2*,8,2*,8,Auto,8,Auto,8,2*" Margin="0,0,0,6">
         <TextBlock Text="{Binding Username}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
         <TextBox Grid.Column="2" Text="{Binding Password}" PasswordChar="•" PlaceholderText="{Binding PasswordWatermark}" />
         <CheckBox Grid.Column="4" Content="Remember password" IsChecked="{Binding RememberPassword}" />
         <Button Grid.Column="6" Content="Fetch devices" Command="{Binding DataContext.FetchAlgeDevicesCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" IsEnabled="{Binding !IsFetching}" Classes="secondaryAction" />
         <TextBlock Grid.Column="8" Text="{Binding Status}" VerticalAlignment="Center" TextWrapping="Wrap" Classes="supportingText" />
        </Grid>
       </DataTemplate>
      </ItemsControl.ItemTemplate>
     </ItemsControl>
    </StackPanel>
   </Border>

   <Border Classes="card">
    <StackPanel Spacing="{DynamicResource FormGap}">
     <Grid Classes="cardHeader" ColumnDefinitions="Auto,8,Auto,*,Auto">
      <TextBlock Text="B Clock" Classes="cardTitle" />
      <Border Grid.Column="2" Classes="chip"><TextBlock Text="OPTIONAL" /></Border>
      <Button Grid.Column="4" Content="Add B Clock" Command="{Binding AddBackupClockCommand}" IsVisible="{Binding HasNoBackupClockRoles}" Classes="secondaryAction" />
      <Button Grid.Column="4" Content="Clear B Clock" Command="{Binding ClearBackupClockCommand}" IsVisible="{Binding HasBackupClockRoles}" Classes="dangerAction" />
     </Grid>
     <TextBlock Text="An independent B Clock connects automatically right after primary timing and follows the active run. B never changes race times; it supports the timing report and warns when A and B disagree." Classes="supportingText" TextWrapping="Wrap" />
     <StackPanel Spacing="{DynamicResource FormGap}" IsVisible="{Binding HasBackupClockRoles}">
      <StackPanel Spacing="4">
       <Grid ColumnDefinitions="120,8,180,8,110,8,*">
        <TextBlock Text="ROLE" Classes="fieldLabel" /><TextBlock Grid.Column="2" Text="SOURCE" Classes="fieldLabel" />
        <TextBlock Grid.Column="4" Text="CHANNEL" Classes="fieldLabel" /><TextBlock Grid.Column="6" Text="CONNECTION" Classes="fieldLabel" />
       </Grid>
       <ItemsControl Name="BackupTimingRolesList" ItemsSource="{Binding BackupTimingRoles}" ItemTemplate="{StaticResource TimingRoleRowTemplate}" />
      </StackPanel>
      <TextBlock Text="B Clock Start and B Clock Finish may use the same or different devices. Use devices separate from primary timing (own USB ID, COM port or ALGE Results device ID)." Classes="supportingText" TextWrapping="Wrap" />
      <local:FormRow>
       <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Classes="field"><TextBlock Text="START WARNING (MS)" Classes="fieldLabel" /><NumericUpDown Value="{Binding BackupStartWarningMilliseconds}" Minimum="1" Maximum="10000" FormatString="0" /></StackPanel>
       <StackPanel Grid.Column="3" Grid.ColumnSpan="3" Classes="field"><TextBlock Text="FINISH WARNING (MS)" Classes="fieldLabel" /><NumericUpDown Value="{Binding BackupFinishWarningMilliseconds}" Minimum="1" Maximum="10000" FormatString="0" /></StackPanel>
       <StackPanel Grid.Column="6" Grid.ColumnSpan="3" Classes="field"><TextBlock Text="MISSING SIGNAL WAIT (S)" Classes="fieldLabel" /><NumericUpDown Value="{Binding BackupMissingGraceSeconds}" Minimum="1" Maximum="300" FormatString="0" /></StackPanel>
      </local:FormRow>
     </StackPanel>
    </StackPanel>
   </Border>

   <Border Classes="card" Padding="12,10">
    <Grid ColumnDefinitions="*,Auto">
     <Button Grid.Column="1" Content="Save timing settings" Command="{Binding SaveTimingPreferencesCommand}" Classes="primaryAction" />
    </Grid>
   </Border>
  </StackPanel>
 </StackPanel>
</UserControl>
