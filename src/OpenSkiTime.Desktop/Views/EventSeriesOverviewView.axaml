<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenSkiTime.Desktop.ViewModels"
             xmlns:views="clr-namespace:OpenSkiTime.Desktop.Views"
             xmlns:dom="clr-namespace:OpenSkiTime.Domain.Competitions;assembly=OpenSkiTime.Domain"
             x:Class="OpenSkiTime.Desktop.Views.EventSeriesOverviewView"
             x:DataType="vm:EventSeriesOverviewViewModel">

  <Grid ColumnDefinitions="280,*">

    <!-- Series list (left) -->
    <Border Grid.Column="0" Background="#f3f4f6" Padding="12">
      <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
          <TextBlock Text="Event Series"
                     FontSize="16" FontWeight="SemiBold" />
          <Button Content="+ New Event Series"
                  HorizontalAlignment="Stretch"
                  Command="{Binding NewSeriesCommand}" />
        </StackPanel>
        <ListBox ItemsSource="{Binding SeriesList}"
                 SelectionChanged="OnSeriesSelectionChanged">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <StackPanel Margin="4">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock FontSize="11" Foreground="#6b7280">
                  <Run Text="{Binding StartDate}" />
                  <Run Text=" – " />
                  <Run Text="{Binding EndDate}" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Detail (right) -->
    <ScrollViewer Grid.Column="1" Padding="24">
      <StackPanel Spacing="16" MaxWidth="800">

        <TextBlock FontSize="22" FontWeight="SemiBold">
          <TextBlock.Text>
            <MultiBinding StringFormat="{}{0}">
              <Binding Path="Name" />
            </MultiBinding>
          </TextBlock.Text>
        </TextBlock>

        <Border Background="White" Padding="16" CornerRadius="6"
                BorderBrush="#e5e7eb" BorderThickness="1">
          <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
            <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding Name}" />

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Location" VerticalAlignment="Center" />
            <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding Location}" />

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Organizer" VerticalAlignment="Center" />
            <TextBox  Grid.Row="2" Grid.Column="1" Text="{Binding Organizer}" />

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Start date" VerticalAlignment="Center" />
            <DatePicker Grid.Row="3" Grid.Column="1"
                        SelectedDate="{Binding StartDate, Converter={StaticResource DateOnlyToDateTimeOffsetConverter}}" />

            <TextBlock Grid.Row="4" Grid.Column="0" Text="End date" VerticalAlignment="Center" />
            <DatePicker Grid.Row="4" Grid.Column="1"
                        SelectedDate="{Binding EndDate, Converter={StaticResource DateOnlyToDateTimeOffsetConverter}}" />

            <TextBlock Grid.Row="5" Grid.Column="0" Text="Nation (3-letter)" VerticalAlignment="Center" />
            <TextBox  Grid.Row="5" Grid.Column="1" Text="{Binding Nation}" MaxLength="3" />

            <TextBlock Grid.Row="6" Grid.Column="0" Text="Season" VerticalAlignment="Center" />
            <TextBox  Grid.Row="6" Grid.Column="1" Text="{Binding Season}" Watermark="e.g. 2025/26" />
          </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Save Event Series"
                  Classes="accent"
                  Command="{Binding SaveSeriesCommand}" />
          <Button Content="Delete Event Series"
                  Command="{Binding DeleteSeriesCommand}" />
          <TextBlock Text="{Binding StatusMessage}"
                     VerticalAlignment="Center"
                     Foreground="#6b7280"
                     Margin="12,0,0,0" />
        </StackPanel>

        <!-- Validation summary -->
        <Border IsVisible="{Binding ValidationSummaryText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                Background="#fef3c7" Padding="10,6" CornerRadius="4"
                BorderBrush="#fbbf24" BorderThickness="1">
          <TextBlock Text="{Binding ValidationSummaryText}"
                     Foreground="#92400e"
                     TextWrapping="Wrap" />
        </Border>

        <!-- Competitions + Competitors tabs -->
        <TabControl>
          <TabItem Header="Competitions">
            <Border Background="White" Padding="16" CornerRadius="6"
                    BorderBrush="#e5e7eb" BorderThickness="1">
              <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,0,12">
                  <TextBlock Text="Competitions"
                             FontSize="16" FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <Button Content="+ New Competition"
                          Command="{Binding NewCompetitionCommand}"
                          Margin="16,0,0,0" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Competitions}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          GridLinesVisibility="Horizontal"
                          MinHeight="200">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Date"       Binding="{Binding Date}"         Width="110" />
                    <DataGridTextColumn Header="Label"      Binding="{Binding ShortLabel}"   Width="100" />
                    <DataGridTextColumn Header="Name"       Binding="{Binding Name}"         Width="*" />
                    <DataGridTextColumn Header="Discipline" Binding="{Binding Discipline}"   Width="110" />
                    <DataGridTextColumn Header="Type"       Binding="{Binding RaceType}"     Width="110" />
                    <DataGridTextColumn Header="Runs"       Binding="{Binding NumberOfRuns}" Width="60" />
                    <DataGridTextColumn Header="FIS code"   Binding="{Binding FisCode}"      Width="100" />
                    <DataGridTemplateColumn Header="" Width="200">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="dom:Competition">
                          <StackPanel Orientation="Horizontal" Spacing="4">
                            <Button Content="Edit"
                                    Command="{Binding $parent[DataGrid].((vm:EventSeriesOverviewViewModel)DataContext).EditCompetitionCommand}"
                                    CommandParameter="{Binding}" />
                            <Button Content="Remove"
                                    Command="{Binding $parent[DataGrid].((vm:EventSeriesOverviewViewModel)DataContext).RemoveCompetitionCommand}"
                                    CommandParameter="{Binding}" />
                          </StackPanel>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                  </DataGrid.Columns>
                </DataGrid>
              </DockPanel>
            </Border>
          </TabItem>

          <TabItem Header="Competitors">
            <views:CompetitorGridView DataContext="{Binding Competitors}" />
          </TabItem>
        </TabControl>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
