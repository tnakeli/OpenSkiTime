<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenSkiTime.Desktop.ViewModels"
             x:Class="OpenSkiTime.Desktop.Views.CompetitionEditorView"
             x:DataType="vm:CompetitionEditorViewModel">

  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="800">

      <TextBlock Text="{Binding Title}"
                 FontSize="22" FontWeight="SemiBold" />

      <Border Background="White" Padding="16" CornerRadius="6"
              BorderBrush="#e5e7eb" BorderThickness="1">
        <Grid ColumnDefinitions="200,*">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" />
          <TextBox  Grid.Row="0" Grid.Column="1" Text="{Binding Name}" />

          <TextBlock Grid.Row="1" Grid.Column="0" Text="Short label" VerticalAlignment="Center"
                     ToolTip.Tip="Used as participation column header in the competitor grid (e.g. '3.1 SL')." />
          <TextBox  Grid.Row="1" Grid.Column="1" Text="{Binding ShortLabel}"
                    Watermark="e.g. 3.1 SL" MaxLength="20" />

          <TextBlock Grid.Row="2" Grid.Column="0" Text="Date" VerticalAlignment="Center" />
          <DatePicker Grid.Row="2" Grid.Column="1"
                      SelectedDate="{Binding Date, Converter={StaticResource DateOnlyToDateTimeOffsetConverter}}" />

          <TextBlock Grid.Row="3" Grid.Column="0" Text="Discipline" VerticalAlignment="Center" />
          <ComboBox Grid.Row="3" Grid.Column="1"
                    ItemsSource="{Binding Disciplines}"
                    SelectedItem="{Binding Discipline}" />

          <TextBlock Grid.Row="4" Grid.Column="0" Text="Race type" VerticalAlignment="Center" />
          <ComboBox Grid.Row="4" Grid.Column="1"
                    ItemsSource="{Binding RaceTypes}"
                    SelectedItem="{Binding RaceType}" />

          <TextBlock Grid.Row="5" Grid.Column="0" Text="Number of runs" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="5" Grid.Column="1"
                         Minimum="1" Maximum="9"
                         FormatString="0"
                         Value="{Binding NumberOfRuns}" />

          <TextBlock Grid.Row="6" Grid.Column="0" Text="Intermediate times per run" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="6" Grid.Column="1"
                         Minimum="0" Maximum="20"
                         FormatString="0"
                         Value="{Binding NumberOfIntermediateTimes}" />

          <TextBlock Grid.Row="7" Grid.Column="0" Text="FIS code" VerticalAlignment="Center"
                     ToolTip.Tip="Required when race type is FIS." />
          <TextBox  Grid.Row="7" Grid.Column="1" Text="{Binding FisCode}" MaxLength="50" />

          <TextBlock Grid.Row="8" Grid.Column="0" Text="Local race code" VerticalAlignment="Center" />
          <TextBox  Grid.Row="8" Grid.Column="1" Text="{Binding LocalRaceCode}" MaxLength="50" />

          <TextBlock Grid.Row="9" Grid.Column="0" Text="Gender / category" VerticalAlignment="Center" />
          <ComboBox Grid.Row="9" Grid.Column="1"
                    ItemsSource="{Binding Genders}"
                    SelectedItem="{Binding Gender}" />

          <TextBlock Grid.Row="10" Grid.Column="0" Text="Course / hill name" VerticalAlignment="Center" />
          <TextBox  Grid.Row="10" Grid.Column="1" Text="{Binding CourseName}" />

          <TextBlock Grid.Row="11" Grid.Column="0" Text="Start altitude (m)" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="11" Grid.Column="1"
                         Minimum="0" Maximum="9000"
                         FormatString="0"
                         Value="{Binding StartAltitudeMeters}" />

          <TextBlock Grid.Row="12" Grid.Column="0" Text="Finish altitude (m)" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="12" Grid.Column="1"
                         Minimum="0" Maximum="9000"
                         FormatString="0"
                         Value="{Binding FinishAltitudeMeters}" />

          <TextBlock Grid.Row="13" Grid.Column="0" Text="Vertical drop (m)" VerticalAlignment="Center" />
          <NumericUpDown Grid.Row="13" Grid.Column="1"
                         Minimum="0" Maximum="3000"
                         FormatString="0"
                         Value="{Binding VerticalDropMeters}" />
        </Grid>
      </Border>

      <Border Background="White" Padding="16" CornerRadius="6"
              BorderBrush="#e5e7eb" BorderThickness="1">
        <Grid ColumnDefinitions="200,*">
          <TextBlock Grid.Column="0" Text="Homologation number" VerticalAlignment="Center" />
          <TextBox Grid.Column="1" Text="{Binding HomologationNumber}" MaxLength="50" />
        </Grid>
      </Border>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="Save"
                Classes="accent"
                Command="{Binding SaveCommand}" />
        <Button Content="Cancel"
                Command="{Binding CancelCommand}" />
        <Button Content="Update from FIS API"
                ToolTip.Tip="Coming in a later release. Performs no network requests in this release."
                Command="{Binding UpdateFromFisCommand}"
                Margin="24,0,0,0" />
      </StackPanel>

      <TextBlock Text="{Binding StatusMessage}"
                 Foreground="#6b7280" />

    </StackPanel>
  </ScrollViewer>
</UserControl>
