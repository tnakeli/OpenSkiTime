<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenSkiTime.Desktop.ViewModels"
             xmlns:app="clr-namespace:OpenSkiTime.Application.Abstractions;assembly=OpenSkiTime.Application"
             x:Class="OpenSkiTime.Desktop.Views.ImportView"
             x:DataType="vm:ImportViewModel">

  <Grid RowDefinitions="Auto,*" Margin="24">

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,16">
      <TextBlock Text="Import Competitors"
                 FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="Paste a tab-separated list (from Excel / FIS results) and preview changes before applying."
                 Foreground="#6b7280" FontSize="13" TextWrapping="Wrap" />
    </StackPanel>

    <!-- Body -->
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="16">

        <!-- Series selection -->
        <StackPanel Spacing="6">
          <TextBlock Text="Event Series" FontWeight="SemiBold" />
          <ComboBox ItemsSource="{Binding SeriesList}"
                    SelectedItem="{Binding SelectedSeries}"
                    HorizontalAlignment="Stretch"
                    MaxWidth="480">
            <ComboBox.ItemTemplate>
              <DataTemplate DataType="app:EventSeriesSummary">
                <TextBlock Text="{Binding Name}" />
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
        </StackPanel>

        <!-- Paste area -->
        <StackPanel Spacing="6">
          <TextBlock Text="Paste TSV data (columns: LastName, FirstName, YOB, Nat, FIS Code, Club, Bib, competition short labels…)"
                     FontWeight="SemiBold" />
          <TextBox AcceptsReturn="True"
                   Text="{Binding PasteText}"
                   MinHeight="140"
                   MaxHeight="220"
                   FontFamily="Consolas,Courier New,monospace"
                   FontSize="12"
                   Watermark="Paste tab-separated rows here…"
                   ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </StackPanel>

        <!-- Action buttons -->
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Preview"
                  Command="{Binding PreviewCommand}"
                  IsEnabled="{Binding !IsBusy}" />
          <Button Content="Apply"
                  Command="{Binding ApplyCommand}"
                  IsEnabled="{Binding !IsBusy}"
                  Background="#2563eb" Foreground="White" />
          <Button Content="← Back"
                  Command="{Binding CancelCommand}" />
          <TextBlock Text="{Binding StatusMessage}"
                     VerticalAlignment="Center"
                     Foreground="#374151"
                     FontSize="12"
                     Margin="8,0,0,0" />
        </StackPanel>

        <!-- Progress indicator -->
        <ProgressBar IsIndeterminate="True"
                     IsVisible="{Binding IsBusy}"
                     Height="3" />

        <!-- ── New competitors ─────────────────────────────────────── -->
        <StackPanel Spacing="6"
                    IsVisible="{Binding NewCompetitors.Count, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="New competitors to add"
                     FontWeight="SemiBold" FontSize="14" />
          <DataGrid ItemsSource="{Binding NewCompetitors}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    MaxHeight="280">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Last Name"    Binding="{Binding LastName}"  Width="120" />
              <DataGridTextColumn Header="First Name"   Binding="{Binding FirstName}" Width="100" />
              <DataGridTextColumn Header="YOB"          Binding="{Binding YearOfBirth}" Width="60" />
              <DataGridTextColumn Header="Nation"       Binding="{Binding Nation}"    Width="60" />
              <DataGridTextColumn Header="FIS Code"     Binding="{Binding FisCode}"   Width="90" />
              <DataGridTextColumn Header="Club"         Binding="{Binding Club}"      Width="130" />
              <DataGridTextColumn Header="Bib"          Binding="{Binding Bib}"       Width="50" />
              <DataGridTextColumn Header="Participating In" Binding="{Binding ParticipatingIn}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>

        <!-- ── Bib assignments ────────────────────────────────────── -->
        <StackPanel Spacing="6"
                    IsVisible="{Binding BibAssignments.Count, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="Bib assignments"
                     FontWeight="SemiBold" FontSize="14" />
          <DataGrid ItemsSource="{Binding BibAssignments}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserReorderColumns="False"
                    MaxHeight="200">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Last Name"  Binding="{Binding LastName}"  Width="140" />
              <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}" Width="120" />
              <DataGridTextColumn Header="Old Bib"    Binding="{Binding OldBib}"    Width="80" />
              <DataGridTextColumn Header="New Bib"    Binding="{Binding NewBib}"    Width="80" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>

        <!-- ── Participation changes ──────────────────────────────── -->
        <StackPanel Spacing="6"
                    IsVisible="{Binding Participations.Count, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="Participation changes"
                     FontWeight="SemiBold" FontSize="14" />
          <DataGrid ItemsSource="{Binding Participations}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserReorderColumns="False"
                    MaxHeight="200">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Last Name"   Binding="{Binding LastName}"     Width="140" />
              <DataGridTextColumn Header="First Name"  Binding="{Binding FirstName}"    Width="120" />
              <DataGridTextColumn Header="Competition" Binding="{Binding Competition}"  Width="120" />
              <DataGridCheckBoxColumn Header="Participating" Binding="{Binding IsParticipating}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>

        <!-- ── Warnings ───────────────────────────────────────────── -->
        <StackPanel Spacing="6"
                    IsVisible="{Binding Warnings.Count, Converter={x:Static ObjectConverters.IsNotNull}}">
          <TextBlock Text="Warnings (rows skipped)"
                     FontWeight="SemiBold" FontSize="14"
                     Foreground="#b45309" />
          <DataGrid ItemsSource="{Binding Warnings}"
                    AutoGenerateColumns="False"
                    IsReadOnly="True"
                    CanUserReorderColumns="False"
                    MaxHeight="160">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Row" Binding="{Binding RowIndex}" Width="50" />
              <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
