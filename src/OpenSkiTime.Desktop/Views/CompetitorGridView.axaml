<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OpenSkiTime.Desktop.ViewModels"
             xmlns:models="clr-namespace:OpenSkiTime.Desktop.Models"
             xmlns:conv="clr-namespace:OpenSkiTime.Desktop.Converters"
             x:Class="OpenSkiTime.Desktop.Views.CompetitorGridView"
             x:DataType="vm:CompetitorGridViewModel">

  <UserControl.Resources>
    <conv:RowStateToBackgroundConverter x:Key="RowStateBg" />
  </UserControl.Resources>

  <DockPanel>

    <!-- Toolbar -->
    <Border DockPanel.Dock="Top"
            Background="#f3f4f6"
            Padding="12,8"
            BorderBrush="#e5e7eb" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="+ Add"
                Command="{Binding AddCompetitorCommand}"
                Padding="10,4" />
        <Button Content="💾 Save"
                Classes="accent"
                Command="{Binding SaveCommand}"
                Padding="10,4"
                ToolTip.Tip="Save changes (Ctrl+S)" />
        <Button Content="Discard All"
                Command="{Binding DiscardAllCommand}"
                Padding="10,4" />
        <Separator Width="1" Background="#d1d5db" Margin="4,0" />
        <Button Content="📋 Paste from clipboard"
                Command="{Binding PasteCommand}"
                Padding="10,4"
                ToolTip.Tip="Paste TSV data from clipboard (Ctrl+V)" />
        <Button Content="📄 Copy selected"
                Command="{Binding CopySelectedRowsCommand}"
                Padding="10,4"
                ToolTip.Tip="Copy selected rows as TSV (Ctrl+C)" />
        <Button Content="Refresh"
                Command="{Binding RefreshGridCommand}"
                Padding="10,4" />
        <Separator Width="1" Background="#d1d5db" Margin="4,0" />
        <TextBlock Text="Filter:" VerticalAlignment="Center" Foreground="#6b7280" />
        <TextBox Text="{Binding FilterText}"
                 Watermark="Name, club, nation…"
                 Width="200" />
        <TextBlock Text="{Binding StatusMessage}"
                   VerticalAlignment="Center"
                   Foreground="#6b7280"
                   Margin="12,0,0,0" />
      </StackPanel>
    </Border>

    <!-- Paste confirmation bar -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding HasActivePasteSession}"
            Background="#eff6ff"
            Padding="12,8"
            BorderBrush="#93c5fd" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Paste preview — review highlighted rows:"
                   VerticalAlignment="Center" Foreground="#1e40af" />
        <Button Content="Apply import"
                Classes="accent"
                Command="{Binding ApplyImportCommand}"
                Padding="10,4" />
        <Button Content="Discard import"
                Command="{Binding DiscardImportCommand}"
                Padding="10,4" />
      </StackPanel>
    </Border>

    <!-- Paste warning bar -->
    <Border DockPanel.Dock="Top"
            IsVisible="{Binding PasteWarningMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Background="#fef3c7"
            Padding="12,6"
            BorderBrush="#fbbf24" BorderThickness="0,0,0,1">
      <TextBlock Text="{Binding PasteWarningMessage}"
                 Foreground="#92400e" />
    </Border>

    <!-- Change Log panel (bottom) -->
    <Border DockPanel.Dock="Bottom"
            IsVisible="{Binding ChangeLog.Count, Converter={x:Static conv:NonZeroConverter.Instance}}"
            Background="#f9fafb"
            BorderBrush="#e5e7eb" BorderThickness="0,1,0,0"
            MaxHeight="180">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top"
                   Text="Change Log (session only)"
                   FontWeight="SemiBold"
                   FontSize="11"
                   Foreground="#6b7280"
                   Margin="12,6,0,4" />
        <ListBox ItemsSource="{Binding ChangeLog}"
                 MaxHeight="140">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="models:ChangeLogEntry">
              <StackPanel Orientation="Horizontal" Spacing="8" Margin="4,2">
                <TextBlock Text="{Binding DisplayLabel}"
                           VerticalAlignment="Center"
                           FontSize="12" />
                <Button Content="Restore"
                        FontSize="11"
                        Padding="6,2"
                        Command="{Binding $parent[ListBox].((vm:CompetitorGridViewModel)DataContext).RestoreEntryCommand}"
                        CommandParameter="{Binding}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Competitor grid -->
    <DataGrid x:Name="CompetitorDataGrid"
              ItemsSource="{Binding Competitors}"
              SelectionChanged="OnDataGridSelectionChanged"
              AutoGenerateColumns="False"
              IsReadOnly="False"
              GridLinesVisibility="Horizontal"
              CanUserReorderColumns="True"
              CanUserResizeColumns="True"
              SelectionMode="Extended">
      <DataGrid.Styles>
        <Style Selector="DataGridRow" x:DataType="vm:CompetitorRowViewModel">
          <Setter Property="Background"
                  Value="{Binding RowState, Converter={StaticResource RowStateBg}}" />
        </Style>
      </DataGrid.Styles>
      <DataGrid.Columns>
        <DataGridTextColumn Header="FIS Code"   Binding="{Binding FisCode}"      Width="90" />
        <DataGridTextColumn Header="Last Name"  Binding="{Binding LastName}"     Width="150" />
        <DataGridTextColumn Header="First Name" Binding="{Binding FirstName}"    Width="130" />
        <DataGridTextColumn Header="YOB"        Binding="{Binding YearOfBirth}"  Width="55" />
        <DataGridTemplateColumn Header="Gender" Width="100">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CompetitorRowViewModel">
              <TextBlock Text="{Binding Gender}"
                         VerticalAlignment="Center"
                         Margin="8,0" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
          <DataGridTemplateColumn.CellEditingTemplate>
            <DataTemplate x:DataType="vm:CompetitorRowViewModel">
              <AutoCompleteBox Text="{Binding Gender}"
                               MinimumPrefixLength="0"
                               FilterMode="None"
                               ItemsSource="{x:Static vm:CompetitorRowViewModel.GenderOptions}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>
        <DataGridTextColumn Header="Nation"     Binding="{Binding NationCode}"   Width="65" />
        <DataGridTextColumn Header="Club"       Binding="{Binding ClubName}"     Width="160" />
        <DataGridTemplateColumn Header="" Width="70" IsReadOnly="True">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate x:DataType="vm:CompetitorRowViewModel">
              <Button Content="Delete"
                      FontSize="11"
                      Padding="6,2"
                      Command="{Binding $parent[DataGrid].((vm:CompetitorGridViewModel)DataContext).DeleteCompetitorCommand}"
                      CommandParameter="{Binding}" />
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

  </DockPanel>
</UserControl>
