<Project Sdk="Microsoft.NET.Sdk">
  <!-- ALGE supplies a mixed-mode CLR 4 library. Only this isolated byte transport host needs Framework. -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>TimyUsbHost</AssemblyName>
    <OutputType>Exe</OutputType>
    <ApplicationIcon>../../assets/icons/openskitime.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>disable</ImplicitUsings>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" PrivateAssets="all" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
</Project>
