<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OpenSkiTime.LiveTiming.ControlPanel.PanelApp" RequestedThemeVariant="Light">
 <!-- The same Race Signal tokens as the OpenSkiTime desktop application (src/OpenSkiTime.Desktop/App.axaml). -->
 <Application.Resources>
  <SolidColorBrush x:Key="CanvasBrush">#F1F5F9</SolidColorBrush>
  <SolidColorBrush x:Key="SurfaceBrush">#FFFFFF</SolidColorBrush>
  <SolidColorBrush x:Key="NavyBrush">#14234A</SolidColorBrush>
  <SolidColorBrush x:Key="NavyRaisedBrush">#22356A</SolidColorBrush>
  <SolidColorBrush x:Key="OnNavyTextBrush">#FFFFFF</SolidColorBrush>
  <SolidColorBrush x:Key="OnNavyMutedTextBrush">#C3CEE6</SolidColorBrush>
  <SolidColorBrush x:Key="BorderBrush">#CBD5E1</SolidColorBrush>
  <SolidColorBrush x:Key="LineBrush">#E2E8F0</SolidColorBrush>
  <SolidColorBrush x:Key="TextBrush">#111827</SolidColorBrush>
  <SolidColorBrush x:Key="MutedTextBrush">#475569</SolidColorBrush>
  <SolidColorBrush x:Key="DisabledTextBrush">#64748B</SolidColorBrush>
  <SolidColorBrush x:Key="DisabledSurfaceBrush">#F1F5F9</SolidColorBrush>
  <SolidColorBrush x:Key="AccentBrush">#1D4ED8</SolidColorBrush>
  <SolidColorBrush x:Key="AccentHoverBrush">#1E40AF</SolidColorBrush>
  <SolidColorBrush x:Key="AccentTintBrush">#EFF6FF</SolidColorBrush>
  <SolidColorBrush x:Key="ErrorBrush">#B91C1C</SolidColorBrush>
  <SolidColorBrush x:Key="ErrorTintBrush">#FEE2E2</SolidColorBrush>
  <SolidColorBrush x:Key="ErrorBorderBrush">#FCA5A5</SolidColorBrush>
  <SolidColorBrush x:Key="FocusBrush">#1D4ED8</SolidColorBrush>
  <Color x:Key="SystemAccentColor">#1D4ED8</Color>
  <Color x:Key="SystemAccentColorDark1">#1E40AF</Color>
  <Color x:Key="SystemAccentColorDark2">#1E3A8A</Color>
  <Color x:Key="SystemAccentColorDark3">#172554</Color>
  <Color x:Key="SystemAccentColorLight1">#2563EB</Color>
  <Color x:Key="SystemAccentColorLight2">#60A5FA</Color>
  <Color x:Key="SystemAccentColorLight3">#BFDBFE</Color>
 </Application.Resources>
 <Application.Styles>
  <FluentTheme />
  <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource CanvasBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="FontSize" Value="13" /></Style>
  <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" /><Setter Property="Padding" Value="12,10" /></Style>
  <Style Selector="TextBlock.heading"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="StackPanel.field"><Setter Property="Spacing" Value="3" /></Style>
  <Style Selector="StackPanel.field > TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="FontSize" Value="11" /></Style>
  <Style Selector="TextBox, NumericUpDown"><Setter Property="MinHeight" Value="30" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="CornerRadius" Value="3" /><Setter Property="FontSize" Value="13" /></Style>
  <Style Selector="TextBox"><Setter Property="Padding" Value="8,4" /></Style>
  <Style Selector="TextBox:focus"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" /><Setter Property="BorderThickness" Value="2" /></Style>
  <Style Selector="CheckBox"><Setter Property="FontSize" Value="13" /></Style>
  <Style Selector="Button"><Setter Property="MinHeight" Value="30" /><Setter Property="Padding" Value="12,4" /><Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="3" /><Setter Property="FontSize" Value="13" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentTintBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" /></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" /><Setter Property="Foreground" Value="White" /></Style>
  <Style Selector="Button.danger"><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ErrorBorderBrush}" /></Style>
  <Style Selector="Button.danger:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ErrorTintBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}" /><Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" /></Style>
  <Style Selector="Button:focus-visible"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" /><Setter Property="BorderThickness" Value="2" /></Style>
  <Style Selector="Button:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" /><Setter Property="Foreground" Value="{DynamicResource DisabledTextBrush}" /></Style>
 </Application.Styles>
</Application>
