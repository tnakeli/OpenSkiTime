<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="OpenSkiTime.LiveTiming.ControlPanel.PanelWindow"
 Title="OpenSkiTime · Live timing control panel" Icon="avares://OpenSkiTime.LiveTiming.ControlPanel/Assets/live-timing.ico" Width="940" Height="790" MinWidth="760" MinHeight="560" ShowActivated="False">
 <Grid RowDefinitions="Auto,*,Auto">
  <Border Background="{DynamicResource NavyBrush}" Padding="12,8">
   <Grid ColumnDefinitions="*,Auto">
    <StackPanel Spacing="2">
     <TextBlock Text="OPENSKITIME  /  LIVE TIMING" Foreground="{DynamicResource OnNavyMutedTextBrush}" FontSize="10" FontWeight="Bold" LetterSpacing="2" />
     <TextBlock Text="Control panel" Foreground="{DynamicResource OnNavyTextBrush}" FontSize="17" FontWeight="SemiBold" />
     <TextBlock Text="{Binding Competition}" Foreground="{DynamicResource OnNavyMutedTextBrush}" TextTrimming="CharacterEllipsis" />
    </StackPanel>
    <Border Grid.Column="1" Background="{DynamicResource NavyRaisedBrush}" CornerRadius="3" Padding="10,5" VerticalAlignment="Center">
     <TextBlock Text="LIVE OUTPUT" Foreground="{DynamicResource OnNavyTextBrush}" FontSize="11" FontWeight="Bold" />
    </Border>
   </Grid>
  </Border>
  <Grid Grid.Row="1" ColumnDefinitions="*,12,*" Margin="12,8">
   <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="8">
     <TextBlock Text="Publishing channels" Classes="heading" />
     <ItemsControl ItemsSource="{Binding Channels}"><ItemsControl.ItemTemplate><DataTemplate>
      <Border Classes="card" Margin="0,0,0,8">
       <StackPanel Spacing="6">
        <Grid ColumnDefinitions="*,Auto">
         <TextBlock Text="{Binding Label}" FontSize="12" FontWeight="Bold" LetterSpacing="1" />
         <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
          <Border Width="8" Height="8" CornerRadius="4" Background="{Binding IndicatorColor}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
         </StackPanel>
        </Grid>
        <TextBlock Text="{Binding Detail}" Classes="muted" />
        <WrapPanel IsEnabled="{Binding !$parent[Window].DataContext.Busy}">
         <Button Content="Start" Classes="primary" Command="{Binding $parent[Window].DataContext.ControlCommand}" CommandParameter="{Binding Start}" Margin="0,0,6,0" />
         <Button Content="Stop" Command="{Binding $parent[Window].DataContext.ControlCommand}" CommandParameter="{Binding Stop}" Margin="0,0,6,0" />
         <Button Content="Refresh" Command="{Binding $parent[Window].DataContext.ControlCommand}" CommandParameter="{Binding Refresh}" />
        </WrapPanel>
        <StackPanel IsVisible="{Binding HasPublicUrl}" Spacing="6">
         <TextBlock Text="{Binding PublicUrl}" TextWrapping="Wrap" />
         <TextBlock Text="{Binding Expiration}" Classes="muted" FontSize="11" />
         <WrapPanel>
          <Button Content="Copy URL" Command="{Binding $parent[Window].DataContext.CopyUrlCommand}" CommandParameter="{Binding}" Margin="0,0,6,6" />
          <Button Content="Open URL" Command="{Binding $parent[Window].DataContext.OpenUrlCommand}" CommandParameter="{Binding}" Margin="0,0,0,6" />
         </WrapPanel>
         <WrapPanel IsEnabled="{Binding !$parent[Window].DataContext.Busy}">
          <Button Content="Delete session" Classes="danger" Command="{Binding $parent[Window].DataContext.ControlCommand}" CommandParameter="{Binding Delete}" Margin="0,0,6,0" />
          <Button Content="Delete All Data" Classes="danger" Command="{Binding $parent[Window].DataContext.ControlCommand}" CommandParameter="{Binding DeleteAll}" />
         </WrapPanel>
        </StackPanel>
       </StackPanel>
      </Border>
     </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     <TextBlock Text="Stop pauses publishing. Delete removes the public session; the next Start creates a new URL." Classes="muted" FontSize="11" />
     <Border Classes="card" Name="RadioStatusCard">
      <StackPanel Spacing="4">
       <Grid ColumnDefinitions="*,Auto">
        <TextBlock Text="RACE RADIO" FontSize="12" FontWeight="Bold" LetterSpacing="1" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
         <Border Width="8" Height="8" CornerRadius="4" Background="{Binding RadioIndicator}" VerticalAlignment="Center" />
         <TextBlock Name="RadioStatusText" Text="{Binding RadioStatus}" FontWeight="SemiBold" />
        </StackPanel>
       </Grid>
       <TextBlock Name="RadioDetailText" Text="{Binding RadioDetail}" Classes="muted" />
       <TextBlock Text="{Binding RadioMusic}" Classes="muted" FontSize="11" IsVisible="{Binding RadioMusic, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding RadioSpend}" Classes="muted" FontSize="11" />
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
   <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="8">
     <TextBlock Text="Connection settings" Classes="heading" />
     <Border Classes="card"><StackPanel Spacing="8">
      <TextBlock Text="Standalone" Classes="heading" />
      <StackPanel Classes="field"><TextBlock Text="Local URL" /><TextBox Text="{Binding LocalEndpoint}" /></StackPanel>
      <StackPanel Classes="field"><TextBlock Text="Cloud URL" /><TextBox Text="{Binding CloudEndpoint}" /></StackPanel>
     </StackPanel></Border>
     <Border Classes="card"><StackPanel Spacing="8">
      <TextBlock Text="FIS Live Timing" Classes="heading" />
      <CheckBox Content="Use TCP instead of HTTPS" IsChecked="{Binding FisUseTcp}" />
      <StackPanel Classes="field"><TextBlock Text="HTTPS URL" /><TextBox Text="{Binding FisHttpsEndpoint}" /></StackPanel>
      <StackPanel Classes="field"><TextBlock Text="TCP host" /><TextBox Text="{Binding FisTcpHost}" /></StackPanel>
      <StackPanel Classes="field"><TextBlock Text="TCP port" /><NumericUpDown Minimum="1" Maximum="65535" Value="{Binding FisTcpPort}" HorizontalAlignment="Stretch" /></StackPanel>
      <StackPanel Classes="field"><TextBlock Text="Password" /><TextBox PasswordChar="●" Text="{Binding FisPassword}" /></StackPanel>
     </StackPanel></Border>
     <Border Classes="card" Name="RadioSettingsCard"><StackPanel Spacing="8" IsEnabled="{Binding RadioReady}">
      <TextBlock Text="Race radio (optional)" Classes="heading" />
      <TextBlock Text="AI commentary in Finnish for viewers of this competition. Off by default; needs provider keys in OpenSkiTime Settings → Live timing and sends race data to the chosen providers." Classes="muted" FontSize="11" />
      <WrapPanel>
       <CheckBox Name="RadioLocalBox" Content="Local" IsChecked="{Binding RadioLocal}" Margin="0,0,16,0" />
       <CheckBox Name="RadioCloudBox" Content="Cloud" IsChecked="{Binding RadioCloud}" />
      </WrapPanel>
      <StackPanel Classes="field"><TextBlock Text="Budget limit (USD, hard stop)" /><NumericUpDown Value="{Binding RadioBudget}" Minimum="0" Maximum="1000" Increment="1" FormatString="0.00" HorizontalAlignment="Stretch" /></StackPanel>
      <StackPanel Classes="field"><TextBlock Text="Language model" /><ComboBox ItemsSource="{Binding RadioLlmChoices}" SelectedItem="{Binding RadioLlm}" HorizontalAlignment="Stretch" /></StackPanel>
      <CheckBox Content="Style curation pass (second model call)" IsChecked="{Binding RadioCuration}" />
      <StackPanel Classes="field"><TextBlock Text="Speech" /><ComboBox ItemsSource="{Binding RadioTtsChoices}" SelectedItem="{Binding RadioTts}" HorizontalAlignment="Stretch" /></StackPanel>
      <Grid ColumnDefinitions="*,8,*,8,*">
       <StackPanel Classes="field"><TextBlock Text="Azure region" /><TextBox Text="{Binding RadioRegion}" /></StackPanel>
       <StackPanel Grid.Column="2" Classes="field"><TextBlock Text="Voice, Aino" /><TextBox Text="{Binding RadioVoiceA}" Watermark="Default" /></StackPanel>
       <StackPanel Grid.Column="4" Classes="field"><TextBlock Text="Voice, Kalle" /><TextBox Text="{Binding RadioVoiceB}" Watermark="Default" /></StackPanel>
      </Grid>
      <StackPanel Classes="field"><TextBlock Text="Event background for the hosts" /><TextBox Text="{Binding RadioContext}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="54" MaxLength="2000" /></StackPanel>
      <StackPanel Classes="field"><TextBlock Text="Curation notes (habits to avoid)" /><TextBox Text="{Binding RadioNotes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxLength="1000" /></StackPanel>
      <StackPanel Classes="field"><TextBlock Text="Pronunciation (one per line: written = spoken)" /><TextBox Text="{Binding RadioLexicon}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="40" MaxLength="4000" /></StackPanel>
      <StackPanel Classes="field"><TextBlock Text="Background music folder (MP3, optional)" />
       <Grid ColumnDefinitions="*,8,Auto">
        <TextBox Name="RadioMusicFolderBox" Text="{Binding RadioMusicFolder}" Watermark="No music" />
        <Button Grid.Column="2" Name="BrowseMusicButton" Content="Browse…" Click="BrowseMusic" />
       </Grid>
      </StackPanel>
      <TextBlock Text="Played softly under the commentary for viewers who listen. Use music you may stream publicly, such as royalty-free tracks; the files are sent to the live timing server. Up to 24 files, 12 MB each and 48 MB in total." Classes="muted" FontSize="11" TextWrapping="Wrap" />
      <Button Name="SaveRadioButton" Content="Save radio settings" Classes="primary" Command="{Binding SaveRadioCommand}" HorizontalAlignment="Left" />
      <TextBlock Text="{Binding RadioSaveStatus}" Classes="muted" FontSize="11" />
     </StackPanel></Border>
     <Border Classes="card"><StackPanel Spacing="8">
      <TextBlock Text="Race clock" Classes="heading" />
      <StackPanel Classes="field"><TextBlock Text="Time zone" /><TextBox Text="{Binding TimeZone}" Watermark="Windows or IANA time zone ID" /></StackPanel>
      <TextBlock Text="Settings take effect when you press Start. The time zone is also applied when refreshing the race state." Classes="muted" FontSize="11" />
     </StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="12,5">
   <StackPanel Spacing="4">
    <TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource ErrorBrush}" FontWeight="SemiBold" TextWrapping="Wrap" />
    <TextBlock Text="Closing this panel stops live timing. Timing capture continues in OpenSkiTime." Foreground="{DynamicResource MutedTextBrush}" FontSize="12" />
   </StackPanel>
  </Border>
 </Grid>
</Window>
