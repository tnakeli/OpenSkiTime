<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051 (xunit v3): passing TestContext.Current.CancellationToken is optional; existing tests use their own timeouts. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" /><PackageReference Include="xunit.v3.mtp-v2" /><PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <Compile Include="../../src/OpenSkiTime.LiveTiming.Harness/SyntheticRace.cs" Link="SyntheticRace.cs" />
    <ProjectReference Include="../../src/OpenSkiTime.LiveTiming.Client/OpenSkiTime.LiveTiming.Client.csproj" />
    <ProjectReference Include="../../src/OpenSkiTime.LiveTiming.Publishing/OpenSkiTime.LiveTiming.Publishing.csproj" />
    <ProjectReference Include="../../src/OpenSkiTime.LiveTiming.Radio/OpenSkiTime.LiveTiming.Radio.csproj" />
    <ProjectReference Include="../../src/OpenSkiTime.LiveTiming.RadioWorker/OpenSkiTime.LiveTiming.RadioWorker.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../src/OpenSkiTime.LiveTiming.Worker/OpenSkiTime.LiveTiming.Worker.csproj" ReferenceOutputAssembly="false" />
    <!-- Referenced for unit tests of the session store and its gates; process tests still start the built server. -->
    <ProjectReference Include="../../src/OpenSkiTime.LiveTiming.Server/OpenSkiTime.LiveTiming.Server.csproj" />
  </ItemGroup>
</Project>
