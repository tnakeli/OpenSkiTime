<Project>

  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)..\'))" />

  <PropertyGroup>
    <!--
      Test projects intentionally use snake_case method names per xUnit
      convention (CA1707) and mock objects without explicit null guards
      (CA1062). These are not runtime concerns in test code.
    -->
    <NoWarn>$(NoWarn);CA1707;CA1062;CA1812;CA2007;CA1303;CA1816</NoWarn>
  </PropertyGroup>

</Project>
