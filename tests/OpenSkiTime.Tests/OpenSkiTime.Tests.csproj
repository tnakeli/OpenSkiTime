<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <!-- xUnit1051 (xunit v3): passing TestContext.Current.CancellationToken is optional; existing tests use their own timeouts. -->
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/OpenSkiTime.Reporting/OpenSkiTime.Reporting.csproj" />
    <Content Include="Fixtures/timing-receipt.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/timing-receipt-column.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/timing-receipt-noisy.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Fixtures/timing-receipt-clipped.png" CopyToOutputDirectory="PreserveNewest" />
    <Compile Include="../../src/OpenSkiTime.TimyUsbHost/TimySdkEvent.cs" Link="DeviceHost/TimySdkEvent.cs" />
    <Compile Include="../../src/OpenSkiTime.TimyUsbHost/TimyUsbSelection.cs" Link="DeviceHost/TimyUsbSelection.cs" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit.v3.mtp-v2" />
    <PackageReference Include="xunit.runner.visualstudio" PrivateAssets="all" />
    <PackageReference Include="coverlet.collector" PrivateAssets="all" />
    <PackageReference Include="PdfPig" PrivateAssets="all" />
    <ProjectReference Include="../../src/OpenSkiTime.Persistence/OpenSkiTime.Persistence.csproj" />
    <ProjectReference Include="../../src/OpenSkiTime.Devices/OpenSkiTime.Devices.csproj" />
    <ProjectReference Include="../../src/OpenSkiTime.Recognition/OpenSkiTime.Recognition.csproj" />
  </ItemGroup>
</Project>
