<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="using:OpenSkiTime.Rewrite.Desktop" x:Class="OpenSkiTime.Rewrite.Desktop.LiveTimingView" x:CompileBindings="False">
 <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
  <ItemsControl ItemsSource="{Binding LiveChannels}">
   <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
   <ItemsControl.ItemTemplate><DataTemplate>
    <Border ToolTip.Tip="{Binding StatusToolTip}" Background="Transparent" Padding="2,3" AutomationProperties.Name="{Binding Summary}">
     <StackPanel Orientation="Horizontal" Spacing="5">
      <Border Width="7" Height="7" CornerRadius="4" Background="{Binding IndicatorColor}" VerticalAlignment="Center" />
      <TextBlock Text="{Binding Label}" Foreground="{Binding IndicatorColor}" FontSize="10" FontWeight="SemiBold" VerticalAlignment="Center" />
     </StackPanel>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  <Button Name="LiveTimingButton" Classes="toolbarAction" Content="Live timing…" Command="{Binding OpenLiveTimingCommand}" Padding="8,2" MinHeight="24" ToolTip.Tip="Open the Live timing control panel" />
 </StackPanel>
</UserControl>
