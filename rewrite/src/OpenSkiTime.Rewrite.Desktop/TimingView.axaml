<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="OpenSkiTime.Rewrite.Desktop.TimingView" x:CompileBindings="False">
 <UserControl.Resources>
  <x:Double x:Key="DataGridSortIconMinWidth">14</x:Double>
  <ControlTheme x:Key="DataGridCellTextBlockTheme" TargetType="TextBlock"><Setter Property="Margin" Value="6,0" /><Setter Property="VerticalAlignment" Value="Center" /></ControlTheme>
 </UserControl.Resources>
 <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
   <StackPanel Spacing="3"><TextBlock Text="{Binding TimingContext}" Classes="sectionTitle" /><TextBlock Text="{Binding TimingSummary}" Classes="supportingText" /></StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
    <Button Content="Prepare Run 2" Command="{Binding PrepareNextTimedRunCommand}" IsVisible="{Binding CanPrepareNextTimedRun}" Classes="secondaryAction" />
   </StackPanel>
  </Grid>
  <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,8">
   <Border Classes="raceConnection"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding TimingConnection}" TextTrimming="CharacterEllipsis" />
    <TextBlock Grid.Column="1" Text="{Binding TimingStorage}" Margin="12,0,0,0" /></Grid></Border>
   <Border IsVisible="{Binding HasTimingAlarm}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" Padding="8">
    <Grid ColumnDefinitions="*,8,Auto"><TextBlock Text="{Binding TimingAlarm}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" /><Button Grid.Column="2" Content="Retry storage" Command="{Binding RetryTimingStorageCommand}" Classes="dangerAction" /></Grid>
   </Border>
  </StackPanel>
  <Grid Grid.Row="2" ColumnDefinitions="1.05*,8,1*,8,1.15*">
   <Border Classes="racePane"><Grid RowDefinitions="Auto,Auto,*,Auto">
    <TextBlock Text="START LIST" Classes="raceHeading" />
    <Border Grid.Row="1" Classes="raceExpected"><StackPanel Spacing="6">
     <TextBlock Text="NEXT START" Classes="eyebrow" /><TextBlock Text="{Binding NextStartLabel}" Classes="raceIdentity" />
     <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="Absent · DNS" Command="{Binding NextStartDnsCommand}" Classes="secondaryAction" /><Button Content="{Binding StartHoldLabel}" Command="{Binding HoldTimingPositionCommand}" CommandParameter="start" Classes="secondaryAction" /></StackPanel>
    </StackPanel></Border>
    <Border Grid.Row="2"><DataGrid Name="TimingResultsGrid" Classes="raceGrid timingGrid" ItemsSource="{Binding TimingRows}" SelectionChanged="SelectCompetitor" PointerPressed="SelectContextCompetitor"
 AutoGenerateColumns="False" IsReadOnly="True" RowHeight="30" GridLinesVisibility="Horizontal"><DataGrid.ContextMenu><ContextMenu>
 <MenuItem Header="Next at start" InputGesture="F5" Command="{Binding ExpectSelectedCommand}" CommandParameter="start" />
 <MenuItem Header="Next at finish" InputGesture="F6" Command="{Binding ExpectSelectedCommand}" CommandParameter="finish" />
 <MenuItem Header="Next at intermediate" Command="{Binding ExpectSelectedCommand}" CommandParameter="intermediate" IsVisible="{Binding HasTimingIntermediates}" />
 <Separator />
 <MenuItem Header="DNS · did not start" Command="{Binding ClassifyTimingCommand}" CommandParameter="DNS" />
 <MenuItem Header="DNF · did not finish" Command="{Binding ClassifyTimingCommand}" CommandParameter="DNF" />
 <MenuItem Header="DSQ · disqualified" Command="{Binding ClassifyTimingCommand}" CommandParameter="DSQ" />
 <MenuItem Header="NPS · not permitted to start" Command="{Binding ClassifyTimingCommand}" CommandParameter="NPS" />
 <MenuItem Header="Clear classification" Command="{Binding ClassifyTimingCommand}" CommandParameter="Clear" />
 <Separator /><MenuItem Header="Correct finish assignment…" Command="{Binding CorrectCompetitorFinishCommand}" />
 </ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="#" Binding="{Binding Position}" Width="32" /><DataGridTextColumn Header="BIB" Binding="{Binding Bib}" Width="45" /><DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" MinWidth="100" /><DataGridTextColumn Header="STATE" Binding="{Binding Status}" Width="86" /></DataGrid.Columns></DataGrid></Border>
    <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="8"><CheckBox Content="Follow start order" IsChecked="{Binding FollowTimingOrder}" Command="{Binding ApplyFollowTimingOrderCommand}" FontSize="11" />
     <Button Grid.Column="1" Content="Start next · F5" Command="{Binding ExpectSelectedCommand}" CommandParameter="start" Classes="primaryAction" /></Grid>
   </Grid></Border>
   <Border Grid.Column="2" Classes="racePane"><Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="{Binding IntermediatePaneHeight}" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock Text="{Binding OnCourseLabel}" Classes="raceHeading" />
    <Border Grid.Row="1"><DataGrid Name="OnCourseGrid" Classes="raceGrid timingGrid" ItemsSource="{Binding OnCourseRows}" SelectionChanged="SelectCompetitor" PointerPressed="SelectContextCompetitor"
 AutoGenerateColumns="False" IsReadOnly="True" RowHeight="30" GridLinesVisibility="Horizontal"><DataGrid.ContextMenu><ContextMenu>
 <MenuItem Header="Next at start" InputGesture="F5" Command="{Binding ExpectSelectedCommand}" CommandParameter="start" />
 <MenuItem Header="Next at finish" InputGesture="F6" Command="{Binding ExpectSelectedCommand}" CommandParameter="finish" />
 <MenuItem Header="Next at intermediate" Command="{Binding ExpectSelectedCommand}" CommandParameter="intermediate" IsVisible="{Binding HasTimingIntermediates}" />
 <Separator />
 <MenuItem Header="DNS · did not start" Command="{Binding ClassifyTimingCommand}" CommandParameter="DNS" />
 <MenuItem Header="DNF · did not finish" Command="{Binding ClassifyTimingCommand}" CommandParameter="DNF" />
 <MenuItem Header="DSQ · disqualified" Command="{Binding ClassifyTimingCommand}" CommandParameter="DSQ" />
 <MenuItem Header="NPS · not permitted to start" Command="{Binding ClassifyTimingCommand}" CommandParameter="NPS" />
 <MenuItem Header="Clear classification" Command="{Binding ClassifyTimingCommand}" CommandParameter="Clear" />
 <Separator /><MenuItem Header="Correct finish assignment…" Command="{Binding CorrectCompetitorFinishCommand}" />
 </ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="BIB" Binding="{Binding Bib}" Width="40" /><DataGridTemplateColumn Header="COMPETITOR" Width="*" MinWidth="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel Margin="6,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding SplitTimes}" IsVisible="{Binding HasSplits}" FontSize="10" Classes="supportingText" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn><DataGridTextColumn Header="CURRENT" Binding="{Binding Clock.Time}" Width="82" /></DataGrid.Columns></DataGrid></Border>
    <Grid Grid.Row="2" RowDefinitions="Auto,Auto,*,Auto" IsVisible="{Binding HasTimingIntermediates}" Margin="8">
     <Grid ColumnDefinitions="*,65"><TextBlock Text="INTERMEDIATE" Classes="eyebrow" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding TimingCheckpoints}" SelectedItem="{Binding SelectedTimingCheckpoint}" HorizontalAlignment="Stretch" MinHeight="26" Padding="6,2" /></Grid>
     <TextBlock Grid.Row="1" Text="{Binding ExpectedIntermediateLabel}" Classes="raceIdentity" FontSize="12" Margin="0,3" />
     <Border Grid.Row="2"><DataGrid Name="IntermediateGrid" Classes="raceGrid timingGrid" ItemsSource="{Binding IntermediateTimingRows}" SelectionChanged="SelectCompetitor" PointerPressed="SelectContextCompetitor"
 AutoGenerateColumns="False" IsReadOnly="True" RowHeight="30" GridLinesVisibility="Horizontal"><DataGrid.ContextMenu><ContextMenu>
 <MenuItem Header="Next at start" InputGesture="F5" Command="{Binding ExpectSelectedCommand}" CommandParameter="start" />
 <MenuItem Header="Next at finish" InputGesture="F6" Command="{Binding ExpectSelectedCommand}" CommandParameter="finish" />
 <MenuItem Header="Next at intermediate" Command="{Binding ExpectSelectedCommand}" CommandParameter="intermediate" IsVisible="{Binding HasTimingIntermediates}" />
 <Separator />
 <MenuItem Header="DNS · did not start" Command="{Binding ClassifyTimingCommand}" CommandParameter="DNS" />
 <MenuItem Header="DNF · did not finish" Command="{Binding ClassifyTimingCommand}" CommandParameter="DNF" />
 <MenuItem Header="DSQ · disqualified" Command="{Binding ClassifyTimingCommand}" CommandParameter="DSQ" />
 <MenuItem Header="NPS · not permitted to start" Command="{Binding ClassifyTimingCommand}" CommandParameter="NPS" />
 <MenuItem Header="Clear classification" Command="{Binding ClassifyTimingCommand}" CommandParameter="Clear" />
 <Separator /><MenuItem Header="Correct finish assignment…" Command="{Binding CorrectCompetitorFinishCommand}" />
 </ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="BIB" Binding="{Binding Bib}" Width="45" /><DataGridTextColumn Header="APPROACHING" Binding="{Binding Name}" Width="*" MinWidth="80" /><DataGridTextColumn Header="CURRENT" Binding="{Binding Clock.Time}" Width="82" /></DataGrid.Columns></DataGrid></Border>
     <WrapPanel Grid.Row="3" Margin="0,6,0,0"><Button Content="Next here" Command="{Binding ExpectSelectedCommand}" CommandParameter="intermediate" Classes="secondaryAction" Margin="0,0,6,0" /><Button Content="{Binding IntermediateHoldLabel}" Command="{Binding HoldTimingPositionCommand}" CommandParameter="intermediate" Classes="secondaryAction" /></WrapPanel>
    </Grid>
   </Grid></Border>
   <Border Grid.Column="4" Classes="racePane"><Grid RowDefinitions="Auto,Auto,*,Auto">
    <TextBlock Text="FINISH" Classes="raceHeading" />
    <Border Grid.Row="1" Classes="raceExpected"><StackPanel Spacing="6">
     <TextBlock Text="EXPECTED FINISH" Classes="eyebrow" /><TextBlock Text="{Binding ExpectedFinishLabel}" Classes="raceIdentity" /><TextBlock Text="{Binding ExpectedFinishTime}" Classes="raceRunningTime" />
     <StackPanel Orientation="Horizontal" Spacing="6"><Button Content="Finish next · F6" Command="{Binding ExpectSelectedCommand}" CommandParameter="finish" Classes="primaryAction" /><Button Content="{Binding FinishHoldLabel}" Command="{Binding HoldTimingPositionCommand}" CommandParameter="finish" Classes="secondaryAction" /></StackPanel>
    </StackPanel></Border>
    <Grid Grid.Row="2" RowDefinitions="Auto,*"><TextBlock Text="{Binding FinishListLabel}" Classes="raceHeading" /><Border Grid.Row="1"><DataGrid Name="FinishedGrid" Classes="raceGrid timingGrid" ItemsSource="{Binding FinishedTimingRows}" SelectionChanged="SelectCompetitor" PointerPressed="SelectContextCompetitor"
 AutoGenerateColumns="False" IsReadOnly="True" RowHeight="30" GridLinesVisibility="Horizontal"><DataGrid.ContextMenu><ContextMenu>
 <MenuItem Header="Next at start" InputGesture="F5" Command="{Binding ExpectSelectedCommand}" CommandParameter="start" />
 <MenuItem Header="Next at finish" InputGesture="F6" Command="{Binding ExpectSelectedCommand}" CommandParameter="finish" />
 <MenuItem Header="Next at intermediate" Command="{Binding ExpectSelectedCommand}" CommandParameter="intermediate" IsVisible="{Binding HasTimingIntermediates}" />
 <Separator />
 <MenuItem Header="DNS · did not start" Command="{Binding ClassifyTimingCommand}" CommandParameter="DNS" />
 <MenuItem Header="DNF · did not finish" Command="{Binding ClassifyTimingCommand}" CommandParameter="DNF" />
 <MenuItem Header="DSQ · disqualified" Command="{Binding ClassifyTimingCommand}" CommandParameter="DSQ" />
 <MenuItem Header="NPS · not permitted to start" Command="{Binding ClassifyTimingCommand}" CommandParameter="NPS" />
 <MenuItem Header="Clear classification" Command="{Binding ClassifyTimingCommand}" CommandParameter="Clear" />
 <Separator /><MenuItem Header="Correct finish assignment…" Command="{Binding CorrectCompetitorFinishCommand}" />
 </ContextMenu></DataGrid.ContextMenu><DataGrid.Columns><DataGridTextColumn Header="BIB" Binding="{Binding Bib}" Width="45" /><DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" MinWidth="90" /><DataGridTextColumn Header="TIME" Binding="{Binding DisplayTime}" Width="78" /><DataGridTextColumn Header="RK" Binding="{Binding Rank}" Width="38" /><DataGridTextColumn Header="TOTAL" Binding="{Binding TotalTime}" Width="78" IsVisible="{Binding ShowTimingTotal}" /><DataGridTextColumn Header="RK" Binding="{Binding TotalRank}" Width="38" IsVisible="{Binding ShowTimingTotal}" /></DataGrid.Columns></DataGrid></Border></Grid>
    <StackPanel Grid.Row="3" Margin="8" Spacing="6"><TextBlock Text="{Binding LastFinishLabel}" Classes="supportingText" FontSize="10" TextTrimming="CharacterEllipsis" />
     <Button Content="Assign finish to competitor" Command="{Binding CorrectLastFinishCommand}" IsVisible="{Binding HasUnassignedFinish}" Classes="secondaryAction" />
     <Button Content="False finish · not a racer" Command="{Binding IgnoreLastFinishCommand}" IsEnabled="{Binding CanIgnoreLastFinish}" Classes="secondaryAction" HorizontalAlignment="Stretch" ToolTip.Tip="Ignore the latest finish pulse. If assigned, return that competitor to the course queue. Original input is retained." />
    </StackPanel>
   </Grid></Border>
  </Grid>
  <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="0,8,0,0">
   <WrapPanel VerticalAlignment="Center">
    <TextBlock Text="{Binding SelectedTimingIdentity}" MaxWidth="230" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
    <Button Content="DNS" Command="{Binding ClassifyTimingCommand}" CommandParameter="DNS" Classes="secondaryAction" Margin="0,0,4,0" />
    <Button Content="DNF" Command="{Binding ClassifyTimingCommand}" CommandParameter="DNF" Classes="secondaryAction" Margin="0,0,4,0" />
    <Button Content="DSQ" Command="{Binding ClassifyTimingCommand}" CommandParameter="DSQ" Classes="secondaryAction" Margin="0,0,4,0" />
    <Button Content="NPS" Command="{Binding ClassifyTimingCommand}" CommandParameter="NPS" Classes="secondaryAction" Margin="0,0,4,0" />
    <Button Content="Clear status" Command="{Binding ClassifyTimingCommand}" CommandParameter="Clear" Classes="secondaryAction" />
   </WrapPanel>
  </Grid>
  <Border Grid.Row="4" Classes="workSurface" Padding="10" Margin="0,8,0,0" IsVisible="{Binding ShowTimingCorrection}">
   <StackPanel Spacing="8">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding SelectedTimingIdentity}" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Close correction" Command="{Binding CloseTimingCorrectionCommand}" Classes="secondaryAction" /></Grid>
    <TextBlock Text="{Binding SelectedTimingRow.Detail}" Classes="supportingText" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="*,8,*">
     <StackPanel Spacing="4"><TextBlock Text="FINISH BELONGS TO BIB" Classes="fieldLabel" /><Grid ColumnDefinitions="80,8,Auto"><TextBox Text="{Binding ObservationBibText}" Watermark="Bib" /><Button Grid.Column="2" Content="Assign finish" Command="{Binding ChangeObservationCommand}" CommandParameter="assign" Classes="secondaryAction" /></Grid></StackPanel>
     <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="CORRECTED RUN TIME" Classes="fieldLabel" /><Grid ColumnDefinitions="100,8,Auto"><TextBox Text="{Binding CorrectedTimeText}" Watermark="1:12.34" /><Button Grid.Column="2" Content="Correct time" Command="{Binding CorrectTimingTimeCommand}" Classes="secondaryAction" /></Grid></StackPanel>
    </Grid>
    <Grid ColumnDefinitions="*,8,Auto"><TextBox Text="{Binding TimingReason}" Watermark="Reason for correction" /><Button Grid.Column="2" Content="Undo last change" Command="{Binding UndoLastTimingChangeCommand}" Classes="secondaryAction" /></Grid>
   </StackPanel>
  </Border>
  <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding IsTimingSimulator}">
   <TextBlock Text="TRAINING" Classes="eyebrow" VerticalAlignment="Center" /><TextBox Text="{Binding SimulationTime}" Width="155" />
   <Button Content="Test start" Command="{Binding SimulatePulseCommand}" CommandParameter="start" IsEnabled="{Binding IsTimingConnected}" Classes="secondaryAction" />
   <Button Content="Test intermediate" Command="{Binding SimulatePulseCommand}" CommandParameter="intermediate" IsVisible="{Binding HasTimingIntermediates}" IsEnabled="{Binding IsTimingConnected}" Classes="secondaryAction" />
   <Button Content="Test finish" Command="{Binding SimulatePulseCommand}" CommandParameter="finish" IsEnabled="{Binding IsTimingConnected}" Classes="secondaryAction" />
  </StackPanel>
 </Grid>
</UserControl>
