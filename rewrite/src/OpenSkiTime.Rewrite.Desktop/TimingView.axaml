<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 x:Class="OpenSkiTime.Rewrite.Desktop.TimingView" x:CompileBindings="False">
 <UserControl.Resources>
  <x:Double x:Key="DataGridSortIconMinWidth">14</x:Double>
  <ControlTheme x:Key="DataGridCellTextBlockTheme" TargetType="TextBlock"><Setter Property="Margin" Value="6,0" /><Setter Property="VerticalAlignment" Value="Center" /></ControlTheme>
 </UserControl.Resources>
 <Grid RowDefinitions="Auto,Auto,*,Auto,Auto,Auto">
  <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
   <StackPanel Orientation="Horizontal" Spacing="16"><TextBlock Text="{Binding TimingContext}" Classes="sectionTitle" /><TextBlock Text="{Binding TimingSummary}" Classes="supportingText" VerticalAlignment="Center" /></StackPanel>
   <Button Grid.Column="1" Content="Prepare Run 2" Command="{Binding PrepareNextTimedRunCommand}" IsVisible="{Binding CanPrepareNextTimedRun}" Classes="secondaryAction" />
  </Grid>
  <StackPanel Grid.Row="1" Spacing="6" Margin="0,0,0,8">
   <Border Classes="raceConnection"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding TimingConnection}" TextTrimming="CharacterEllipsis" />
    <TextBlock Grid.Column="1" Text="{Binding TimingStorage}" Margin="12,0,0,0" /></Grid></Border>
   <Border IsVisible="{Binding HasTimingAlarm}" BorderBrush="{DynamicResource ErrorBrush}" BorderThickness="1" Padding="8">
    <Grid ColumnDefinitions="*,8,Auto"><TextBlock Text="{Binding TimingAlarm}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" /><Button Grid.Column="2" Content="Retry storage" Command="{Binding RetryTimingStorageCommand}" Classes="dangerAction" /></Grid>
   </Border>
  </StackPanel>
  <Grid Grid.Row="2" RowDefinitions="1.1*,8,1*" ColumnDefinitions="0.9*,8,2*">
   <Border Classes="racePane"><Grid RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto" Background="{DynamicResource SubtleSurfaceBrush}">
     <TextBlock Text="AT START" Classes="raceHeading" />
     <CheckBox Grid.Column="1" Content="Follow order" IsChecked="{Binding FollowTimingOrder}" Command="{Binding ApplyFollowTimingOrderCommand}" FontSize="11" Margin="8,0" MinHeight="24" />
    </Grid>
    <TextBlock Grid.Row="1" Text="{Binding NextStartLabel, StringFormat='Next · {0}'}" Classes="raceQueueHint" />
    <DataGrid Grid.Row="2" Name="AtStartGrid" Classes="raceGrid timingGrid" ItemsSource="{Binding AtStartRows}" SelectionChanged="SelectCompetitor" PointerPressed="SelectContextCompetitor"
     AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" RowHeight="28" GridLinesVisibility="Horizontal"
     ToolTip.Tip="▶ Next starter. Right-click or Shift+F10 for actions. F5: next at start.">
     <DataGrid.Columns>
      <DataGridTextColumn Header="" Binding="{Binding Clock.Marker}" Width="26" />
      <DataGridTextColumn Header="BIB" Binding="{Binding Bib}" Width="46" />
      <DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" MinWidth="100" />
     </DataGrid.Columns>
    </DataGrid>
   </Grid></Border>
   <Border Grid.Column="2" Classes="racePane"><Grid RowDefinitions="Auto,Auto,*">
    <Grid ColumnDefinitions="*,Auto" Background="{DynamicResource SubtleSurfaceBrush}">
     <TextBlock Text="RUNNING · LAST 3 FINISHERS" Classes="raceHeading" />
     <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5" Margin="8,0" IsVisible="{Binding HasTimingIntermediates}">
      <TextBlock Text="Checkpoint" FontSize="11" VerticalAlignment="Center" />
      <ComboBox ItemsSource="{Binding TimingCheckpoints}" SelectedItem="{Binding SelectedTimingCheckpoint}" Width="54" MinHeight="24" Padding="5,0" ToolTip.Tip="{Binding ExpectedIntermediateLabel}" />
     </StackPanel>
    </Grid>
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Background="{DynamicResource AccentTintBrush}">
     <TextBlock Text="{Binding ExpectedFinishLabel, StringFormat='Finish next · {0}'}" Classes="raceQueueHint" />
     <TextBlock Grid.Column="1" Text="{Binding ExpectedFinishTime}" Classes="raceClock" Margin="8,3" FontSize="18" />
    </Grid>
    <DataGrid Grid.Row="2" Name="RunningGrid" Classes="raceGrid timingGrid" ItemsSource="{Binding RunningRows}" SelectionChanged="SelectCompetitor" PointerPressed="SelectContextCompetitor"
     AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" RowHeight="28" GridLinesVisibility="Horizontal"
     ToolTip.Tip="▶ Expected finish · ◆ Latest finisher. Right-click or Shift+F10 for actions.">
     <DataGrid.Columns>
      <DataGridTextColumn Header="" Binding="{Binding Clock.Marker}" Width="26" />
      <DataGridTextColumn Header="BIB" Binding="{Binding Bib}" Width="46" />
      <DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" MinWidth="110" />
      <DataGridTextColumn Header="CURRENT" Binding="{Binding Clock.Time}" Width="82" />
      <DataGridTextColumn Header="FINISH" Binding="{Binding DisplayTime}" Width="86" />
     </DataGrid.Columns>
    </DataGrid>
   </Grid></Border>
   <GridSplitter Grid.Row="1" Grid.ColumnSpan="3" ResizeDirection="Rows" HorizontalAlignment="Stretch" Background="Transparent" />
   <Border Grid.Row="2" Grid.ColumnSpan="3" Classes="racePane"><Grid RowDefinitions="Auto,*">
    <Grid ColumnDefinitions="*,Auto" Background="{DynamicResource SubtleSurfaceBrush}">
     <TextBlock Text="RANKING" Classes="raceHeading" />
     <TextBlock Grid.Column="1" Text="◆ Latest finisher" Classes="supportingText" FontSize="11" Margin="8,0" VerticalAlignment="Center" />
    </Grid>
    <DataGrid Grid.Row="1" Name="RankingGrid" Classes="raceGrid timingGrid" ItemsSource="{Binding RankingView}" SelectionChanged="SelectCompetitor" PointerPressed="SelectContextCompetitor" LoadingRowGroup="DescribeCategory"
     AutoGenerateColumns="False" IsReadOnly="True" CanUserSortColumns="False" RowHeight="28" GridLinesVisibility="Horizontal"
     ToolTip.Tip="Results in rank order within each category. Right-click or Shift+F10 for corrections and classifications.">
     <DataGrid.Columns>
      <DataGridTextColumn Header="" Binding="{Binding FinishMarker}" Width="28" />
      <DataGridTextColumn Header="RK" Binding="{Binding DisplayRank}" Width="42" />
      <DataGridTextColumn Header="BIB" Binding="{Binding Bib}" Width="46" />
      <DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" MinWidth="130" />
      <DataGridTextColumn Header="NAT" Binding="{Binding Result.Entry.Entrant.Athlete.Nation}" Width="55" />
      <DataGridTextColumn Header="CLUB" Binding="{Binding Result.Entry.Entrant.Athlete.Club}" Width="*" MinWidth="100" />
      <DataGridTextColumn Header="TIME / STATE" Binding="{Binding DisplayTime}" Width="100" />
      <DataGridTextColumn Header="TOTAL" Binding="{Binding TotalTime}" Width="90" IsVisible="{Binding ShowTimingTotal}" />
     </DataGrid.Columns>
    </DataGrid>
   </Grid></Border>
  </Grid>
  <StackPanel Grid.Row="3" Spacing="3" Margin="0,5,0,0">
   <Grid ColumnDefinitions="*,Auto">
    <TextBlock Text="{Binding SelectedTimingIdentity}" Classes="supportingText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
    <TextBlock Grid.Column="1" Text="Right-click / Shift+F10 · F5 start · F6 finish · F8 back to start" Classes="supportingText" FontSize="10" />
   </Grid>
   <TextBlock Text="{Binding SelectedTimingProblem}" IsVisible="{Binding HasSelectedTimingProblem}" Foreground="{DynamicResource ErrorBrush}" TextWrapping="Wrap" />
   <TextBlock Text="Unassigned finish received · right-click → Assign latest finish…" IsVisible="{Binding HasUnassignedFinish}" Foreground="{DynamicResource WarningBrush}" />
  </StackPanel>
  <Border Grid.Row="4" Classes="workSurface" Padding="10" Margin="0,8,0,0" IsVisible="{Binding ShowTimingCorrection}">
   <StackPanel Spacing="8">
    <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding SelectedTimingIdentity}" FontWeight="SemiBold" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Close correction" Command="{Binding CloseTimingCorrectionCommand}" Classes="secondaryAction" /></Grid>
    <TextBlock Text="{Binding SelectedTimingRow.Detail}" Classes="supportingText" TextWrapping="Wrap" />
    <Grid ColumnDefinitions="*,8,*">
     <StackPanel Spacing="4"><TextBlock Text="FINISH BELONGS TO BIB" Classes="fieldLabel" /><Grid ColumnDefinitions="80,8,Auto"><TextBox Text="{Binding ObservationBibText}" Watermark="Bib" /><Button Grid.Column="2" Content="Assign finish" Command="{Binding ChangeObservationCommand}" CommandParameter="assign" Classes="secondaryAction" /></Grid></StackPanel>
     <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="CORRECTED RUN TIME" Classes="fieldLabel" /><Grid ColumnDefinitions="100,8,Auto"><TextBox Text="{Binding CorrectedTimeText}" Watermark="1:12.34" /><Button Grid.Column="2" Content="Correct time" Command="{Binding CorrectTimingTimeCommand}" Classes="secondaryAction" /></Grid></StackPanel>
    </Grid>
    <Grid ColumnDefinitions="*,8,Auto"><TextBox Text="{Binding TimingReason}" Watermark="Reason for correction" /><Button Grid.Column="2" Content="Undo last change" Command="{Binding UndoLastTimingChangeCommand}" Classes="secondaryAction" /></Grid>
   </StackPanel>
  </Border>
  <StackPanel Grid.Row="5" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0" IsVisible="{Binding IsTimingSimulator}">
   <TextBlock Text="TRAINING" Classes="eyebrow" VerticalAlignment="Center" /><TextBox Text="{Binding SimulationTime}" Width="155" />
   <Button Content="Test start" Command="{Binding SimulatePulseCommand}" CommandParameter="start" IsEnabled="{Binding IsTimingConnected}" Classes="secondaryAction" />
   <Button Content="Test intermediate" Command="{Binding SimulatePulseCommand}" CommandParameter="intermediate" IsVisible="{Binding HasTimingIntermediates}" IsEnabled="{Binding IsTimingConnected}" Classes="secondaryAction" />
   <Button Content="Test finish" Command="{Binding SimulatePulseCommand}" CommandParameter="finish" IsEnabled="{Binding IsTimingConnected}" Classes="secondaryAction" />
  </StackPanel>
 </Grid>
</UserControl>
