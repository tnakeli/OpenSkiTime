<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:OpenSkiTime.Rewrite.Desktop">
 <Style Selector="TextBlock.raceRunningTime">
  <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,DejaVu Sans Mono,monospace" />
  <Setter Property="FontSize" Value="28" />
  <Setter Property="FontWeight" Value="SemiBold" />
  <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
 </Style>
 <Style Selector="Border.racePane">
  <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
  <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
  <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" />
 </Style>
 <Style Selector="Border.raceExpected">
  <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
  <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  <Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="Padding" Value="10,8" />
 </Style>
 <Style Selector="Border.raceConnection">
  <Setter Property="Background" Value="{DynamicResource NavyBrush}" /><Setter Property="Padding" Value="10,6" />
  <Setter Property="CornerRadius" Value="4" />
 </Style>
 <Style Selector="Border.raceConnection TextBlock"><Setter Property="Foreground" Value="#E1F1EF" /><Setter Property="FontSize" Value="11" /></Style>
 <Style Selector="TextBlock.raceHeading">
  <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" /><Setter Property="Padding" Value="8,7" />
  <Setter Property="FontSize" Value="10" /><Setter Property="FontWeight" Value="Bold" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
 </Style>
 <Style Selector="TextBlock.raceIdentity">
  <Setter Property="FontSize" Value="15" /><Setter Property="FontWeight" Value="SemiBold" />
  <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="TextTrimming" Value="CharacterEllipsis" />
 </Style>
 <Style Selector="DataGrid.timingGrid"><Setter Property="BorderThickness" Value="0" /><Setter Property="FontSize" Value="12" /></Style>
 <Style Selector="local|TimingView ToggleButton">
  <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
  <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="4" />
 </Style>
 <Style Selector="local|TimingView ToggleButton:checked">
  <Setter Property="Background" Value="{DynamicResource AccentBrush}" /><Setter Property="Foreground" Value="White" />
 </Style>
</Styles>
