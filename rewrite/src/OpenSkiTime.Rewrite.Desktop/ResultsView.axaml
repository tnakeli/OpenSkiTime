<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenSkiTime.Rewrite.Desktop.ResultsView" x:CompileBindings="False">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12">
      <Border Classes="workSurface" Padding="16">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,240,Auto">
            <StackPanel Spacing="2"><TextBlock Text="RACE / OFFICIAL RESULTS" Classes="eyebrow" />
              <TextBlock Text="Results &amp; FIS penalty" Classes="sectionTitle" /></StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Competitions}" SelectedItem="{Binding ResultsCompetition}"
                      VerticalAlignment="Center" DisplayMemberBinding="{Binding Values.ShortLabel}" />
            <Button Grid.Column="2" Content="Refresh timing" Command="{Binding LoadResultsCommand}"
                    Classes="secondaryAction" Margin="8,0,0,0" />
          </Grid>
          <TextBlock Text="{Binding ResultsState}" Classes="supportingText" />
          <TextBlock Text="{Binding ResultsPointsList}" Classes="supportingText" />
          <DataGrid Classes="raceGrid" ItemsSource="{Binding ResultRows}" AutoGenerateColumns="False" IsReadOnly="True"
                    Height="260" RowHeight="28" ColumnHeaderHeight="28" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="RK" Binding="{Binding Rank}" Width="70" />
              <DataGridTextColumn Header="BIB" Binding="{Binding Bib}" Width="75" />
              <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="90" />
              <DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="RUN 1" Binding="{Binding Run1}" Width="90" />
              <DataGridTextColumn Header="RUN 2" Binding="{Binding Run2}" Width="90" />
              <DataGridTextColumn Header="TOTAL" Binding="{Binding Total}" Width="90" />
              <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110" />
              <DataGridTextColumn Header="RACE PTS" Binding="{Binding RacePoints}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
      <Border Classes="workSurface" Padding="16">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2"><TextBlock Text="TD REVIEW / PENALTY" Classes="eyebrow" />
            <TextBlock Text="Penalty calculation" Classes="sectionTitle" /></StackPanel>
          <TextBlock Text="Enter the category values from the FIS points list effective on race day. No values are assumed." Classes="supportingText" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <StackPanel Classes="field" Width="115"><TextBlock Text="MINIMUM" Classes="fieldLabel" /><TextBox Text="{Binding ResultsMinimum}" Watermark="0.00" /></StackPanel>
            <StackPanel Classes="field" Width="115"><TextBlock Text="MAXIMUM" Classes="fieldLabel" /><TextBox Text="{Binding ResultsMaximum}" Watermark="999.00" /></StackPanel>
            <StackPanel Classes="field" Width="115"><TextBlock Text="ADDER" Classes="fieldLabel" /><TextBox Text="{Binding ResultsAdder}" Watermark="0.00" /></StackPanel>
            <Button Content="Calculate" Command="{Binding CalculateResultsPenaltyCommand}" Classes="primaryAction" VerticalAlignment="Bottom" />
            <TextBlock Text="{Binding ResultsPenaltySummary}" VerticalAlignment="Bottom" Margin="8,0,0,6" />
          </StackPanel>
          <Grid ColumnDefinitions="*,12,*">
            <StackPanel Grid.Column="0" Spacing="4"><TextBlock Text="A · FIVE BEST CLASSIFIED IN TOP TEN" Classes="fieldLabel" />
              <DataGrid Classes="raceGrid" ItemsSource="{Binding ResultBestClassified}" AutoGenerateColumns="False" IsReadOnly="True" Height="180" RowHeight="28" ColumnHeaderHeight="27">
                <DataGrid.Columns><DataGridTextColumn Header="BIB" Binding="{Binding Bib}" Width="75" /><DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="LIST" Binding="{Binding Listed}" Width="75" /><DataGridTextColumn Header="USED" Binding="{Binding Used}" Width="75" />
                  <DataGridTextColumn Header="RACE" Binding="{Binding RacePoints}" Width="75" /></DataGrid.Columns></DataGrid></StackPanel>
            <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="B · FIVE BEST STARTERS" Classes="fieldLabel" />
              <DataGrid Classes="raceGrid" ItemsSource="{Binding ResultBestStarted}" AutoGenerateColumns="False" IsReadOnly="True" Height="180" RowHeight="28" ColumnHeaderHeight="27">
                <DataGrid.Columns><DataGridTextColumn Header="BIB" Binding="{Binding Bib}" Width="75" /><DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="LIST" Binding="{Binding Listed}" Width="75" /><DataGridTextColumn Header="USED" Binding="{Binding Used}" Width="75" />
                  <DataGridTextColumn Header="NOTE" Binding="{Binding Note}" Width="120" /></DataGrid.Columns></DataGrid></StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="workSurface" Padding="16">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2"><TextBlock Text="FIS ALPINE XML / APPROVAL" Classes="eyebrow" />
            <TextBlock Text="Race information" Classes="sectionTitle" /></StackPanel>
          <TextBlock Text="Check the codex, course and elevations in Competitions. Enter the FIS calendar category and required jury/run details here." Classes="supportingText" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <StackPanel Classes="field" Width="115"><TextBlock Text="CATEGORY" Classes="fieldLabel" /><TextBox Text="{Binding ResultsCategory}" Watermark="FIS" /></StackPanel>
            <StackPanel Classes="field" Width="160"><TextBlock Text="TD FIRST NAME" Classes="fieldLabel" /><TextBox Text="{Binding ResultsTdFirstName}" /></StackPanel>
            <StackPanel Classes="field" Width="160"><TextBlock Text="TD LAST NAME" Classes="fieldLabel" /><TextBox Text="{Binding ResultsTdLastName}" /></StackPanel>
            <StackPanel Classes="field" Width="80"><TextBlock Text="TD NAT" Classes="fieldLabel" /><TextBox Text="{Binding ResultsTdNation}" /></StackPanel>
            <StackPanel Classes="field" Width="160"><TextBlock Text="CHIEF FIRST NAME" Classes="fieldLabel" /><TextBox Text="{Binding ResultsChiefFirstName}" /></StackPanel>
            <StackPanel Classes="field" Width="160"><TextBlock Text="CHIEF LAST NAME" Classes="fieldLabel" /><TextBox Text="{Binding ResultsChiefLastName}" /></StackPanel>
            <StackPanel Classes="field" Width="80"><TextBlock Text="CHIEF NAT" Classes="fieldLabel" /><TextBox Text="{Binding ResultsChiefNation}" /></StackPanel>
          </StackPanel>
          <TextBlock Text="RUN 1 COURSE" Classes="fieldLabel" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <StackPanel Classes="field" Width="80"><TextBlock Text="GATES" Classes="fieldLabel" /><TextBox Text="{Binding ResultsRun1Gates}" /></StackPanel>
            <StackPanel Classes="field" Width="80"><TextBlock Text="TURNS" Classes="fieldLabel" /><TextBox Text="{Binding ResultsRun1Turns}" /></StackPanel>
            <StackPanel Classes="field" Width="100"><TextBlock Text="START HH:mm" Classes="fieldLabel" /><TextBox Text="{Binding ResultsRun1Start}" Watermark="10:00" /></StackPanel>
            <StackPanel Classes="field" Width="160"><TextBlock Text="SETTER FIRST" Classes="fieldLabel" /><TextBox Text="{Binding ResultsSetter1FirstName}" /></StackPanel>
            <StackPanel Classes="field" Width="160"><TextBlock Text="SETTER LAST" Classes="fieldLabel" /><TextBox Text="{Binding ResultsSetter1LastName}" /></StackPanel>
            <StackPanel Classes="field" Width="80"><TextBlock Text="SETTER NAT" Classes="fieldLabel" /><TextBox Text="{Binding ResultsSetter1Nation}" /></StackPanel>
          </StackPanel>
          <StackPanel Spacing="6" IsVisible="{Binding ResultsHasSecondRun}">
            <TextBlock Text="RUN 2 COURSE" Classes="fieldLabel" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <StackPanel Classes="field" Width="80"><TextBlock Text="GATES" Classes="fieldLabel" /><TextBox Text="{Binding ResultsRun2Gates}" /></StackPanel>
              <StackPanel Classes="field" Width="80"><TextBlock Text="TURNS" Classes="fieldLabel" /><TextBox Text="{Binding ResultsRun2Turns}" /></StackPanel>
              <StackPanel Classes="field" Width="100"><TextBlock Text="START HH:mm" Classes="fieldLabel" /><TextBox Text="{Binding ResultsRun2Start}" Watermark="13:00" /></StackPanel>
              <StackPanel Classes="field" Width="160"><TextBlock Text="SETTER FIRST" Classes="fieldLabel" /><TextBox Text="{Binding ResultsSetter2FirstName}" /></StackPanel>
              <StackPanel Classes="field" Width="160"><TextBlock Text="SETTER LAST" Classes="fieldLabel" /><TextBox Text="{Binding ResultsSetter2LastName}" /></StackPanel>
              <StackPanel Classes="field" Width="80"><TextBlock Text="SETTER NAT" Classes="fieldLabel" /><TextBox Text="{Binding ResultsSetter2Nation}" /></StackPanel>
            </StackPanel>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="TD approves · create XML" Command="{Binding ApproveFisResultsCommand}" IsEnabled="{Binding ResultsReady}" Classes="primaryAction" />
            <ComboBox Width="300" ItemsSource="{Binding ResultApprovals}" SelectedItem="{Binding SelectedResultApproval}"
                      DisplayMemberBinding="{Binding XmlFileName}" />
            <Button Content="Export approved XML" Command="{Binding ExportApprovedXmlCommand}" Classes="secondaryAction" />
          </StackPanel>
          <TextBlock Text="Approved revisions remain in the event file. XML is exported locally; FIS submission is a later step." Classes="supportingText" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
