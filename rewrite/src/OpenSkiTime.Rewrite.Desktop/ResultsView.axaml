<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:OpenSkiTime.Rewrite.Desktop" x:Class="OpenSkiTime.Rewrite.Desktop.ResultsView" x:CompileBindings="False">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="12">
      <Border Classes="workSurface" Padding="16">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,240,Auto">
            <StackPanel Spacing="2"><TextBlock Text="RACE / OFFICIAL RESULTS" Classes="eyebrow" />
              <TextBlock Text="Results &amp; FIS penalty" Classes="sectionTitle" /></StackPanel>
            <ComboBox Grid.Column="1" ItemsSource="{Binding FisCompetitions}" SelectedItem="{Binding ResultsCompetition}"
                      VerticalAlignment="Center" DisplayMemberBinding="{Binding Values.ShortLabel}" />
            <Button Grid.Column="2" Content="Refresh timing" Command="{Binding LoadResultsCommand}"
                    Classes="secondaryAction" Margin="8,0,0,0" />
          </Grid>
          <TextBlock Text="{Binding ResultsState}" Classes="supportingText" />

        </StackPanel>
      </Border>
      <Border Name="ResultsFisInformation" Classes="workSurface" Padding="16" IsVisible="{Binding ResultsIsFis}"><local:RaceInformationView /></Border>
      <Border Classes="workSurface" Padding="16" IsVisible="{Binding ResultsIsFis}">
        <StackPanel Spacing="10">
          <StackPanel Spacing="2"><TextBlock Text="TD REVIEW / PENALTY" Classes="eyebrow" />
            <TextBlock Text="Penalty calculation" Classes="sectionTitle" /></StackPanel>
          <DataGrid Classes="raceGrid" ItemsSource="{Binding ResultRows}" AutoGenerateColumns="False" IsReadOnly="True"
                    Height="260" RowHeight="28" ColumnHeaderHeight="28" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="RK" Binding="{Binding Rank}" Width="70" />
              <DataGridTextColumn Header="BIB" Binding="{Binding Bib}" Width="75" />
              <DataGridTextColumn Header="CODE" Binding="{Binding Code}" Width="90" />
              <DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" />
              <DataGridTextColumn Header="RUN 1" Binding="{Binding Run1}" Width="90" />
              <DataGridTextColumn Header="RUN 2" Binding="{Binding Run2}" Width="90" />
              <DataGridTextColumn Header="TOTAL" Binding="{Binding Total}" Width="90" />
              <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="110" />
              <DataGridTextColumn Header="RACE PTS" Binding="{Binding RacePoints}" Width="100" />
            </DataGrid.Columns>
          </DataGrid>
          <TextBlock Text="Enter the category values from the FIS points list effective on race day. No values are assumed." Classes="supportingText" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <StackPanel Classes="field" Width="115"><TextBlock Text="MINIMUM" Classes="fieldLabel" /><TextBox Text="{Binding ResultsMinimum}" Watermark="0.00" /></StackPanel>
            <StackPanel Classes="field" Width="115"><TextBlock Text="MAXIMUM" Classes="fieldLabel" /><TextBox Text="{Binding ResultsMaximum}" Watermark="999.00" /></StackPanel>
            <StackPanel Classes="field" Width="115"><TextBlock Text="ADDER" Classes="fieldLabel" /><TextBox Text="{Binding ResultsAdder}" Watermark="0.00" /></StackPanel>
            <Button Content="Calculate" Command="{Binding CalculateResultsPenaltyCommand}" Classes="primaryAction" VerticalAlignment="Bottom" />
            <TextBlock Text="{Binding ResultsPenaltySummary}" VerticalAlignment="Bottom" Margin="8,0,0,6" />
          </StackPanel>
          <Grid ColumnDefinitions="*,12,*">
            <StackPanel Grid.Column="0" Spacing="4"><TextBlock Text="A · FIVE BEST CLASSIFIED IN TOP TEN" Classes="fieldLabel" />
              <DataGrid Classes="raceGrid" ItemsSource="{Binding ResultBestClassified}" AutoGenerateColumns="False" IsReadOnly="True" Height="180" RowHeight="28" ColumnHeaderHeight="27">
                <DataGrid.Columns><DataGridTextColumn Header="BIB" Binding="{Binding Bib}" Width="75" /><DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="LIST" Binding="{Binding Listed}" Width="75" /><DataGridTextColumn Header="USED" Binding="{Binding Used}" Width="75" />
                  <DataGridTextColumn Header="RACE" Binding="{Binding RacePoints}" Width="75" /></DataGrid.Columns></DataGrid></StackPanel>
            <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="B · FIVE BEST STARTERS" Classes="fieldLabel" />
              <DataGrid Classes="raceGrid" ItemsSource="{Binding ResultBestStarted}" AutoGenerateColumns="False" IsReadOnly="True" Height="180" RowHeight="28" ColumnHeaderHeight="27">
                <DataGrid.Columns><DataGridTextColumn Header="BIB" Binding="{Binding Bib}" Width="75" /><DataGridTextColumn Header="COMPETITOR" Binding="{Binding Name}" Width="*" />
                  <DataGridTextColumn Header="LIST" Binding="{Binding Listed}" Width="75" /><DataGridTextColumn Header="USED" Binding="{Binding Used}" Width="75" />
                  <DataGridTextColumn Header="NOTE" Binding="{Binding Note}" Width="120" /></DataGrid.Columns></DataGrid></StackPanel>
          </Grid>
        </StackPanel>
      </Border>
      <Border Classes="workSurface" Padding="16" IsVisible="{Binding ResultsIsFis}">
        <StackPanel Spacing="10">
          <TextBlock Text="XML file" Classes="sectionTitle" />
          <WrapPanel>
            <Button Content="TD approves · create XML" Command="{Binding ApproveFisResultsCommand}" IsEnabled="{Binding ResultsReady}" Classes="primaryAction" Margin="0,0,8,0" />
            <ComboBox Width="300" ItemsSource="{Binding ResultApprovals}" SelectedItem="{Binding SelectedResultApproval}" DisplayMemberBinding="{Binding XmlFileName}" Margin="0,0,8,0" />
            <Button Content="Export approved XML" Command="{Binding ExportApprovedXmlCommand}" Classes="secondaryAction" />
          </WrapPanel>
          <TextBlock Text="Approval stores the exact XML and race information as an immutable revision in the event file." Classes="supportingText" TextWrapping="Wrap" />
          <TextBlock Text="FIS upload · TEST MODE" Classes="sectionTitle" />
          <TextBlock Text="Test mode is always on: FIS validates the upload without forwarding results for processing. Codex 9991 simulates success; 9992 simulates a permission failure. Other codices simulate an unknown race. The approved XML is sent unchanged." Classes="supportingText" TextWrapping="Wrap" />
          <WrapPanel>
            <Button Name="SendApprovedXmlTestButton" Content="Send XML · test mode" Command="{Binding SendApprovedXmlTestCommand}" IsEnabled="{Binding CanSendResultsXml}" Classes="primaryAction" Margin="0,0,8,0" />
            <Button Content="Check status" Command="{Binding CheckResultsSubmissionCommand}" IsEnabled="{Binding CanCheckResultsSubmission}" Classes="secondaryAction" Margin="0,0,8,0" />
            <Button Content="Stop waiting" Command="{Binding StopResultsSubmissionPollingCommand}" IsEnabled="{Binding IsSubmissionBusy}" Classes="secondaryAction" />
          </WrapPanel>
          <StackPanel Classes="field" MaxWidth="440" HorizontalAlignment="Left"><TextBlock Text="SUBMISSION ID (UUID)" Classes="fieldLabel" />
            <TextBox Text="{Binding ResultSubmissionId}" Watermark="Returned UUID · paste to resume a test submission" IsReadOnly="{Binding IsSubmissionBusy}" /></StackPanel>
          <TextBlock Text="{Binding ResultSubmissionStatus}" TextWrapping="Wrap" />
          <Expander Header="FIS API response" IsExpanded="True">
            <TextBox Name="FisSubmissionResponseBox" Text="{Binding ResultSubmissionResponse}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="260" />
          </Expander>
          <TextBlock Text="Test status expires at FIS after 24 hours. The submission ID and response are retained in this session; copy the UUID to resume after restarting. Polling stops on completion or after two minutes. Member Section token permissions are configured in Settings." Classes="supportingText" TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
