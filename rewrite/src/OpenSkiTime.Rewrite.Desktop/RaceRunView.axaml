<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenSkiTime.Rewrite.Desktop.RaceRunView" x:CompileBindings="False">
  <Border Classes="subtleSurface" Padding="12">
    <StackPanel Spacing="8">
      <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="16" />
      <WrapPanel>
        <StackPanel Classes="field" Width="190" Margin="0,0,8,6"><TextBlock Text="COURSE" Classes="fieldLabel" /><TextBox Text="{Binding Course}" /></StackPanel>
        <StackPanel Classes="field" Width="145" Margin="0,0,8,6"><TextBlock Text="HOMOLOGATION" Classes="fieldLabel" /><TextBox Text="{Binding Homologation}" /></StackPanel>
        <StackPanel Classes="field" Width="85" Margin="0,0,8,6"><TextBlock Text="START m" Classes="fieldLabel" /><TextBox Text="{Binding StartAltitude}" /></StackPanel>
        <StackPanel Classes="field" Width="85" Margin="0,0,8,6"><TextBlock Text="FINISH m" Classes="fieldLabel" /><TextBox Text="{Binding FinishAltitude}" /></StackPanel>
        <StackPanel Classes="field" Width="85" Margin="0,0,8,6"><TextBlock Text="DROP m" Classes="fieldLabel" /><TextBox Text="{Binding Drop}" /></StackPanel>
        <StackPanel Classes="field" Width="85" Margin="0,0,8,6"><TextBlock Text="LENGTH m" Classes="fieldLabel" /><TextBox Text="{Binding Length}" /></StackPanel>
        <StackPanel Classes="field" Width="75" Margin="0,0,8,6"><TextBlock Text="GATES" Classes="fieldLabel" /><TextBox Text="{Binding Gates}" /></StackPanel>
        <StackPanel Classes="field" Width="75" Margin="0,0,8,6"><TextBlock Text="TURNS" Classes="fieldLabel" /><TextBox Text="{Binding TurningGates}" /></StackPanel>
        <StackPanel Classes="field" Width="100" Margin="0,0,8,6"><TextBlock Text="START HH:mm" Classes="fieldLabel" /><TextBox Text="{Binding StartTime}" Watermark="10:00" /></StackPanel>
      </WrapPanel>
      <WrapPanel>
        <TextBlock Text="COURSE SETTER" Classes="fieldLabel" VerticalAlignment="Center" Width="130" />
        <TextBox Text="{Binding Setter.FirstName}" Watermark="First name" Width="180" Margin="0,0,8,0" />
        <TextBox Text="{Binding Setter.LastName}" Watermark="Surname" Width="180" Margin="0,0,8,0" />
        <TextBox Text="{Binding Setter.Nation}" Watermark="NAT" Width="80" MaxLength="3" />
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="FORERUNNERS" Classes="fieldLabel" VerticalAlignment="Center" Width="130" />
        <Button Content="+ Add" Command="{Binding AddForerunnerCommand}" Classes="secondaryAction" />
        <Button Content="Remove selected" Command="{Binding RemoveForerunnerCommand}" Classes="secondaryAction" />
        <TextBlock Text="{Binding Forerunners.Count, StringFormat='{}{0} entered'}" VerticalAlignment="Center" />
      </StackPanel>
      <DataGrid Classes="raceGrid" ItemsSource="{Binding Forerunners}" SelectedItem="{Binding SelectedForerunner}"
                AutoGenerateColumns="False" MinHeight="62" MaxHeight="230" RowHeight="28" ColumnHeaderHeight="28">
        <DataGrid.Columns>
          <DataGridTextColumn Header="ID" Binding="{Binding Letter}" Width="85" />
          <DataGridTextColumn Header="FIRST NAME" Binding="{Binding FirstName}" Width="*" />
          <DataGridTextColumn Header="SURNAME" Binding="{Binding LastName}" Width="*" />
          <DataGridTextColumn Header="NAT" Binding="{Binding Nation}" Width="90" />
        </DataGrid.Columns>
      </DataGrid>
      <WrapPanel>
        <StackPanel Classes="field" Width="180" Margin="0,0,8,0"><TextBlock Text="CONDITIONS" Classes="fieldLabel" /><TextBox Text="{Binding Conditions}" Watermark="Clear" /></StackPanel>
        <StackPanel Classes="field" Width="180" Margin="0,0,8,0"><TextBlock Text="SNOW" Classes="fieldLabel" /><TextBox Text="{Binding Snow}" Watermark="Hard" /></StackPanel>
        <StackPanel Classes="field" Width="135" Margin="0,0,8,0"><TextBlock Text="AIR START °C" Classes="fieldLabel" /><TextBox Text="{Binding StartTemperature}" Watermark="Measured" /></StackPanel>
        <StackPanel Classes="field" Width="135"><TextBlock Text="AIR FINISH °C" Classes="fieldLabel" /><TextBox Text="{Binding FinishTemperature}" Watermark="Measured" /></StackPanel>
        <StackPanel Classes="field" Width="170" Margin="8,0,0,0"><TextBlock Text="AIR °C · PLACE UNSPECIFIED" Classes="fieldLabel" /><TextBox Text="{Binding UnlocatedTemperature}" Watermark="Measured" /></StackPanel>
      </WrapPanel>
      <TextBlock Text="{Binding WeatherSource}" Classes="supportingText" TextWrapping="Wrap" />
    </StackPanel>
  </Border>
</UserControl>
