<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:OpenSkiTime.Rewrite.Desktop"
             x:Class="OpenSkiTime.Rewrite.Desktop.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <local:GenderLabelConverter x:Key="GenderLabelConverter" />
    <SolidColorBrush x:Key="CanvasBrush">#EAF0F2</SolidColorBrush>
    <SolidColorBrush x:Key="SurfaceBrush">#FFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="SubtleSurfaceBrush">#F5F8F9</SolidColorBrush>
    <SolidColorBrush x:Key="NavyBrush">#102F3B</SolidColorBrush>
    <SolidColorBrush x:Key="NavyRaisedBrush">#1B4050</SolidColorBrush>
    <SolidColorBrush x:Key="BorderBrush">#CDDCE1</SolidColorBrush>
    <SolidColorBrush x:Key="LineBrush">#DFE8EB</SolidColorBrush>
    <SolidColorBrush x:Key="TextBrush">#193845</SolidColorBrush>
    <SolidColorBrush x:Key="MutedTextBrush">#58717C</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#087E78</SolidColorBrush>
    <SolidColorBrush x:Key="AccentHoverBrush">#086F6A</SolidColorBrush>
    <SolidColorBrush x:Key="AccentTintBrush">#E1F1EF</SolidColorBrush>
    <SolidColorBrush x:Key="SuccessBrush">#238067</SolidColorBrush>
    <SolidColorBrush x:Key="WarningBrush">#A96A20</SolidColorBrush>
    <SolidColorBrush x:Key="PendingCellBrush">#FFF0B8</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorBrush">#A63D3D</SolidColorBrush>
    <SolidColorBrush x:Key="ErrorTintBrush">#FCEDEC</SolidColorBrush>
    <SolidColorBrush x:Key="SelectionBrush">#D8ECE9</SolidColorBrush>
    <SolidColorBrush x:Key="FocusBrush">#088A84</SolidColorBrush>
    <Thickness x:Key="PageInset">22,18,22,22</Thickness>
    <Thickness x:Key="SectionInset">20,16</Thickness>
    <CornerRadius x:Key="SurfaceRadius">6</CornerRadius>
    <CornerRadius x:Key="ControlRadius">4</CornerRadius>
    <x:Double x:Key="TitleSize">19</x:Double>
    <x:Double x:Key="SectionSize">16</x:Double>
    <x:Double x:Key="BodySize">12</x:Double>
    <x:Double x:Key="MetaSize">10</x:Double>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

    <Style Selector="Border.workSurface">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource SurfaceRadius}" />
    </Style>
    <Style Selector="Border.subtleSurface">
      <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
    </Style>
    <Style Selector="TextBlock.sectionTitle">
      <Setter Property="FontSize" Value="{DynamicResource SectionSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.eyebrow">
      <Setter Property="FontSize" Value="{DynamicResource MetaSize}" />
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="TextBlock.supportingText">
      <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="StackPanel.field">
      <Setter Property="Spacing" Value="5" />
    </Style>
    <Style Selector="TextBlock.fieldLabel">
      <Setter Property="FontSize" Value="{DynamicResource MetaSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="Button.sectionNav">
      <Setter Property="MinHeight" Value="31" />
      <Setter Property="Padding" Value="13,5" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0,0,0,2" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.sectionNav:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
    </Style>
    <Style Selector="Button.sectionNav.active">
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="TextBox">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="9,6" />
      <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
    </Style>
    <Style Selector="TextBox:pointerover">
      <Setter Property="BorderBrush" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="TextBox:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="TextBox:disabled">
      <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="TextBlock.gridCell">
      <Setter Property="Padding" Value="6,5" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.gridCell.changed">
      <Setter Property="Background" Value="{DynamicResource PendingCellBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="CheckBox.entryCell.changed">
      <Setter Property="Background" Value="{DynamicResource PendingCellBrush}" />
    </Style>
    <Style Selector="ComboBox, NumericUpDown">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
    </Style>
    <Style Selector="ComboBox:focus, NumericUpDown:focus">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
    </Style>

    <Style Selector="Button.primaryAction, Button.secondaryAction, Button.toolbarAction, Button.dangerAction, Button.dateAction">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,6" />
      <Setter Property="CornerRadius" Value="{DynamicResource ControlRadius}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="FontSize" Value="{DynamicResource BodySize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primaryAction">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primaryAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
    </Style>
    <Style Selector="Button.primaryAction:pressed">
      <Setter Property="Background" Value="{DynamicResource NavyBrush}" />
    </Style>
    <Style Selector="Button.secondaryAction, Button.dateAction">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.secondaryAction:pointerover, Button.dateAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource AccentTintBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.toolbarAction">
      <Setter Property="Background" Value="{DynamicResource NavyRaisedBrush}" />
      <Setter Property="BorderBrush" Value="#41616B" />
      <Setter Property="Foreground" Value="#E6F3F4" />
    </Style>
    <Style Selector="Button.toolbarAction:pointerover">
      <Setter Property="Background" Value="#285365" />
    </Style>
    <Style Selector="Button.dangerAction">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#D8BCBC" />
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
    <Style Selector="Button.dangerAction:pointerover">
      <Setter Property="Background" Value="{DynamicResource ErrorTintBrush}" />
    </Style>
    <Style Selector="Button:focus-visible">
      <Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.52" />
    </Style>

    <Style Selector="DataGrid.raceGrid">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="DataGrid.raceGrid DataGridColumnHeader">
      <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
      <Setter Property="FontSize" Value="{DynamicResource MetaSize}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
    </Style>
    <Style Selector="DataGrid.raceGrid DataGridRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource SubtleSurfaceBrush}" />
    </Style>
    <Style Selector="DataGrid.raceGrid DataGridRow:selected">
      <Setter Property="Background" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="DataGrid.raceGrid DataGridRow:selected /template/ Border#RowBorder">
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style Selector="DataGrid.raceGrid DataGridRow:selected /template/ Rectangle#BackgroundRectangle">
      <Setter Property="Fill" Value="{DynamicResource SelectionBrush}" />
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="DataGrid.raceGrid DataGridCell:selected">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Border.statusBar">
      <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="Border.statusBar.error">
      <Setter Property="Background" Value="{DynamicResource ErrorTintBrush}" />
      <Setter Property="BorderBrush" Value="#E6BDBA" />
    </Style>
    <Style Selector="TextBlock.statusText">
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
    <Style Selector="TextBlock.statusText.error">
      <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
    </Style>
  </Application.Styles>
</Application>
