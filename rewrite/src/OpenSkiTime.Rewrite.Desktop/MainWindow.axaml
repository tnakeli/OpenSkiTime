<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenSkiTime.Rewrite.Desktop.MainWindow" x:CompileBindings="False"
        Title="OpenSkiTime" Width="1280" Height="820" MinWidth="980" MinHeight="680"
        Background="{DynamicResource CanvasBrush}">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Background="{DynamicResource NavyBrush}" Padding="22,11">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="30" Height="30" Background="{DynamicResource AccentBrush}" CornerRadius="4">
            <TextBlock Text="O" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White" />
          </Border>
          <StackPanel Spacing="0" VerticalAlignment="Center">
            <TextBlock Text="OpenSkiTime" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold" Foreground="White" />
            <TextBlock Text="RACE OFFICE  /  LOCAL WORKSPACE" FontSize="{DynamicResource MetaSize}" FontWeight="SemiBold" Foreground="#9CC0C7" />
          </StackPanel>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Content="New series" Command="{Binding NewSeriesCommand}" Classes="toolbarAction" />
          <Button Content="Open file" Command="{Binding OpenSeriesCommand}" Classes="toolbarAction" />
          <Border Width="1" Background="#42606A" Margin="4,6" />
          <Button Content="Backup / transfer" Command="{Binding BackupCommand}" IsEnabled="{Binding IsOpen}" Classes="toolbarAction" />
          <Button Content="Close file" Command="{Binding CloseSeriesCommand}" IsEnabled="{Binding IsOpen}" Classes="toolbarAction" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,7">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="1  Event series" Command="{Binding ShowSeriesCommand}" Click="Navigation_Click" Classes="sectionNav" Classes.active="{Binding IsSeriesSection}" />
        <Button Content="2  Competitions" Command="{Binding ShowCompetitionsCommand}" Click="Navigation_Click" IsEnabled="{Binding CanEditCompetitions}" Classes="sectionNav" Classes.active="{Binding IsCompetitionsSection}" />
        <Button Content="3  Competitors" Command="{Binding ShowCompetitorsCommand}" Click="Navigation_Click" IsEnabled="{Binding CanEditCompetitions}" Classes="sectionNav" Classes.active="{Binding IsCompetitorsSection}" />
        <TextBlock Text="{Binding FileLabel}" MaxWidth="390" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding FileLabel}"
                   Classes="supportingText" VerticalAlignment="Center" Margin="16,0,0,0" />
      </StackPanel>
    </Border>
    <ScrollViewer Name="WorkspaceScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="{DynamicResource PageInset}" Spacing="12" MaxWidth="1280" HorizontalAlignment="Center">
        <Border Classes="workSurface" Padding="{DynamicResource SectionInset}" IsVisible="{Binding IsSeriesSection}">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="1">
                <TextBlock Text="WORKSPACE / SERIES" Classes="eyebrow" />
                <TextBlock Text="Event series" Classes="sectionTitle" />
              </StackPanel>
              <Border Grid.Column="1" Classes="subtleSurface" Padding="10,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding IsOpen}" />
                  <TextBlock Text="EVENT FILE" Classes="eyebrow" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding FileLabel}" ToolTip.Tip="{Binding FileLabel}" MaxWidth="390"
                             TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="2*,12,2*,12,2*,12,100,12,110">
                <StackPanel Grid.Column="0" Classes="field">
                  <TextBlock Text="SERIES NAME *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Name}" Watermark="Weekend name" />
                </StackPanel>
                <StackPanel Grid.Column="2" Classes="field">
                  <TextBlock Text="LOCATION *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Location}" Watermark="Venue" />
                </StackPanel>
                <StackPanel Grid.Column="4" Classes="field">
                  <TextBlock Text="ORGANIZER *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Organizer}" Watermark="Organizing club" />
                </StackPanel>
                <StackPanel Grid.Column="6" Classes="field">
                  <TextBlock Text="NATION *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Nation}" MaxLength="3" />
                </StackPanel>
                <StackPanel Grid.Column="8" Classes="field">
                  <TextBlock Text="SEASON *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Season}" Watermark="2026–27" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Classes="field" Width="232">
                  <TextBlock Text="START DATE *  ·  DD.MM.YYYY" Classes="fieldLabel" />
                  <Grid ColumnDefinitions="*,8,42">
                    <TextBox Name="SeriesStartDateInput" Text="{Binding StartDateText}" Watermark="dd.mm.yyyy" MaxLength="10" />
                    <Button Name="SeriesStartDatePickerButton" Grid.Column="2" ToolTip.Tip="Choose start date" Click="DatePickerButton_Click" Classes="dateAction">
                      <Path Width="15" Height="15" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                            Data="M2,4 L13,4 13,13 2,13 Z M2,7 L13,7 M5,2 L5,5 M10,2 L10,5" />
                    </Button>
                  </Grid>
                </StackPanel>
                <StackPanel Classes="field" Width="232">
                  <TextBlock Text="END DATE *  ·  DD.MM.YYYY" Classes="fieldLabel" />
                  <Grid ColumnDefinitions="*,8,42">
                    <TextBox Name="SeriesEndDateInput" Text="{Binding EndDateText}" Watermark="dd.mm.yyyy" MaxLength="10" />
                    <Button Name="SeriesEndDatePickerButton" Grid.Column="2" ToolTip.Tip="Choose end date" Click="DatePickerButton_Click" Classes="dateAction">
                      <Path Width="15" Height="15" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                            Data="M2,4 L13,4 13,13 2,13 Z M2,7 L13,7 M5,2 L5,5 M10,2 L10,5" />
                    </Button>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Create series file" Command="{Binding CreateSeriesCommand}" IsVisible="{Binding IsCreatingNew}" Classes="primaryAction" />
              <Button Content="Cancel" Command="{Binding CancelNewSeriesCommand}" IsVisible="{Binding IsCreatingNew}" Classes="secondaryAction" />
              <Button Content="Save series" Command="{Binding SaveSeriesCommand}" IsVisible="{Binding IsEditingSeries}" Classes="primaryAction" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="workSurface" Padding="{DynamicResource SectionInset}" IsVisible="{Binding IsCompetitionsSection}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="1">
                <TextBlock Text="SERIES / RACES" Classes="eyebrow" />
                <TextBlock Text="Competitions" Classes="sectionTitle" />
              </StackPanel>
              <Button Grid.Column="1" Content="Add competition" Command="{Binding NewCompetitionCommand}" Classes="primaryAction" />
            </Grid>
            <DataGrid Classes="raceGrid" ItemsSource="{Binding Competitions}" SelectedItem="{Binding SelectedCompetition}" AutoGenerateColumns="False"
                      IsReadOnly="True" MinHeight="86" MaxHeight="210" RowHeight="36" ColumnHeaderHeight="30"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="{DynamicResource LineBrush}">
              <DataGrid.Resources>
                <StaticResource x:Key="DataGridRowSelectedBackgroundBrush" ResourceKey="SelectionBrush" />
                <StaticResource x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" ResourceKey="SelectionBrush" />
                <StaticResource x:Key="DataGridRowSelectedHoveredBackgroundBrush" ResourceKey="SelectionBrush" />
                <StaticResource x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" ResourceKey="SelectionBrush" />
                <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
                <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
                <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
                <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
              </DataGrid.Resources>
              <DataGrid.Columns>
                <DataGridTextColumn Header="DATE" Binding="{Binding Values.Date}" Width="130" />
                <DataGridTextColumn Header="ID" Binding="{Binding Values.ShortLabel}" Width="150" />
                <DataGridTextColumn Header="COMPETITION" Binding="{Binding Values.Name}" Width="*" />
                <DataGridTextColumn Header="DISCIPLINE" Binding="{Binding Values.Discipline}" Width="135" />
                <DataGridTextColumn Header="RUNS" Binding="{Binding Values.RunCount}" Width="80" />
              </DataGrid.Columns>
            </DataGrid>
            <Border Classes="subtleSurface" Padding="16,13" IsVisible="{Binding IsCompetitionEditing}">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="ACTIVE RACE / DETAILS" Classes="eyebrow" />
                    <TextBlock Text="{Binding CompetitionEditorTitle}" Classes="sectionTitle" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource AccentTintBrush}" CornerRadius="3" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CompetitionShortLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                  </Border>
                </Grid>
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="2*,12,*,12,232">
                    <StackPanel Grid.Column="0" Classes="field">
                      <TextBlock Text="NAME *" Classes="fieldLabel" />
                      <TextBox Text="{Binding CompetitionName}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="field">
                      <TextBlock Text="SHORT LABEL *" Classes="fieldLabel" />
                      <TextBox Text="{Binding CompetitionShortLabel}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Classes="field">
                      <TextBlock Text="DATE *  ·  DD.MM.YYYY" Classes="fieldLabel" />
                      <Grid ColumnDefinitions="*,8,42">
                        <TextBox Name="CompetitionDateInput" Text="{Binding CompetitionDateText}" Watermark="dd.mm.yyyy" MaxLength="10" />
                        <Button Name="CompetitionDatePickerButton" Grid.Column="2" ToolTip.Tip="Choose competition date" Click="DatePickerButton_Click" Classes="dateAction">
                          <Path Width="15" Height="15" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                                Data="M2,4 L13,4 13,13 2,13 Z M2,7 L13,7 M5,2 L5,5 M10,2 L10,5" />
                        </Button>
                      </Grid>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="2*,12,2*,12,120,12,150">
                    <StackPanel Grid.Column="0" Classes="field">
                      <TextBlock Text="DISCIPLINE" Classes="fieldLabel" />
                      <ComboBox ItemsSource="{Binding Disciplines}" SelectedItem="{Binding CompetitionDiscipline}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="field">
                      <TextBlock Text="RACE TYPE" Classes="fieldLabel" />
                      <ComboBox ItemsSource="{Binding RaceTypes}" SelectedItem="{Binding CompetitionRaceType}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Classes="field">
                      <TextBlock Text="RUNS" Classes="fieldLabel" />
                      <NumericUpDown Value="{Binding CompetitionRunCount}" Minimum="1" Maximum="9" FormatString="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="6" Classes="field">
                      <TextBlock Text="INTERMEDIATES" Classes="fieldLabel" />
                      <NumericUpDown Value="{Binding CompetitionIntermediateCount}" Minimum="0" Maximum="20" FormatString="0" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,12,*">
                    <StackPanel Grid.Column="0" Classes="field">
                      <TextBlock Text="FIS CODE" Classes="fieldLabel" />
                      <TextBox Text="{Binding CompetitionFisCode}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="field">
                      <TextBlock Text="LOCAL RACE CODE" Classes="fieldLabel" />
                      <TextBox Text="{Binding CompetitionLocalRaceCode}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <Expander Header="Course and homologation details" HorizontalAlignment="Stretch">
                  <StackPanel Margin="0,10,0,2" Spacing="12">
                    <Grid ColumnDefinitions="2*,12,*">
                      <StackPanel Grid.Column="0" Classes="field">
                        <TextBlock Text="COURSE" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionCourseName}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Classes="field">
                        <TextBlock Text="HOMOLOGATION" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionHomologation}" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*,12,*">
                      <StackPanel Grid.Column="0" Classes="field">
                        <TextBlock Text="START ALTITUDE · M" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionStartAltitude}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Classes="field">
                        <TextBlock Text="FINISH ALTITUDE · M" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionFinishAltitude}" />
                      </StackPanel>
                      <StackPanel Grid.Column="4" Classes="field">
                        <TextBlock Text="VERTICAL DROP · M" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionVerticalDrop}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Expander>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Save competition" Command="{Binding SaveCompetitionCommand}" Classes="primaryAction" />
                  <Button Content="Remove competition" Command="{Binding RemoveCompetitionCommand}" Classes="dangerAction" IsVisible="{Binding SelectedCompetition}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="workSurface" Padding="{DynamicResource SectionInset}" IsVisible="{Binding IsCompetitorsSection}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="1">
                <TextBlock Text="SERIES / REGISTRATION" Classes="eyebrow" />
                <TextBlock Text="{Binding CompetitorSectionTitle}" Classes="sectionTitle" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsVisible="{Binding IsCompetitorDeskVisible}">
                <Button Content="Add competitor" Command="{Binding AddCompetitorCommand}" Classes="primaryAction" />
                <Button Content="Save row" Command="{Binding SaveSelectedCompetitorCommand}" Classes="secondaryAction" />
                <Button Content="Discard draft" Command="{Binding DiscardCompetitorDraftCommand}" Classes="secondaryAction" />
                <Button Content="Undo saved" Command="{Binding UndoDeskEditCommand}" IsEnabled="{Binding CanUndoDeskEdit}" Classes="secondaryAction" />
                <Button Content="Remove competitor" Command="{Binding RemoveCompetitorCommand}" IsEnabled="{Binding SelectedCompetitorRow}" Classes="dangerAction" />
              </StackPanel>
            </Grid>
            <StackPanel Spacing="12" IsVisible="{Binding IsCompetitorDeskVisible}">
            <Grid ColumnDefinitions="*,12,170,12,190">
              <TextBox Name="CompetitorFilterInput" Text="{Binding CompetitorFilterText}" Watermark="Filter names, club, code or category" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding CompetitorGroupings}" SelectedItem="{Binding CompetitorGrouping}" />
              <ComboBox Grid.Column="4" ItemsSource="{Binding Competitions}" SelectedItem="{Binding DeskCompetition}">
                <ComboBox.ItemTemplate>
                  <DataTemplate><TextBlock Text="{Binding Values.ShortLabel}" /></DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </Grid>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Button Content="Paste from Excel" Command="{Binding PasteFromExcelCommand}" Classes="secondaryAction" />
              <Button Content="Copy selection" Command="{Binding CopySelectedCompetitorCommand}" Classes="secondaryAction" />
              <Button Content="Export selection TSV" Command="{Binding ExportSelectedTsvCommand}" Classes="secondaryAction" />
              <TextBlock Text="Paste opens a separate review; only Commit writes imported changes."
                         Classes="supportingText" VerticalAlignment="Center" Margin="8,0,0,0" />
            </StackPanel>
            <TextBlock Text="Entry and imported bib refer to the selected competition. Birth year and gender suggest a category; drawing race bibs comes later."
                       Classes="supportingText" FontSize="11" />
            <DataGrid Name="CompetitorGrid" Classes="raceGrid" ItemsSource="{Binding VisibleCompetitors}"
                      SelectedItem="{Binding SelectedCompetitorRow}" SelectionMode="Extended" SelectionChanged="CompetitorGrid_SelectionChanged"
                      AutoGenerateColumns="False" IsReadOnly="False"
                      MinHeight="160" MaxHeight="420" RowHeight="34" ColumnHeaderHeight="30"
                      RowEditEnded="CompetitorGrid_RowEditEnded" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
              <DataGrid.Columns>
                <DataGridTextColumn Header="SURNAME" Binding="{Binding Surname}" Width="150" />
                <DataGridTextColumn Header="FIRST NAME" Binding="{Binding FirstName}" Width="120" />
                <DataGridTextColumn Header="YEAR" Binding="{Binding BirthYearText}" Width="68" />
                <DataGridTextColumn Header="GENDER" Binding="{Binding GenderText}" Width="82" />
                <DataGridTextColumn Header="NAT" Binding="{Binding Nation}" Width="65" />
                <DataGridTextColumn Header="CLUB" Binding="{Binding Club}" Width="130" />
                <DataGridTextColumn Header="FED ID" Binding="{Binding FederationCode}" Width="100" />
                <DataGridCheckBoxColumn Header="IN" Binding="{Binding IsParticipating}" Width="65" />
                <DataGridTextColumn Header="BIB REF" Binding="{Binding ImportedBibText}" Width="95" />
                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" IsReadOnly="True" Width="120" />
                <DataGridTextColumn Header="STATUS" Binding="{Binding Readiness}" IsReadOnly="True" Width="170" />
              </DataGrid.Columns>
            </DataGrid>
            <Border Classes="subtleSurface" Padding="12,10" IsVisible="{Binding SelectedCompetitorRow}">
              <StackPanel Spacing="7">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Selected competitor · competitions entered" Classes="fieldLabel" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="Tick to save participation" Classes="supportingText" FontSize="11" />
                </Grid>
                <ScrollViewer MaxHeight="144">
                  <ItemsControl Name="ParticipationChoicesList" ItemsSource="{Binding ParticipationChoices}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Grid ColumnDefinitions="32,100,*,120" Margin="0,2">
                          <CheckBox IsChecked="{Binding IsParticipating}" IsEnabled="{Binding !IsSaving}" Click="Participation_Click" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding ImportedBib, StringFormat='Bib ref: {0}'}"
                                     Classes="supportingText" VerticalAlignment="Center" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </ScrollViewer>
              </StackPanel>
            </Border>
            <Expander Header="Category rules · birth-year range and gender" HorizontalAlignment="Stretch">
              <StackPanel Margin="0,10,0,2" Spacing="10">
                <DataGrid Classes="raceGrid" ItemsSource="{Binding CategoryRules}" SelectedItem="{Binding SelectedCategoryRule}"
                          AutoGenerateColumns="False" IsReadOnly="True" MinHeight="70" MaxHeight="150"
                          RowHeight="32" ColumnHeaderHeight="28" HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Values.Label}" Width="*" />
                    <DataGridTextColumn Header="FROM YEAR" Binding="{Binding Values.BirthYearMin}" Width="110" />
                    <DataGridTextColumn Header="TO YEAR" Binding="{Binding Values.BirthYearMax}" Width="110" />
                    <DataGridTextColumn Header="GENDER" Binding="{Binding Values.Gender}" Width="110" />
                    <DataGridTextColumn Header="ORDER" Binding="{Binding Values.DisplayOrder}" Width="90" />
                  </DataGrid.Columns>
                </DataGrid>
                <Grid ColumnDefinitions="2*,10,100,10,100,10,120,10,90">
                  <StackPanel Grid.Column="0" Classes="field"><TextBlock Text="LABEL" Classes="fieldLabel" /><TextBox Text="{Binding CategoryLabel}" /></StackPanel>
                  <StackPanel Grid.Column="2" Classes="field"><TextBlock Text="FROM YEAR" Classes="fieldLabel" /><TextBox Text="{Binding CategoryMinYearText}" /></StackPanel>
                  <StackPanel Grid.Column="4" Classes="field"><TextBlock Text="TO YEAR" Classes="fieldLabel" /><TextBox Text="{Binding CategoryMaxYearText}" /></StackPanel>
                  <StackPanel Grid.Column="6" Classes="field"><TextBlock Text="GENDER · F/M/O" Classes="fieldLabel" /><TextBox Text="{Binding CategoryGenderText}" /></StackPanel>
                  <StackPanel Grid.Column="8" Classes="field"><TextBlock Text="ORDER" Classes="fieldLabel" /><TextBox Text="{Binding CategoryOrderText}" /></StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="New rule" Command="{Binding NewCategoryRuleCommand}" Classes="secondaryAction" />
                  <Button Content="Save rule" Command="{Binding SaveCategoryRuleCommand}" Classes="primaryAction" />
                  <Button Content="Remove rule" Command="{Binding RemoveCategoryRuleCommand}" IsEnabled="{Binding SelectedCategoryRule}" Classes="dangerAction" />
                </StackPanel>
              </StackPanel>
            </Expander>
            </StackPanel>
            <StackPanel Spacing="12" IsVisible="{Binding IsImportReviewOpen}">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Text="{Binding ImportReviewSummary}" Classes="supportingText" VerticalAlignment="Center" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                  <Button Content="Reset review" Command="{Binding ResetImportReviewCommand}" Classes="secondaryAction" />
                  <Button Content="Close review" Command="{Binding CloseImportReviewCommand}" Classes="secondaryAction" />
                  <Button Content="Commit import" Command="{Binding CommitImportCommand}" Classes="primaryAction" />
                </StackPanel>
              </Grid>
              <TextBlock Text="Highlighted cells differ from saved data. Edit values here; X enters a race, 0 removes participation, blank preserves it. Use ~ to clear an optional value."
                         Classes="supportingText" TextWrapping="Wrap" />
              <DataGrid Name="ImportReviewGrid" Classes="raceGrid" ItemsSource="{Binding ImportReviewRows}"
                        SelectedItem="{Binding SelectedImportReviewRow}" AutoGenerateColumns="False" IsReadOnly="True"
                        MinHeight="180" MaxHeight="400" RowHeight="38" ColumnHeaderHeight="30">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="ROW" Binding="{Binding SourceRow}" Width="65" />
                  <DataGridTextColumn Header="MATCH" Binding="{Binding MatchNote}" Width="78" />
                  <DataGridTemplateColumn Header="SURNAME" Width="145"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Surname}" Classes="importCell" Classes.changed="{Binding IsSurnameChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="FIRST NAME" Width="115"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding FirstName}" Classes="importCell" Classes.changed="{Binding IsFirstNameChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="YEAR" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding BirthYearText}" Classes="importCell" Classes.changed="{Binding IsYearChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="GENDER" Width="82"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding GenderText}" Classes="importCell" Classes.changed="{Binding IsGenderChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="NAT" Width="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Nation}" Classes="importCell" Classes.changed="{Binding IsNationChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="CLUB" Width="125"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding Club}" Classes="importCell" Classes.changed="{Binding IsClubChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="FED ID" Width="95"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBox Text="{Binding FederationCode}" Classes="importCell" Classes.changed="{Binding IsCodeChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                  <DataGridTextColumn Header="CHANGES" Binding="{Binding Changes}" Width="*" />
                  <DataGridTemplateColumn Header="REVIEW" Width="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Approved}" IsVisible="{Binding NeedsApproval}" HorizontalAlignment="Center" /></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
              <TextBlock Text="{Binding SelectedImportReviewRow.WarningText}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
              <Border Classes="subtleSurface" Padding="12,10" IsVisible="{Binding SelectedImportReviewRow}">
                <StackPanel Spacing="8">
                  <TextBlock Text="Selected row · competition entries" Classes="fieldLabel" />
                  <ScrollViewer MaxHeight="170"><ItemsControl ItemsSource="{Binding SelectedImportReviewRow.Entries}">
                    <ItemsControl.ItemTemplate><DataTemplate>
                      <Grid ColumnDefinitions="100,*,155,85,100,90" Margin="0,2">
                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="{Binding Current}" Classes="supportingText" VerticalAlignment="Center" />
                        <TextBox Grid.Column="3" Text="{Binding ParticipationText}" Watermark="X / 0" />
                        <TextBlock Grid.Column="4" Text="Bib reference" Classes="supportingText" VerticalAlignment="Center" Margin="10,0,0,0" />
                        <TextBox Grid.Column="5" Text="{Binding BibText}" Watermark="blank" />
                      </Grid>
                    </DataTemplate></ItemsControl.ItemTemplate>
                  </ItemsControl></ScrollViewer>
                </StackPanel>
              </Border>
              <ItemsControl ItemsSource="{Binding ImportWarnings}"><ItemsControl.ItemTemplate><DataTemplate>
                <TextBlock Text="{Binding}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" />
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <Expander Header="Pasted source · edit and preview again" HorizontalAlignment="Stretch">
                <StackPanel Margin="0,8,0,0" Spacing="6">
                  <TextBox Text="{Binding ImportSourceText}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="90" MaxHeight="160" />
                  <Button Content="Preview source again" Command="{Binding PreviewImportCommand}" Classes="secondaryAction" HorizontalAlignment="Left" />
                </StackPanel>
              </Expander>
            </StackPanel>
            <Expander Header="Legacy conversion preview · read only" HorizontalAlignment="Stretch" IsVisible="{Binding IsCompetitorDeskVisible}">
              <StackPanel Margin="0,10,0,2" Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Button Content="Preview legacy file" Command="{Binding PreviewLegacyCommand}" Classes="secondaryAction" />
                  <TextBlock Text="{Binding LegacySnapshotLabel}" Classes="supportingText" TextTrimming="CharacterEllipsis"
                             MaxWidth="760" VerticalAlignment="Center" ToolTip.Tip="{Binding LegacySnapshotLabel}" />
                </StackPanel>
                <StackPanel Spacing="10" IsVisible="{Binding SelectedLegacySeries}">
                  <Grid ColumnDefinitions="300,12,*">
                    <ComboBox ItemsSource="{Binding LegacySeriesPreviews}" SelectedItem="{Binding SelectedLegacySeries}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate><TextBlock Text="{Binding Values.Name}" /></DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Column="2" Text="{Binding LegacyPreviewSummary}" Classes="supportingText" VerticalAlignment="Center" />
                  </Grid>
                  <DataGrid Classes="raceGrid" ItemsSource="{Binding SelectedLegacySeries.Competitors}" IsReadOnly="True"
                            AutoGenerateColumns="False" MinHeight="70" MaxHeight="170" RowHeight="30" ColumnHeaderHeight="28">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="SURNAME" Binding="{Binding Values.Surname}" Width="*" />
                      <DataGridTextColumn Header="FIRST NAME" Binding="{Binding Values.FirstName}" Width="*" />
                      <DataGridTextColumn Header="YEAR" Binding="{Binding Values.BirthYear}" Width="80" />
                      <DataGridTextColumn Header="GENDER" Binding="{Binding Values.Gender}" Width="100" />
                      <DataGridTextColumn Header="LEGACY BIB" Binding="{Binding SeriesBibReference}" Width="110" />
                      <DataGridTextColumn Header="CODE" Binding="{Binding Values.FederationCode}" Width="120" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <DataGrid Classes="raceGrid" ItemsSource="{Binding SelectedLegacySeries.Competitions}" IsReadOnly="True"
                            AutoGenerateColumns="False" MinHeight="65" MaxHeight="130" RowHeight="30" ColumnHeaderHeight="28">
                    <DataGrid.Columns>
                      <DataGridTextColumn Header="SHORT LABEL" Binding="{Binding Values.ShortLabel}" Width="120" />
                      <DataGridTextColumn Header="COMPETITION" Binding="{Binding Values.Name}" Width="*" />
                      <DataGridTextColumn Header="DATE" Binding="{Binding Values.Date}" Width="120" />
                      <DataGridTextColumn Header="DISCIPLINE" Binding="{Binding Values.Discipline}" Width="130" />
                    </DataGrid.Columns>
                  </DataGrid>
                  <ItemsControl ItemsSource="{Binding SelectedLegacySeries.Warnings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="11" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <ItemsControl ItemsSource="{Binding LegacySourceWarnings}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" FontSize="11" /></DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="This preview does not change either database. Conversion is a later milestone."
                             Classes="supportingText" />
                </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" Classes="statusBar" Classes.error="{Binding IsError}"
            BorderThickness="0,1,0,0" Padding="22,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsError}" />
        <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" IsVisible="{Binding IsError}" />
        <TextBlock Text="{Binding StatusMessage}" Classes="statusText" Classes.error="{Binding IsError}"
                   FontSize="11" TextWrapping="Wrap" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
