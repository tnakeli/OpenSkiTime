<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:OpenSkiTime.Rewrite.Desktop"
        x:Class="OpenSkiTime.Rewrite.Desktop.MainWindow" x:CompileBindings="False"
        Title="{Binding WindowTitle}" Width="1280" Height="820" MinWidth="980" MinHeight="680" WindowState="Maximized"
        Background="{DynamicResource CanvasBrush}">
  <Window.Resources>
    <local:HomologationDisplayConverter x:Key="HomologationDisplayConverter" />
  </Window.Resources>
  <Window.Styles>
    <Style Selector="DataGrid.columnControls DataGridColumnHeader">
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <!-- Our header supplies both icons; reclaim the native sort icon column. -->
    <Style Selector="DataGrid.columnControls DataGridColumnHeader /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.ColumnSpan" Value="2" />
    </Style>
    <Style Selector="Button.calendarHeader">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="24" />
      <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
    </Style>
  </Window.Styles>
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <Border Grid.Row="0" Background="{DynamicResource NavyBrush}" Padding="22,11">
      <Grid ColumnDefinitions="Auto,Auto,*,Auto">
        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Border Width="30" Height="30" Background="{DynamicResource AccentBrush}" CornerRadius="4">
            <TextBlock Text="O" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White" />
          </Border>
          <TextBlock Text="OpenSkiTime" FontSize="{DynamicResource TitleSize}" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
        </StackPanel>
        <Button Name="ActiveRaceButton" Grid.Column="1" Content="{Binding ActiveRaceLabel}" Click="ActiveRace_Click"
                IsVisible="{Binding IsOpen}" IsEnabled="{Binding CanEditCompetitions}" Classes="activeRace" HorizontalAlignment="Left"
                VerticalAlignment="Center" Margin="20,0,12,0" MaxWidth="260" ToolTip.Tip="Select competition and run" />
        <TextBlock Name="ActiveRaceNameText" Grid.Column="2" Text="{Binding ActiveRaceName}" ToolTip.Tip="{Binding ActiveRaceName}"
                   Foreground="White" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0" IsVisible="{Binding IsOpen}" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" IsEnabled="{Binding !IsDrawBusy}">
          <Button Content="New series" Command="{Binding NewSeriesCommand}" Classes="toolbarAction" />
          <SplitButton Name="OpenFileButton" Content="Open file" Command="{Binding OpenSeriesCommand}" Classes="toolbarAction">
            <SplitButton.Flyout>
              <MenuFlyout Placement="Bottom" />
            </SplitButton.Flyout>
          </SplitButton>
          <Border Width="1" Background="#42606A" Margin="4,6" />
          <Button Content="Backup / transfer" Command="{Binding BackupCommand}" IsEnabled="{Binding IsOpen}" Classes="toolbarAction" />
          <Button Content="Close file" Command="{Binding CloseSeriesCommand}" IsEnabled="{Binding IsOpen}" Classes="toolbarAction" />
          <Border Width="1" Background="#42606A" Margin="4,6" />
          <Button Content="Settings" Command="{Binding ShowSettingsCommand}" Classes="toolbarAction" />
        </StackPanel>
      </Grid>
    </Border>
    <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="22,7">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Content="1  Event series" Command="{Binding ShowSeriesCommand}" Click="Navigation_Click" Classes="sectionNav" Classes.active="{Binding IsSeriesSection}" />
        <Button Content="2  Competitions" Command="{Binding ShowCompetitionsCommand}" Click="Navigation_Click" IsEnabled="{Binding CanEditCompetitions}" Classes="sectionNav" Classes.active="{Binding IsCompetitionsSection}" />
        <Button Content="3  Competitors" Command="{Binding ShowCompetitorsCommand}" Click="Navigation_Click" IsEnabled="{Binding CanEditCompetitions}" Classes="sectionNav" Classes.active="{Binding IsCompetitorsSection}" />
        <Button Name="DrawMenuButton" Content="4  Start lists  ▾" Click="DrawMenu_Click" IsEnabled="{Binding CanEditCompetitions}" Classes="sectionNav" Classes.active="{Binding IsDrawSection}" />
        <Button Name="TimingMenuButton" Content="5  Timing  ▾" Click="TimingMenu_Click" IsEnabled="{Binding CanEditCompetitions}" Classes="sectionNav" Classes.active="{Binding IsTimingSection}" />
        <Button Content="6  Results" Command="{Binding ShowResultsCommand}" IsEnabled="{Binding CanEditCompetitions}" Classes="sectionNav" Classes.active="{Binding IsResultsSection}" />
      </StackPanel>
    </Border>
    <ScrollViewer Name="WorkspaceScroll" Grid.Row="2" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding IsFormSection}">
      <StackPanel Margin="{DynamicResource PageInset}" Spacing="12" HorizontalAlignment="Stretch">
        <Border Classes="workSurface" Padding="{DynamicResource SectionInset}" IsVisible="{Binding IsSeriesSection}">
          <StackPanel Spacing="14">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="1">
                <TextBlock Text="WORKSPACE / SERIES" Classes="eyebrow" />
                <TextBlock Text="Event series" Classes="sectionTitle" />
              </StackPanel>
              <Border Grid.Column="1" Classes="subtleSurface" Padding="10,5" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding IsOpen}" />
                  <TextBlock Text="EVENT FILE" Classes="eyebrow" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding FileLabel}" ToolTip.Tip="{Binding FileLabel}" MaxWidth="390"
                             TextTrimming="CharacterEllipsis" FontSize="11" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
            <Button Name="BrowseSeriesCalendarButton" Content="Browse FIS calendar" Command="{Binding BrowseSeriesCalendarCommand}" HorizontalAlignment="Left" Classes="secondaryAction" />
            <Border Classes="subtleSurface" Padding="12" IsVisible="{Binding IsSeriesCalendarOpen}">
              <StackPanel Spacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsSeriesCalendarBusy}">
                  <TextBlock Text="FIS SEASON" Classes="fieldLabel" VerticalAlignment="Center" />
                  <TextBox Width="90" Text="{Binding SeriesCalendarSeason}" />
                  <Button Content="Load calendar" Command="{Binding BrowseSeriesCalendarCommand}" />
                  <Button Content="Clear filters" Command="{Binding ClearCalendarFiltersCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding SeriesCalendarStatus}" Classes="supportingText" TextWrapping="Wrap" />
                <TextBlock Text="Import the event and its supported races. Existing course settings and missing values are preserved." Classes="supportingText" TextWrapping="Wrap" />
                <DataGrid Name="SeriesCalendarEventsGrid" Classes="raceGrid columnControls" ItemsSource="{Binding SeriesCalendarEvents}" SelectedItem="{Binding SelectedSeriesCalendarEvent}"
                          AutoGenerateColumns="False" IsReadOnly="True" Height="240" SelectionMode="Single" CanUserSortColumns="True" CanUserResizeColumns="True">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="START" SortMemberPath="Start" Binding="{Binding StartDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="110" />
                    <DataGridTextColumn Header="END" SortMemberPath="End" Binding="{Binding EndDate, StringFormat='{}{0:dd.MM.yyyy}'}" Width="110" />
                    <DataGridTextColumn Header="LOCATION" SortMemberPath="Location" Binding="{Binding Location}" Width="180" />
                    <DataGridTextColumn Header="NATION" SortMemberPath="Nation" Binding="{Binding Nation}" Width="110" />
                    <DataGridTextColumn Header="EVENT" SortMemberPath="Event" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="RACES" SortMemberPath="Races" Binding="{Binding CompetitionCount}" Width="100" />
                  </DataGrid.Columns>
                </DataGrid>
                <DataGrid Name="SeriesCalendarCompetitionsGrid" Classes="raceGrid" ItemsSource="{Binding SeriesCalendarCompetitions}" AutoGenerateColumns="False" IsReadOnly="True" Height="130">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="DATE" Binding="{Binding Date, StringFormat='{}{0:dd.MM.yyyy}'}" Width="110" />
                    <DataGridTextColumn Header="CODEX" Binding="{Binding FisCode}" Width="85" />
                    <DataGridTextColumn Header="DISCIPLINE" Binding="{Binding Discipline}" Width="140" />
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Calendar.Category}" Width="100" />
                    <DataGridTextColumn Header="GENDER" Binding="{Binding Calendar.Gender}" Width="85" />
                    <DataGridTextColumn Header="TD SURNAME" Binding="{Binding Calendar.TechnicalDelegate.LastName}" Width="160" />
                    <DataGridTextColumn Header="TD FIRST NAME" Binding="{Binding Calendar.TechnicalDelegate.FirstName}" Width="140" />
                    <DataGridTextColumn Header="TD NATION" Binding="{Binding Calendar.TechnicalDelegate.Nation}" Width="95" />
                    <DataGridTextColumn Header="TD NUMBER" Binding="{Binding Calendar.TechnicalDelegate.Number}" Width="95" />
                  </DataGrid.Columns>
                </DataGrid>
                <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding !IsSeriesCalendarBusy}">
                  <Button Name="UseSeriesCalendarEventButton" Content="Use selected event" Command="{Binding UseSeriesCalendarEventCommand}" Classes="primaryAction" />
                  <Button Content="Close calendar" Command="{Binding CloseSeriesCalendarCommand}" Classes="secondaryAction" />
                </StackPanel>
              </StackPanel>
            </Border>
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="2*,12,2*,12,2*,12,100,12,110">
                <StackPanel Grid.Column="0" Classes="field">
                  <TextBlock Text="SERIES NAME *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Name}" Watermark="Weekend name" />
                </StackPanel>
                <StackPanel Grid.Column="2" Classes="field">
                  <TextBlock Text="LOCATION *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Location}" Watermark="Venue" />
                </StackPanel>
                <StackPanel Grid.Column="4" Classes="field">
                  <TextBlock Text="ORGANIZER *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Organizer}" Watermark="Organizing club" />
                </StackPanel>
                <StackPanel Grid.Column="6" Classes="field">
                  <TextBlock Text="NATION *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Nation}" MaxLength="3" />
                </StackPanel>
                <StackPanel Grid.Column="8" Classes="field">
                  <TextBlock Text="SEASON *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Season}" Watermark="2026–27" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="12">
                <StackPanel Classes="field" Width="232">
                  <TextBlock Text="START DATE *  ·  DD.MM.YYYY" Classes="fieldLabel" />
                  <Grid ColumnDefinitions="*,8,42">
                    <TextBox Name="SeriesStartDateInput" Text="{Binding StartDateText}" Watermark="dd.mm.yyyy" MaxLength="10" />
                    <Button Name="SeriesStartDatePickerButton" Grid.Column="2" ToolTip.Tip="Choose start date" Click="DatePickerButton_Click" Classes="dateAction">
                      <Path Width="15" Height="15" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                            Data="M2,4 L13,4 13,13 2,13 Z M2,7 L13,7 M5,2 L5,5 M10,2 L10,5" />
                    </Button>
                  </Grid>
                </StackPanel>
                <StackPanel Classes="field" Width="232">
                  <TextBlock Text="END DATE *  ·  DD.MM.YYYY" Classes="fieldLabel" />
                  <Grid ColumnDefinitions="*,8,42">
                    <TextBox Name="SeriesEndDateInput" Text="{Binding EndDateText}" Watermark="dd.mm.yyyy" MaxLength="10" />
                    <Button Name="SeriesEndDatePickerButton" Grid.Column="2" ToolTip.Tip="Choose end date" Click="DatePickerButton_Click" Classes="dateAction">
                      <Path Width="15" Height="15" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                            Data="M2,4 L13,4 13,13 2,13 Z M2,7 L13,7 M5,2 L5,5 M10,2 L10,5" />
                    </Button>
                  </Grid>
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Create series file" Command="{Binding CreateSeriesCommand}" IsVisible="{Binding IsCreatingNew}" Classes="primaryAction" />
              <Button Content="Cancel" Command="{Binding CancelNewSeriesCommand}" IsVisible="{Binding IsCreatingNew}" Classes="secondaryAction" />
              <Button Content="Save series" Command="{Binding SaveSeriesCommand}" IsVisible="{Binding IsEditingSeries}" Classes="primaryAction" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Classes="workSurface" Padding="{DynamicResource SectionInset}" IsVisible="{Binding IsCompetitionsSection}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <Button Grid.Column="1" Content="Add competition" Command="{Binding NewCompetitionCommand}" Classes="primaryAction" />
            </Grid>
            <DataGrid Name="CompetitionsGrid" Classes="raceGrid columnControls" ItemsSource="{Binding CompetitionView}" SelectedItem="{Binding SelectedCompetition}" AutoGenerateColumns="False"
                      SelectionMode="Single"
                      IsReadOnly="True" MinHeight="86" MaxHeight="210" RowHeight="36" ColumnHeaderHeight="30"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" HorizontalGridLinesBrush="{DynamicResource LineBrush}">
              <DataGrid.Resources>
                <StaticResource x:Key="DataGridRowSelectedBackgroundBrush" ResourceKey="SelectionBrush" />
                <StaticResource x:Key="DataGridRowSelectedUnfocusedBackgroundBrush" ResourceKey="SelectionBrush" />
                <StaticResource x:Key="DataGridRowSelectedHoveredBackgroundBrush" ResourceKey="SelectionBrush" />
                <StaticResource x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundBrush" ResourceKey="SelectionBrush" />
                <x:Double x:Key="DataGridRowSelectedBackgroundOpacity">1</x:Double>
                <x:Double x:Key="DataGridRowSelectedUnfocusedBackgroundOpacity">1</x:Double>
                <x:Double x:Key="DataGridRowSelectedHoveredBackgroundOpacity">1</x:Double>
                <x:Double x:Key="DataGridRowSelectedHoveredUnfocusedBackgroundOpacity">1</x:Double>
              </DataGrid.Resources>
              <DataGrid.Columns>
                <DataGridTextColumn Header="" Binding="{Binding ImportMarker}" IsReadOnly="True" Width="48" />
                <DataGridTextColumn Header="DATE" Binding="{Binding Values.Date, StringFormat='{}{0:dd.MM.yyyy}'}" Width="105" />
                <DataGridTextColumn Header="COMPETITION" Binding="{Binding Values.ShortLabel}" Width="150" />
                <DataGridTextColumn Header="EVENT NAME" Binding="{Binding Values.Name}" Width="*" MinWidth="160" />
                <DataGridTextColumn Header="DISCIPLINE" Binding="{Binding Values.Discipline}" Width="105" />
                <DataGridTextColumn Header="CODEX" Binding="{Binding Values.FisCode}" Width="90" />
                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Values.Calendar.Category}" Width="100" />
                <DataGridTextColumn Header="GENDER" Binding="{Binding Values.Calendar.Gender}" Width="85" />
                <DataGridTextColumn Header="LOCATION" Binding="{Binding Values.Calendar.Location}" Width="100" />
                <DataGridTextColumn Header="COURSE" Binding="{Binding Values.CourseName}" Width="105" />
                <DataGridTextColumn Header="HOMOLOGATION" Binding="{Binding Values, Converter={StaticResource HomologationDisplayConverter}}" Width="240" />
                <DataGridTextColumn Header="TD SURNAME" Binding="{Binding Values.Calendar.TechnicalDelegate.LastName}" Width="150" />
                <DataGridTextColumn Header="TD NUMBER" Binding="{Binding Values.Calendar.TechnicalDelegate.Number}" Width="110" />
                <DataGridTextColumn Header="RUNS" Binding="{Binding Values.RunCount}" Width="75" />
              </DataGrid.Columns>
            </DataGrid>
            <Border Classes="subtleSurface" Padding="16,13" IsVisible="{Binding IsCompetitionEditing}">
              <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Spacing="1">
                    <TextBlock Text="ACTIVE RACE / DETAILS" Classes="eyebrow" />
                    <TextBlock Text="{Binding CompetitionEditorTitle}" Classes="sectionTitle" />
                  </StackPanel>
                  <Border Grid.Column="1" Background="{DynamicResource AccentTintBrush}" CornerRadius="3" Padding="8,4" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CompetitionShortLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                  </Border>
                </Grid>
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="160,12,*,12,232">
                    <StackPanel Grid.Column="0" Classes="field">
                      <TextBlock Text="SHORT NAME *" Classes="fieldLabel" />
                      <TextBox Text="{Binding CompetitionShortLabel}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="field">
                      <TextBlock Text="EVENT NAME *" Classes="fieldLabel" />
                      <TextBox Text="{Binding CompetitionName}" ToolTip.Tip="Event name used in reports and result XML." />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Classes="field">
                      <TextBlock Text="DATE *  ·  DD.MM.YYYY" Classes="fieldLabel" />
                      <Grid ColumnDefinitions="*,8,42">
                        <TextBox Name="CompetitionDateInput" Text="{Binding CompetitionDateText}" Watermark="dd.mm.yyyy" MaxLength="10" />
                        <Button Name="CompetitionDatePickerButton" Grid.Column="2" ToolTip.Tip="Choose competition date" Click="DatePickerButton_Click" Classes="dateAction">
                          <Path Width="15" Height="15" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                                Data="M2,4 L13,4 13,13 2,13 Z M2,7 L13,7 M5,2 L5,5 M10,2 L10,5" />
                        </Button>
                      </Grid>
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="2*,12,2*,12,120,12,150">
                    <StackPanel Grid.Column="0" Classes="field">
                      <TextBlock Text="DISCIPLINE" Classes="fieldLabel" />
                      <ComboBox ItemsSource="{Binding Disciplines}" SelectedItem="{Binding CompetitionDiscipline}" />
                    </StackPanel>
                    <Grid Grid.Column="2" ColumnDefinitions="*,12,Auto">
                      <StackPanel Classes="field">
                        <TextBlock Text="FIS CATEGORY" Classes="fieldLabel" />
                        <TextBox Name="CompetitionCategoryInput" Text="{Binding CompetitionCalendarCategory, Mode=TwoWay}"
                                 IsEnabled="{Binding IsCompetitionFis}" Watermark="e.g. NJR, FIS, NC"
                                 ToolTip.Tip="Enter the FIS calendar category code. This is separate from the FIS rules setting." />
                      </StackPanel>
                      <CheckBox Name="CompetitionFisCheckBox" Grid.Column="2" Content="Use FIS rules" IsChecked="{Binding IsCompetitionFis}" VerticalAlignment="Bottom" MinHeight="34" />
                    </Grid>
                    <StackPanel Grid.Column="4" Classes="field">
                      <TextBlock Text="RUNS" Classes="fieldLabel" />
                      <NumericUpDown Value="{Binding CompetitionRunCount}" Minimum="1" Maximum="9" FormatString="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="6" Classes="field">
                      <TextBlock Text="INTERMEDIATES" Classes="fieldLabel" />
                      <NumericUpDown Value="{Binding CompetitionIntermediateCount}" Minimum="0" Maximum="20" FormatString="0" />
                    </StackPanel>
                  </Grid>
                  <StackPanel IsVisible="{Binding IsCompetitionFis}" Spacing="10">
                    <WrapPanel>
                      <StackPanel Name="CompetitionFisCodeField" Classes="field" IsVisible="{Binding IsCompetitionFis}" Width="180" Margin="0,0,10,0">
                        <TextBlock Text="FIS CODEX" Classes="fieldLabel" /><TextBox Text="{Binding CompetitionFisCode}" />
                      </StackPanel>
                      <StackPanel Classes="field" Width="110" Margin="0,0,10,0"><TextBlock Text="FIS SEASON" Classes="fieldLabel" /><TextBox Text="{Binding CompetitionSeason}" MaxLength="4" /></StackPanel>
                      <Button Name="GetCompetitionDataButton" Content="Get competition data" Command="{Binding GetCompetitionDataCommand}" IsEnabled="{Binding !IsCompetitionDataBusy}" Classes="secondaryAction" VerticalAlignment="Bottom" />
                    </WrapPanel>
                    <TextBlock Text="{Binding CompetitionCalendarStatus}" Classes="supportingText" TextWrapping="Wrap" IsVisible="{Binding HasCompetitionCalendarStatus}" />
                    <Grid ColumnDefinitions="2*,12,110,12,110">
                      <StackPanel Grid.Column="0" Classes="field"><TextBlock Text="LOCATION" Classes="fieldLabel" /><TextBox Text="{Binding CompetitionLocation}" /></StackPanel>
                      <StackPanel Grid.Column="2" Classes="field"><TextBlock Text="NATION" Classes="fieldLabel" /><TextBox Text="{Binding CompetitionNation}" MaxLength="3" /></StackPanel>
                      <StackPanel Grid.Column="4" Classes="field"><TextBlock Text="GENDER" Classes="fieldLabel" /><ComboBox ItemsSource="{Binding CompetitionGenders}" SelectedItem="{Binding CompetitionGender}" /></StackPanel>
                    </Grid>
                    <TextBlock Text="TECHNICAL DELEGATE" Classes="fieldLabel" />
                    <Grid ColumnDefinitions="*,12,*,12,110,12,110">
                      <StackPanel Grid.Column="0" Classes="field"><TextBlock Text="SURNAME" Classes="fieldLabel" /><TextBox Text="{Binding CompetitionTdLastName}" /></StackPanel>
                      <StackPanel Grid.Column="2" Classes="field"><TextBlock Text="FIRST NAME" Classes="fieldLabel" /><TextBox Text="{Binding CompetitionTdFirstName}" /></StackPanel>
                      <StackPanel Grid.Column="4" Classes="field"><TextBlock Text="NATION" Classes="fieldLabel" /><TextBox Text="{Binding CompetitionTdNation}" MaxLength="3" /></StackPanel>
                      <StackPanel Grid.Column="6" Classes="field"><TextBlock Text="TD NUMBER" Classes="fieldLabel" /><TextBox Text="{Binding CompetitionTdNumber}" /></StackPanel>
                    </Grid>
                    <TextBlock Text="{Binding CompetitionTdOriginalName}" Classes="supportingText" TextWrapping="Wrap" IsVisible="{Binding CompetitionTdOriginalName}" />
                  </StackPanel>
                </StackPanel>
                  <StackPanel Name="CompetitionCourseDetails" Margin="0,10,0,2" Spacing="12">
                    <TextBlock Text="COURSE AND HOMOLOGATION" Classes="fieldLabel" />
                    <StackPanel IsVisible="{Binding IsCompetitionFis}" Spacing="8">
                      <Button Name="BrowseCompetitionHomologationsButton" Content="Browse FIS homologations" Command="{Binding BrowseCompetitionHomologationsCommand}" IsEnabled="{Binding !IsHomologationBusy}" HorizontalAlignment="Left" Classes="secondaryAction" />
                      <TextBlock Text="{Binding CompetitionHomologationStatus}" Classes="supportingText" TextWrapping="Wrap" IsVisible="{Binding HasCompetitionHomologationStatus}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,10,Auto" IsVisible="{Binding HasCompetitionHomologations}">
                      <ComboBox Name="CompetitionHomologationPicker" ItemsSource="{Binding CompetitionHomologations}" SelectedItem="{Binding SelectedCompetitionHomologation}">
                        <ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" /></DataTemplate></ComboBox.ItemTemplate>
                      </ComboBox>
                      <Button Grid.Column="2" Content="Apply homologation" Command="{Binding ApplyCompetitionHomologationCommand}" Classes="secondaryAction" />
                    </Grid>
                    <Grid ColumnDefinitions="2*,12,*">
                      <StackPanel Grid.Column="0" Classes="field">
                        <TextBlock Text="COURSE" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionCourseName}" />
                      </StackPanel>
                      <StackPanel Name="CompetitionHomologationField" Grid.Column="2" Classes="field" IsVisible="{Binding IsCompetitionFis}">
                        <TextBlock Text="HOMOLOGATION" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionHomologation}" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,12,*,12,*,12,*">
                      <StackPanel Grid.Column="0" Classes="field">
                        <TextBlock Text="START ALTITUDE · M" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionStartAltitude}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Classes="field">
                        <TextBlock Text="FINISH ALTITUDE · M" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionFinishAltitude}" />
                      </StackPanel>
                      <StackPanel Grid.Column="4" Classes="field">
                        <TextBlock Text="VERTICAL DROP · M" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionVerticalDrop}" />
                      </StackPanel>
                      <StackPanel Grid.Column="6" Classes="field">
                        <TextBlock Text="COURSE LENGTH · M" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionCourseLength}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                <WrapPanel>
                  <CheckBox Name="SaveCourseToAllRacesCheckBox" Content="Save Course &amp; Homologation to all races" Margin="0,0,20,0"
                          IsChecked="{Binding SaveCourseToAllRaces}"
                          ToolTip.Tip="Also replace course name, homologation, start/finish altitudes, vertical drop and course length in every race in this series, including blank values." />
                  <CheckBox Name="SaveTdToAllRacesCheckBox" Content="Save TD to all races" IsChecked="{Binding SaveTdToAllRaces}"
                            ToolTip.Tip="Also replace TD surname, first name, nation and number in every race in this series, including blank values." />
                </WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Save competition" Command="{Binding SaveCompetitionCommand}" Classes="primaryAction" />
                  <Button Content="Remove competition" Command="{Binding RemoveCompetitionCommand}" Classes="dangerAction" IsVisible="{Binding SelectedCompetition}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="workSurface" Padding="{DynamicResource SectionInset}" IsVisible="{Binding IsCompetitorsSection}">
          <StackPanel Spacing="10">
            <ItemsControl ItemsSource="{Binding ImportWarnings}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <Border Classes="subtleSurface" Padding="10,7">
              <Grid ColumnDefinitions="Auto,8,*,Auto,8,Auto" VerticalAlignment="Center">
                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" IsVisible="{Binding HasDeskChangeLog}" />
                <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding !HasDeskChangeLog}" />
                <TextBlock Grid.Column="2" Text="{Binding UnsavedChangesText}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="{Binding ChangeReviewButtonText}" Command="{Binding ToggleChangeReviewCommand}"
                        IsEnabled="{Binding HasDeskChangeLog}" Classes="secondaryAction" />
                <Button Grid.Column="5" Content="Save changes" Command="{Binding CommitDeskChangesCommand}"
                        IsEnabled="{Binding HasDeskChangeLog}" Classes="primaryAction" />
              </Grid>
            </Border>
            <Border Name="ChangeReviewPanel" Classes="subtleSurface" Padding="10,8" IsVisible="{Binding IsChangeReviewOpen}">
              <StackPanel Spacing="5">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="UNSAVED CHANGES" Classes="fieldLabel" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="Discard all changes" Command="{Binding DiscardDeskChangesCommand}"
                          Classes="dangerAction" />
                </Grid>
                <ScrollViewer MaxHeight="135"><ItemsControl ItemsSource="{Binding DeskChangeLog}"><ItemsControl.ItemTemplate><DataTemplate>
                  <Grid ColumnDefinitions="*,Auto" Margin="0,2"><TextBlock Text="{Binding DisplayLabel}" ToolTip.Tip="{Binding DisplayLabel}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Undo" Click="RestoreDeskChange_Click" Classes="secondaryAction" /></Grid>
                </DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
              </StackPanel>
            </Border>
            <DataGrid Name="CompetitorGrid" Classes="raceGrid columnControls" ItemsSource="{Binding VisibleCompetitors}" SelectedItem="{Binding SelectedCompetitorRow}"
                      SelectionMode="Extended" SelectionChanged="CompetitorGrid_SelectionChanged" Sorting="CompetitorGrid_Sorting" CanUserSortColumns="True" CanUserResizeColumns="True" AutoGenerateColumns="False" IsReadOnly="False"
                      FrozenColumnCount="3" HorizontalScrollBarVisibility="Auto"
                      MinHeight="300" RowHeight="34" ColumnHeaderHeight="40" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
              <DataGrid.ContextMenu><ContextMenu>
                <MenuItem Header="Select all" InputGesture="Ctrl+A" Click="SelectAllContext_Click" />
                <MenuItem Header="Paste from Excel" InputGesture="Ctrl+V" Click="PasteContext_Click" />
                <MenuItem Header="Copy selected" InputGesture="Ctrl+C" Click="CopyContext_Click" />
                <Separator />
                <MenuItem Header="Delete selected rows" InputGesture="Delete" Click="DeleteContext_Click" />
              </ContextMenu></DataGrid.ContextMenu>
              <DataGrid.Columns>
                <DataGridTextColumn Header="" Binding="{Binding ChangeMarker}" IsReadOnly="True" CanUserSort="False" Width="28" MinWidth="24" />
                <DataGridTemplateColumn Header="CODE" SortMemberPath="FederationCode" Width="100" MinWidth="70"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FederationCode}" Classes="gridCell" Classes.changed="{Binding IsCodeChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding FederationCode}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="SURNAME" SortMemberPath="Surname" Width="145" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Surname}" Classes="gridCell" Classes.changed="{Binding IsSurnameChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding Surname}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="FIRST NAME" SortMemberPath="FirstName" Width="125" MinWidth="80"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding FirstName}" Classes="gridCell" Classes.changed="{Binding IsFirstNameChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding FirstName}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="YEAR" SortMemberPath="BirthYearText" Width="75"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding BirthYearText}" Classes="gridCell" Classes.changed="{Binding IsYearChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding BirthYearText}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="GENDER" SortMemberPath="GenderText" Width="95" MinWidth="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding GenderText}" Classes="gridCell" Classes.changed="{Binding IsGenderChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><ComboBox ItemsSource="{Binding AvailableGenders}" SelectedItem="{Binding GenderText}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="NAT" SortMemberPath="Nation" Width="70" MinWidth="60"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Nation}" Classes="gridCell" Classes.changed="{Binding IsNationChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding Nation}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                <DataGridTemplateColumn Header="CLUB" SortMemberPath="Club" Width="145" MinWidth="90"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Club}" Classes="gridCell" Classes.changed="{Binding IsClubChanged}" /></DataTemplate></DataGridTemplateColumn.CellTemplate><DataGridTemplateColumn.CellEditingTemplate><DataTemplate><TextBox Text="{Binding Club}" /></DataTemplate></DataGridTemplateColumn.CellEditingTemplate></DataGridTemplateColumn>
                <DataGridTextColumn Header="DH PTS" Binding="{Binding FisDhText}" SortMemberPath="FisDh" IsReadOnly="True" Width="75" MinWidth="55" />
                <DataGridTextColumn Header="SG PTS" Binding="{Binding FisSgText}" SortMemberPath="FisSg" IsReadOnly="True" Width="75" MinWidth="55" />
                <DataGridTextColumn Header="SL PTS" Binding="{Binding FisSlText}" SortMemberPath="FisSl" IsReadOnly="True" Width="75" MinWidth="55" />
                <DataGridTextColumn Header="GS PTS" Binding="{Binding FisGsText}" SortMemberPath="FisGs" IsReadOnly="True" Width="75" MinWidth="55" />
                <DataGridTextColumn Header="AC PTS" Binding="{Binding FisAcText}" SortMemberPath="FisAc" IsReadOnly="True" Width="75" MinWidth="55" />
                <DataGridTextColumn Header="CATEGORY" Binding="{Binding Category}" SortMemberPath="Category" IsReadOnly="True" Width="125" MinWidth="80" />
              </DataGrid.Columns>
            </DataGrid>
            <Border Classes="subtleSurface" Padding="10,8" IsVisible="{Binding SelectedCompetitorRow.NeedsApproval}"><StackPanel Orientation="Horizontal" Spacing="12">
              <TextBlock Text="{Binding SelectedCompetitorRow.WarningText}" Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" />
              <CheckBox Content="Match checked" IsChecked="{Binding SelectedCompetitorRow.WarningApproved}" VerticalAlignment="Center" />
            </StackPanel></Border>
            <Expander Header="Update from FIS" IsExpanded="{Binding IsFisPanelOpen}" HorizontalAlignment="Stretch">
              <Border Classes="subtleSurface" Padding="12,10" Margin="0,8,0,0">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto"><StackPanel Spacing="2">
                    <TextBlock Text="{Binding FisListDisplay}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding FisListValidityText}" Classes="supportingText" />
                  </StackPanel><Button Grid.Column="1" Content="Stage updates for existing competitors" Command="{Binding StageFisUpdatesCommand}" Classes="secondaryAction" /></Grid>
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Content="Download FIS point list" Command="{Binding DownloadFisListCommand}" IsEnabled="{Binding !IsFisBusy}" Classes="secondaryAction" />
                    <TextBlock Text="Date the list must be effective on" VerticalAlignment="Center" Classes="fieldLabel" />
                    <TextBox Name="FisEffectiveDateInput" Width="128" Text="{Binding FisEffectiveDateText}" Watermark="YYYY-MM-DD" />
                    <Button Name="FisDatePickerButton" ToolTip.Tip="Choose effective date" Click="DatePickerButton_Click" Classes="dateAction">
                      <Path Width="15" Height="15" Stroke="{DynamicResource TextBrush}" StrokeThickness="1.5"
                            Data="M2,4 L13,4 13,13 2,13 Z M2,7 L13,7 M5,2 L5,5 M10,2 L10,5" />
                    </Button>
                  </StackPanel>
                  <Grid ColumnDefinitions="*,6,34,8,Auto">
                    <TextBox Name="FisSearchInput" Text="{Binding FisSearchText}" Watermark="Search FIS by Code, name, nation or club (2+ characters)" />
                    <Button Grid.Column="2" Content="×" ToolTip.Tip="Clear search" Command="{Binding ClearFisSearchCommand}" Click="FocusFisSearch_Click" Classes="secondaryAction" Padding="0" />
                    <Button Grid.Column="4" Content="Add selected competitors" Command="{Binding StageSelectedFisAthleteCommand}" Classes="secondaryAction" />
                  </Grid>
                  <ListBox Name="FisSearchResultsList" ItemsSource="{Binding FisSearchResults}" SelectionMode="Multiple" SelectionChanged="FisSearchResults_SelectionChanged" MaxHeight="150">
                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Display}" FontSize="12" /></DataTemplate></ListBox.ItemTemplate>
                  </ListBox>
                  <TextBlock Text="Review highlighted changes, then choose Save changes above the grid." Classes="supportingText" />
                </StackPanel>
              </Border>
            </Expander>
            <Expander Header="Category rules · birth-year range and gender" HorizontalAlignment="Stretch">
              <StackPanel Margin="0,10,0,2" Spacing="10">
                <DataGrid Classes="raceGrid" ItemsSource="{Binding CategoryRules}" SelectedItem="{Binding SelectedCategoryRule}"
                          AutoGenerateColumns="False" IsReadOnly="True" MinHeight="70" MaxHeight="150"
                          RowHeight="32" ColumnHeaderHeight="28" HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="CATEGORY" Binding="{Binding Values.Label}" Width="*" />
                    <DataGridTextColumn Header="FROM YEAR" Binding="{Binding Values.BirthYearMin}" Width="110" />
                    <DataGridTextColumn Header="TO YEAR" Binding="{Binding Values.BirthYearMax}" Width="110" />
                    <DataGridTextColumn Header="GENDER" Binding="{Binding Values.Gender, Converter={StaticResource GenderLabelConverter}}" Width="110" />
                    <DataGridTextColumn Header="ORDER" Binding="{Binding Values.DisplayOrder}" Width="90" />
                  </DataGrid.Columns>
                </DataGrid>
                <Grid ColumnDefinitions="2*,10,100,10,100,10,120,10,90">
                  <StackPanel Grid.Column="0" Classes="field"><TextBlock Text="LABEL" Classes="fieldLabel" /><TextBox Text="{Binding CategoryLabel}" /></StackPanel>
                  <StackPanel Grid.Column="2" Classes="field"><TextBlock Text="FROM YEAR" Classes="fieldLabel" /><TextBox Text="{Binding CategoryMinYearText}" /></StackPanel>
                  <StackPanel Grid.Column="4" Classes="field"><TextBlock Text="TO YEAR" Classes="fieldLabel" /><TextBox Text="{Binding CategoryMaxYearText}" /></StackPanel>
                  <StackPanel Grid.Column="6" Classes="field"><TextBlock Text="GENDER" Classes="fieldLabel" /><ComboBox ItemsSource="{Binding CategoryGenderOptions}" SelectedItem="{Binding CategoryGenderText}" /></StackPanel>
                  <StackPanel Grid.Column="8" Classes="field"><TextBlock Text="ORDER" Classes="fieldLabel" /><TextBox Text="{Binding CategoryOrderText}" /></StackPanel>
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="New rule" Command="{Binding NewCategoryRuleCommand}" Classes="secondaryAction" />
                  <Button Content="Save rule" Command="{Binding SaveCategoryRuleCommand}" Classes="primaryAction" />
                  <Button Content="Remove rule" Command="{Binding RemoveCategoryRuleCommand}" IsEnabled="{Binding SelectedCategoryRule}" Classes="dangerAction" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Button Content="Save rules for reuse" Command="{Binding SaveCategoryRulesPresetCommand}" Classes="secondaryAction" />
                  <Button Content="Load saved rules (replace)" Command="{Binding LoadCategoryRulesPresetCommand}" Classes="secondaryAction" />
                  <Button Content="Update categories" Command="{Binding UpdateCategoriesCommand}" Classes="secondaryAction" />
                </StackPanel>
              </StackPanel>
            </Expander>
            </StackPanel>
        </Border>
        <Border Classes="workSurface" Padding="{DynamicResource SectionInset}" IsVisible="{Binding IsSettingsSection}">
          <StackPanel Spacing="12">
            <StackPanel Spacing="1"><TextBlock Text="APPLICATION / SETTINGS" Classes="eyebrow" /><TextBlock Text="Settings" Classes="sectionTitle" /></StackPanel>
            <Border Classes="subtleSurface" Padding="12"><local:TimingSettingsView /></Border>
            <Border Classes="subtleSurface" Padding="12"><StackPanel Spacing="8">
              <TextBlock Text="FIS API access" FontWeight="SemiBold" />
              <TextBlock Text="Create an API key in FIS Member Section → API Access." Classes="supportingText" />
              <Grid ColumnDefinitions="340,8,Auto,8,Auto" HorizontalAlignment="Left">
                <TextBox PasswordChar="•" Text="{Binding FisApiKeyInput}" Watermark="{Binding FisApiKeyWatermark}" MaxLength="1024" />
                <Button Grid.Column="2" Content="Save key" Command="{Binding SaveFisApiKeyCommand}" Classes="primaryAction" />
                <Button Grid.Column="4" Content="Remove key" Command="{Binding RemoveFisApiKeyCommand}" Classes="secondaryAction" />
              </Grid>
              <TextBlock Text="{Binding FisApiKeyStatus}" Classes="supportingText" />
              <TextBlock Text="FIS Member Section personal access token for XML test uploads. Required scopes: competition.files.write and competition.files.read." Classes="supportingText" />
              <Grid ColumnDefinitions="340,8,Auto,8,Auto" HorizontalAlignment="Left">
                <TextBox PasswordChar="•" Text="{Binding FisMemberTokenInput}" Watermark="Member Section personal access token" MaxLength="1024" />
                <Button Grid.Column="2" Content="Save token" Command="{Binding SaveFisMemberTokenCommand}" Classes="primaryAction" />
                <Button Grid.Column="4" Content="Remove token" Command="{Binding RemoveFisMemberTokenCommand}" Classes="secondaryAction" />
              </Grid>
              <TextBlock Text="The key stays in this Windows account's credential store. Downloaded FIS lists stay in local application data." Classes="supportingText" />
            </StackPanel></Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <local:DrawView Grid.Row="2" Margin="{DynamicResource PageInset}" IsVisible="{Binding IsDrawSection}" />
    <local:TimingView Name="TimingWorkspace" Grid.Row="2" Margin="{DynamicResource PageInset}" IsVisible="{Binding IsTimingSection}" />
    <local:ResultsView Grid.Row="2" Margin="{DynamicResource PageInset}" IsVisible="{Binding IsResultsSection}" />
    <Border Grid.Row="3" Classes="statusBar" Classes.error="{Binding IsError}"
            BorderThickness="0,1,0,0" Padding="22,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Width="6" Height="6" CornerRadius="3" Background="{DynamicResource SuccessBrush}" VerticalAlignment="Center" IsVisible="{Binding !IsError}" />
        <TextBlock Text="!" FontWeight="Bold" Foreground="{DynamicResource ErrorBrush}" IsVisible="{Binding IsError}" />
        <TextBlock Text="{Binding StatusMessage}" Classes="statusText" Classes.error="{Binding IsError}"
                   FontSize="11" TextWrapping="Wrap" />
        <TextBlock Text="{Binding TimingCaptureLabel}" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="560" IsVisible="{Binding IsTimingConnected}" />
      </StackPanel>
    </Border>
  </Grid>
</Window>
