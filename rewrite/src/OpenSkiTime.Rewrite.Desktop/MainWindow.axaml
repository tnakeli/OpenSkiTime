<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenSkiTime.Rewrite.Desktop.MainWindow" x:CompileBindings="False"
        Title="OpenSkiTime" Width="1280" Height="820" MinWidth="980" MinHeight="680"
        Background="#F1F5F7">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0" Background="#102D3B" Padding="28,16">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock Text="OpenSkiTime" FontSize="24" FontWeight="Bold" Foreground="White" />
          <TextBlock Text="RACE OFFICE  /  EVENT WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="#9BBAC7" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="New series" Command="{Binding NewSeriesCommand}" Classes="headerAction" />
          <Button Content="Open file" Command="{Binding OpenSeriesCommand}" Classes="headerAction" />
          <Button Content="Backup / transfer" Command="{Binding BackupCommand}" IsEnabled="{Binding IsOpen}" Classes="headerAction" />
          <Button Content="Close file" Command="{Binding CloseSeriesCommand}" IsEnabled="{Binding IsOpen}" Classes="headerAction" />
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="28,28,28,32" Spacing="20" MaxWidth="1220" HorizontalAlignment="Center">
        <Border Background="White" CornerRadius="12" Padding="26" BorderBrush="#DCE6EA" BorderThickness="1">
          <StackPanel Spacing="22">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="Event series" FontSize="21" FontWeight="SemiBold" Foreground="#153442" />
                <TextBlock Text="Weekend details and the portable event file" FontSize="12" Foreground="#657C89" />
              </StackPanel>
              <Border Grid.Column="1" Background="#F1F6F8" CornerRadius="6" Padding="10,6" VerticalAlignment="Center">
                <TextBlock Text="{Binding FileLabel}" ToolTip.Tip="{Binding FileLabel}" MaxWidth="380"
                           TextTrimming="CharacterEllipsis" FontSize="11" Foreground="#536D7A" />
              </Border>
            </Grid>
            <StackPanel Spacing="16">
              <Grid ColumnDefinitions="2*,16,2*,16,2*,16,130,16,130">
                <StackPanel Grid.Column="0" Classes="field">
                  <TextBlock Text="SERIES NAME *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Name}" Watermark="Weekend name" />
                </StackPanel>
                <StackPanel Grid.Column="2" Classes="field">
                  <TextBlock Text="LOCATION *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Location}" Watermark="Venue" />
                </StackPanel>
                <StackPanel Grid.Column="4" Classes="field">
                  <TextBlock Text="ORGANIZER *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Organizer}" Watermark="Organizing club" />
                </StackPanel>
                <StackPanel Grid.Column="6" Classes="field">
                  <TextBlock Text="NATION *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Nation}" MaxLength="3" />
                </StackPanel>
                <StackPanel Grid.Column="8" Classes="field">
                  <TextBlock Text="SEASON *" Classes="fieldLabel" />
                  <TextBox Text="{Binding Season}" Watermark="2026–27" />
                </StackPanel>
              </Grid>
              <StackPanel Orientation="Horizontal" Spacing="16">
                <StackPanel Classes="field" Width="232">
                  <TextBlock Text="START DATE *  ·  DD.MM.YYYY" Classes="fieldLabel" />
                  <TextBox Name="SeriesStartDateInput" Text="{Binding StartDateText}" Watermark="dd.mm.yyyy" MaxLength="10" />
                </StackPanel>
                <StackPanel Classes="field" Width="232">
                  <TextBlock Text="END DATE *  ·  DD.MM.YYYY" Classes="fieldLabel" />
                  <TextBox Name="SeriesEndDateInput" Text="{Binding EndDateText}" Watermark="dd.mm.yyyy" MaxLength="10" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="Create series file" Command="{Binding CreateSeriesCommand}" IsVisible="{Binding IsCreatingNew}" Classes="primaryAction" />
              <Button Content="Cancel" Command="{Binding CancelNewSeriesCommand}" IsVisible="{Binding IsCreatingNew}" Classes="secondaryAction" />
              <Button Content="Save series" Command="{Binding SaveSeriesCommand}" IsVisible="{Binding IsEditingSeries}" Classes="primaryAction" />
            </StackPanel>
          </StackPanel>
        </Border>
        <Border Background="White" CornerRadius="12" Padding="26" BorderBrush="#DCE6EA" BorderThickness="1" IsVisible="{Binding CanEditCompetitions}">
          <StackPanel Spacing="20">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="Competitions" FontSize="21" FontWeight="SemiBold" Foreground="#153442" />
                <TextBlock Text="Select a competition to edit its details" FontSize="12" Foreground="#657C89" />
              </StackPanel>
              <Button Grid.Column="1" Content="Add competition" Command="{Binding NewCompetitionCommand}" Classes="primaryAction" />
            </Grid>
            <DataGrid ItemsSource="{Binding Competitions}" SelectedItem="{Binding SelectedCompetition}" AutoGenerateColumns="False"
                      IsReadOnly="True" MinHeight="110" MaxHeight="235" RowHeight="40" ColumnHeaderHeight="38"
                      GridLinesVisibility="Horizontal" HeadersVisibility="Column" BorderBrush="#DCE6EA" BorderThickness="1">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Date" Binding="{Binding Values.Date}" Width="130" />
                <DataGridTextColumn Header="Short label" Binding="{Binding Values.ShortLabel}" Width="150" />
                <DataGridTextColumn Header="Competition" Binding="{Binding Values.Name}" Width="*" />
                <DataGridTextColumn Header="Discipline" Binding="{Binding Values.Discipline}" Width="135" />
                <DataGridTextColumn Header="Runs" Binding="{Binding Values.RunCount}" Width="80" />
              </DataGrid.Columns>
            </DataGrid>
            <Border Background="#F4F8FA" CornerRadius="9" Padding="22" IsVisible="{Binding IsCompetitionEditing}">
              <StackPanel Spacing="20">
                <StackPanel Spacing="3">
                  <TextBlock Text="{Binding CompetitionEditorTitle}" FontSize="17" FontWeight="SemiBold" Foreground="#153442" />
                  <TextBlock Text="Race identity and course settings" FontSize="11" Foreground="#657C89" />
                </StackPanel>
                <StackPanel Spacing="16">
                  <Grid ColumnDefinitions="2*,16,*,16,232">
                    <StackPanel Grid.Column="0" Classes="field">
                      <TextBlock Text="NAME *" Classes="fieldLabel" />
                      <TextBox Text="{Binding CompetitionName}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="field">
                      <TextBlock Text="SHORT LABEL *" Classes="fieldLabel" />
                      <TextBox Text="{Binding CompetitionShortLabel}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Classes="field">
                      <TextBlock Text="DATE *  ·  DD.MM.YYYY" Classes="fieldLabel" />
                      <TextBox Name="CompetitionDateInput" Text="{Binding CompetitionDateText}" Watermark="dd.mm.yyyy" MaxLength="10" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="2*,16,2*,16,120,16,150">
                    <StackPanel Grid.Column="0" Classes="field">
                      <TextBlock Text="DISCIPLINE" Classes="fieldLabel" />
                      <ComboBox ItemsSource="{Binding Disciplines}" SelectedItem="{Binding CompetitionDiscipline}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="field">
                      <TextBlock Text="RACE TYPE" Classes="fieldLabel" />
                      <ComboBox ItemsSource="{Binding RaceTypes}" SelectedItem="{Binding CompetitionRaceType}" />
                    </StackPanel>
                    <StackPanel Grid.Column="4" Classes="field">
                      <TextBlock Text="RUNS" Classes="fieldLabel" />
                      <NumericUpDown Value="{Binding CompetitionRunCount}" Minimum="1" Maximum="9" FormatString="0" />
                    </StackPanel>
                    <StackPanel Grid.Column="6" Classes="field">
                      <TextBlock Text="INTERMEDIATES" Classes="fieldLabel" />
                      <NumericUpDown Value="{Binding CompetitionIntermediateCount}" Minimum="0" Maximum="20" FormatString="0" />
                    </StackPanel>
                  </Grid>
                  <Grid ColumnDefinitions="*,16,*">
                    <StackPanel Grid.Column="0" Classes="field">
                      <TextBlock Text="FIS CODE" Classes="fieldLabel" />
                      <TextBox Text="{Binding CompetitionFisCode}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Classes="field">
                      <TextBlock Text="LOCAL RACE CODE" Classes="fieldLabel" />
                      <TextBox Text="{Binding CompetitionLocalRaceCode}" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
                <Expander Header="Course and homologation details" HorizontalAlignment="Stretch">
                  <StackPanel Margin="0,14,0,4" Spacing="16">
                    <Grid ColumnDefinitions="2*,16,*">
                      <StackPanel Grid.Column="0" Classes="field">
                        <TextBlock Text="COURSE" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionCourseName}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Classes="field">
                        <TextBlock Text="HOMOLOGATION" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionHomologation}" />
                      </StackPanel>
                    </Grid>
                    <Grid ColumnDefinitions="*,16,*,16,*">
                      <StackPanel Grid.Column="0" Classes="field">
                        <TextBlock Text="START ALTITUDE · M" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionStartAltitude}" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Classes="field">
                        <TextBlock Text="FINISH ALTITUDE · M" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionFinishAltitude}" />
                      </StackPanel>
                      <StackPanel Grid.Column="4" Classes="field">
                        <TextBlock Text="VERTICAL DROP · M" Classes="fieldLabel" />
                        <TextBox Text="{Binding CompetitionVerticalDrop}" />
                      </StackPanel>
                    </Grid>
                  </StackPanel>
                </Expander>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Content="Save competition" Command="{Binding SaveCompetitionCommand}" Classes="primaryAction" />
                  <Button Content="Remove competition" Command="{Binding RemoveCompetitionCommand}" Classes="secondaryAction" IsVisible="{Binding SelectedCompetition}" />
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Background="#E7EFF2" Padding="28,11">
      <TextBlock Text="{Binding StatusMessage}" Foreground="#294956" TextWrapping="Wrap" />
    </Border>
  </Grid>
</Window>
